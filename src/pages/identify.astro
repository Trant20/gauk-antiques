---
import AppLayout from '../layouts/AppLayout.astro'
import AppSidebar from '../components/AppSidebar.astro'
import AppBottomNav from '../components/AppBottomNav.astro'
---
<AppLayout title="Identify — GAUK">
<style is:global>
  /* ── IDENTIFY LAUNCHER ── */
  .identify-scroll { margin-left: 220px; flex: 1; overflow-y: auto; padding: 40px 32px 80px; }
  @media (max-width: 768px) { .identify-scroll { margin-left: 0; padding: 24px 16px 80px; } }

  .identify-topbar { height: 52px; background: var(--surface); border-bottom: 1px solid var(--border); display: flex; align-items: center; padding: 0 32px; flex-shrink: 0; margin-left: 220px; }
  .identify-topbar-title { font-size: 13px; font-weight: 600; color: var(--text-dim); }
  @media (max-width: 768px) { .identify-topbar { margin-left: 0; padding: 0 16px; } }

  .launcher-header { margin-bottom: 40px; }
  .launcher-header-cap { font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-mute); font-weight: 600; margin-bottom: 8px; }
  .launcher-header-title { font-size: 24px; font-weight: 600; color: var(--text); margin-bottom: 6px; }
  .launcher-header-sub { font-size: 13px; color: var(--text-mute); line-height: 1.6; }

  .launcher-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; max-width: 960px; }
  @media (max-width: 600px) { .launcher-grid { grid-template-columns: 1fr; } }

  .scanner-card { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--border-hi); padding: 28px 24px; text-decoration: none; color: inherit; transition: border-color 0.15s, background 0.15s; cursor: pointer; }
  .scanner-card:hover { background: var(--surface-hi); }
  .scanner-card-ga { border-left: 3px solid var(--ga-gold); }
  .scanner-card-ga:hover { border-color: var(--ga-gold-hi); border-left-color: var(--ga-gold-hi); }
  .scanner-card-gi { border-left: 3px solid var(--gi-sage); }
  .scanner-card-gi:hover { border-color: #8aa896; border-left-color: #8aa896; }
  .scanner-card-gr { border-left: 3px solid var(--gr-violet); }
  .scanner-card-gr:hover { border-color: var(--gr-violet-hi); border-left-color: var(--gr-violet-hi); }
  .scanner-card-gr .scanner-card-icon { color: var(--gr-violet); }
  .scanner-card-gr .scanner-card-action { color: var(--gr-violet); }

  .scanner-card-icon { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; margin-bottom: 18px; }
  .scanner-card-ga .scanner-card-icon { color: var(--ga-gold-hi); }
  .scanner-card-gi .scanner-card-icon { color: var(--gi-sage); }

  .scanner-card-name { font-size: 16px; font-weight: 600; color: var(--text); margin-bottom: 8px; }
  .scanner-card-desc { font-size: 13px; color: var(--text-mute); line-height: 1.6; flex: 1; }
  .scanner-card-action { margin-top: 24px; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; }
  .scanner-card-ga .scanner-card-action { color: var(--ga-gold-hi); }
  .scanner-card-gi .scanner-card-action { color: var(--gi-sage); }
</style>

<div class="app-shell">
  <AppSidebar activePage="identify" />

  <div class="app-main" style="overflow:hidden; display:flex; flex-direction:column;">
    <div class="identify-topbar">
      <span class="identify-topbar-title">Identify</span>
    </div>

    <div class="identify-scroll">
      <div class="launcher-header">
        <div class="launcher-header-cap">Scanner</div>
        <div class="launcher-header-title">Choose your scanner</div>
        <div class="launcher-header-sub">Select the scanner that matches what you want to identify.</div>
      </div>

      <div class="launcher-grid">
        <!-- GA Antiques Scanner -->
        <a href="/identify/antiques" class="scanner-card scanner-card-ga">
          <div class="scanner-card-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <div class="scanner-card-name">Antiques Scanner</div>
          <div class="scanner-card-desc">Identify antiques, collectibles and artworks. Get provenance, maker research, condition report and estimated auction value.</div>
          <div class="scanner-card-action">Start scanning →</div>
        </a>

        <!-- GI Contents Scanner -->
        <a href="/identify/insurance" class="scanner-card scanner-card-gi">
          <div class="scanner-card-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <div class="scanner-card-name">Contents Scanner</div>
          <div class="scanner-card-desc">Audit your home contents for insurance. Room by room walkthrough, replacement cost estimates and coverage gap analysis.</div>
          <div class="scanner-card-action">Start scanning →</div>
        </a>
        <!-- GR Receipts Scanner -->
        <a href="/receipts/scan" class="scanner-card scanner-card-gr">
          <div class="scanner-card-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="12" y2="16"/></svg>
          </div>
          <div class="scanner-card-name">Receipt Scanner</div>
          <div class="scanner-card-desc">Photograph any receipt. We extract every item, price and date into a searchable encrypted vault — proof of purchase, always ready.</div>
          <div class="scanner-card-action">Start scanning →</div>
        </a>
      </div>
    </div>
  </div>
</div>

<AppBottomNav activePage="scan" />

<script>
  import { supabase } from '../lib/supabase-browser'
  const { data: { session } } = await supabase.auth.getSession()
  if (!session) { window.location.href = 'https://gaukauth.com?from=gaukantiques.com&next=/library' }
</script>

</AppLayout>
