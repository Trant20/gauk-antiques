---
import { GI_SITE_ID } from '../../lib/constants'
import AppLayout from '../../layouts/AppLayout.astro'
import AIHeroWidget from '../../components/AIHeroWidget.astro'
import { supabase } from '../../lib/supabase'

const { data: creditSetting } = await supabase
  .from('site_settings')
  .select('value')
  .eq('site_id', GI_SITE_ID)
  .eq('key', 'credit_cost_identify')
  .single()
const creditCostIdentify = Number(creditSetting?.value ?? 1)
---
<AppLayout title="Contents Scanner — GAUK">
<style is:global>
  /* ── SCANNER PAGE — full screen, distraction free ── */
  .scanner-shell { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }

  .scanner-header { height: 52px; background: var(--surface); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; padding: 0 24px; flex-shrink: 0; }
  .scanner-back { display: flex; align-items: center; gap: 8px; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-mute); text-decoration: none; font-weight: 600; transition: color 0.15s; }
  .scanner-back:hover { color: var(--text); }
  .scanner-back-icon { color: var(--gi-sage); }
  .scanner-title { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-mute); font-weight: 600; }
  .scanner-vault-link { display: flex; align-items: center; gap: 6px; color: var(--text-mute); text-decoration: none; transition: color 0.15s; }
  .scanner-vault-link:hover { color: var(--text); }
  .scanner-vault-icon { color: var(--gi-sage); }

  .scanner-body { flex: 1; overflow-y: auto; display: flex; flex-direction: column; align-items: center; padding: 32px 24px 48px; }
  @media (max-width: 768px) { .scanner-body { padding: 20px 16px 40px; } }

  .scanner-widget-wrap { width: 100%; max-width: 560px; }

  /* ── Widget token aliases ── */
  :root {
    --bg:       var(--shell);
    --goldHi:   var(--gi-sage);
    --gold:     var(--gi-sage);
    --borderHi: var(--border-hi);
    --textDim:  var(--text-dim);
  }

  /* ── GI RESULT CARD ── */
  .gi-result {
    width: 100%; max-width: 560px; margin: 32px 0 0;
    background: var(--surface);
    border: 1px solid var(--border-hi);
    border-left: 3px solid var(--gi-sage);
  }

  .gi-result-badge { padding: 16px 20px 0; }
  .gi-result-cat { font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gi-sage); }

  .gi-result-title { font-family: var(--font-ui); font-size: clamp(18px,3.5vw,24px); font-weight: 600; color: var(--text); padding: 8px 20px 0; line-height: 1.2; }

  .gi-result-desc { font-family: var(--font-ui); font-size: 14px; line-height: 1.8; color: var(--text-dim); padding: 12px 20px 16px; border-bottom: 1px solid var(--border); }

  .gi-result-value-block { background: var(--surface-hi); border-bottom: 1px solid var(--border); padding: 20px; text-align: center; }
  .gi-result-value-label { font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-mute); margin-bottom: 8px; }
  .gi-result-value { font-family: var(--font-ui); font-size: clamp(24px,5vw,36px); font-weight: 700; color: var(--gi-sage); }
  .gi-result-confidence { font-family: var(--font-ui); font-size: 11px; color: var(--text-mute); margin-top: 6px; letter-spacing: 0.08em; }

  .gi-result-commentary { padding: 20px; border-bottom: 1px solid var(--border); }
  .gi-result-commentary-text { font-family: var(--font-ui); font-size: 14px; line-height: 1.8; color: var(--text-dim); }
  .gi-result-commentary-hook { font-family: var(--font-ui); font-size: 13px; line-height: 1.7; color: var(--gi-sage); margin-top: 10px; font-style: italic; }

  /* ── ANTIQUE DETAILS ── */
  .gi-result-antique { padding: 20px; border-bottom: 1px solid var(--border); }
  .gi-result-antique-label { font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gi-sage); margin-bottom: 14px; }
  .gi-result-row { display: flex; gap: 16px; padding: 8px 0; border-bottom: 1px solid var(--border-hi); }
  .gi-result-row:last-child { border-bottom: none; }
  .gi-result-key { width: 80px; flex-shrink: 0; font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-mute); padding-top: 2px; }
  .gi-result-val { font-family: var(--font-ui); font-size: 14px; color: var(--text); flex: 1; }

  /* ── ANTIQUE HANDOFF BANNER ── */
  .gi-antique-banner { margin: 0; padding: 20px; background: var(--surface-hi); border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 10px; }
  .gi-antique-banner-title { font-family: var(--font-ui); font-size: 14px; font-weight: 600; color: var(--text); }
  .gi-antique-banner-body { font-family: var(--font-ui); font-size: 13px; color: var(--text-dim); line-height: 1.7; }
  .gi-antique-banner-cta { display: inline-block; font-family: var(--font-ui); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; color: var(--ga-gold-hi); background: none; border: 1px solid var(--ga-gold); padding: 10px 20px; text-decoration: none; transition: background 0.15s; align-self: flex-start; margin-top: 4px; }
  .gi-antique-banner-cta:hover { background: rgba(122,92,32,0.12); }

  .gi-result-footer { display: flex; justify-content: space-between; align-items: center; padding: 14px 20px; }
  .gi-result-brand { font-family: var(--font-ui); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gi-sage); }
  .gi-result-ref { font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.08em; color: var(--text-mute); }
  .gi-save-note { display: none; padding: 8px 20px; font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gi-sage); }
  .gi-save-note.visible { display: block; }
</style>

<div class="scanner-shell">

  <!-- Minimal header -->
  <div class="scanner-header">
    <a href="/identify" class="scanner-back">
      <svg class="scanner-back-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      Scanners
    </a>
    <span class="scanner-title">Contents Scanner</span>
    <a href="/library" class="scanner-vault-link" title="The Vault">
      <svg class="scanner-vault-icon" width="16" height="16" viewBox="0 0 14 14" fill="none"><rect x="1" y="1" width="5" height="5" fill="currentColor"/><rect x="8" y="1" width="5" height="5" fill="currentColor"/><rect x="1" y="8" width="5" height="5" fill="currentColor"/><rect x="8" y="8" width="5" height="5" fill="currentColor" opacity="0.28"/></svg>
    </a>
  </div>

  <!-- Scanner body -->
  <div class="scanner-body">
    <div class="scanner-widget-wrap" id="identify-widget-wrap" data-credit-cost={creditCostIdentify}>
      <AIHeroWidget context="general" category="Contents" site_id={GI_SITE_ID} />
    </div>

    <!-- GI Result Card -->
    <div id="gi-identify-result" class="gi-result" style="display:none">

      <div class="gi-result-badge">
        <span class="gi-result-cat" id="gi-result-category"></span>
      </div>

      <div class="gi-result-title" id="gi-result-title"></div>

      <div class="gi-result-desc" id="gi-result-desc"></div>

      <div class="gi-result-value-block">
        <div class="gi-result-value-label">Est. Replacement Cost</div>
        <div class="gi-result-value" id="gi-result-value"></div>
        <div class="gi-result-confidence" id="gi-result-confidence"></div>
      </div>

      <div class="gi-result-commentary" id="gi-result-commentary" style="display:none">
        <div class="gi-result-commentary-text" id="gi-result-commentary-text"></div>
        <div class="gi-result-commentary-hook" id="gi-result-commentary-hook"></div>
      </div>

      <!-- Antique details — shown when is_antique is true -->
      <div class="gi-result-antique" id="gi-result-antique" style="display:none">
        <div class="gi-result-antique-label">Antique Details</div>
        <div class="gi-result-row" id="gi-row-maker" style="display:none">
          <div class="gi-result-key">Maker</div>
          <div class="gi-result-val" id="gi-result-maker"></div>
        </div>
        <div class="gi-result-row" id="gi-row-period" style="display:none">
          <div class="gi-result-key">Period</div>
          <div class="gi-result-val" id="gi-result-period"></div>
        </div>
        <div class="gi-result-row" id="gi-row-condition" style="display:none">
          <div class="gi-result-key">Condition</div>
          <div class="gi-result-val" id="gi-result-condition"></div>
        </div>
      </div>

      <!-- Antique handoff banner -->
      <div class="gi-antique-banner" id="gi-antique-banner" style="display:none">
        <div class="gi-antique-banner-title">This item may have antique value worth investigating.</div>
        <div class="gi-antique-banner-body">Our AI has flagged this as a potential antique. Run a specialist deep scan to get maker history, auction comparables and a definitive valuation.</div>
        <a class="gi-antique-banner-cta" id="gi-antique-cta" href="#">Run Specialist Scan →</a>
      </div>

      <div class="gi-result-footer">
        <span class="gi-result-brand">GAUK Insurance</span>
        <span class="gi-result-ref" id="gi-result-ref"></span>
      </div>
      <div class="gi-save-note" id="gi-save-note">Saved to your vault</div>
    </div>
  </div>
</div>

<script>
  import { supabase } from '../../lib/supabase-browser'

  const { data: { session } } = await supabase.auth.getSession()
  if (!session) { window.location.href = 'https://gaukauth.com?from=gaukantiques.com&next=/identify/insurance' }

  if (session) {
    window.__gauk_user_id = session.user.id
    window.__gauk_token = session.access_token
  }

  document.addEventListener('widget-reset-result', () => {
    const r = document.getElementById('gi-identify-result') as HTMLElement
    if (r) r.style.display = 'none'
  })

  document.addEventListener('identification-complete', (e: any) => {
    const identifyData = e.detail
    const r = identifyData.result

    // Populate result card
    const category = document.getElementById('gi-result-category')
    const title    = document.getElementById('gi-result-title')
    const desc     = document.getElementById('gi-result-desc')
    const value    = document.getElementById('gi-result-value')
    const conf     = document.getElementById('gi-result-confidence')

    if (category) category.textContent = r.category || ''
    if (title)    title.textContent    = r.title || 'Item identified'
    if (desc)     desc.textContent     = r.description || ''

    // Value — GBP
    const low  = r.value_range_low  || 0
    const high = r.value_range_high || 0
    if (value) value.textContent = low && high ? `£${low.toLocaleString()} – £${high.toLocaleString()}` : 'Value unknown'
    if (conf)  conf.textContent  = `Confidence: ${r.confidence || '—'}`

    // Commentary
    const commentaryWrap = document.getElementById('gi-result-commentary')
    const commentaryText = document.getElementById('gi-result-commentary-text')
    const commentaryHook = document.getElementById('gi-result-commentary-hook')
    if (r.commentary && commentaryWrap) {
      if (commentaryText) commentaryText.textContent = r.commentary
      if (commentaryHook) commentaryHook.textContent = r.commentary_hook || ''
      commentaryWrap.style.display = 'block'
    }

    // Antique details
    if (r.is_antique) {
      const antiqueSection = document.getElementById('gi-result-antique')
      if (antiqueSection) antiqueSection.style.display = 'block'

      if (r.maker) {
        document.getElementById('gi-result-maker')!.textContent = r.maker
        document.getElementById('gi-row-maker')!.style.display = 'flex'
      }
      if (r.period) {
        document.getElementById('gi-result-period')!.textContent = r.period
        document.getElementById('gi-row-period')!.style.display = 'flex'
      }
      if (r.condition) {
        document.getElementById('gi-result-condition')!.textContent = r.condition
        document.getElementById('gi-row-condition')!.style.display = 'flex'
      }

      // Antique handoff banner — links to GA antiques scanner
      const banner = document.getElementById('gi-antique-banner')
      const cta    = document.getElementById('gi-antique-cta') as HTMLAnchorElement
      if (banner) banner.style.display = 'flex'
      if (cta && identifyData.id) {
        cta.href = '/identify/antiques'
      }
    }

    // Ref and save note
    if (identifyData.id) {
      const ref = document.getElementById('gi-result-ref')
      if (ref) ref.textContent = 'REF ' + identifyData.id.slice(0,8).toUpperCase()
    }

    const result = document.getElementById('gi-identify-result') as HTMLElement
    result.style.display = 'block'
    result.scrollIntoView({ behavior: 'smooth', block: 'start' })

    if (session?.user?.id && identifyData.id) {
      const saveNote = document.getElementById('gi-save-note')
      if (saveNote) saveNote.classList.add('visible')
    }
  })
</script>

</AppLayout>
