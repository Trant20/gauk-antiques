---
import { ANTIQUES_SITE_ID } from '../../lib/constants'
import AppLayout from '../../layouts/AppLayout.astro'
import AppBottomNav from '../../components/AppBottomNav.astro'
import AIHeroWidget from '../../components/AIHeroWidget.astro'
import { supabase } from '../../lib/supabase'

const { data: creditSetting } = await supabase
  .from('site_settings')
  .select('value')
  .eq('site_id', ANTIQUES_SITE_ID)
  .eq('key', 'credit_cost_identify')
  .single()
const creditCostIdentify = Number(creditSetting?.value ?? 1)
---
<AppLayout title="Antiques Scanner — GAUK">
<style is:global>
  /* ── SCANNER PAGE — full screen, distraction free ── */
  .scanner-shell { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }

  .scanner-header { height: 52px; background: var(--surface); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; padding: 0 24px; flex-shrink: 0; }
  .scanner-back { display: flex; align-items: center; gap: 8px; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-mute); text-decoration: none; font-weight: 600; transition: color 0.15s; }
  .scanner-back:hover { color: var(--text); }
  .scanner-back-icon { color: var(--ga-gold-hi); }
  .scanner-title { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-mute); font-weight: 600; }
  .scanner-vault-link { display: flex; align-items: center; gap: 6px; color: var(--text-mute); text-decoration: none; transition: color 0.15s; }
  .scanner-vault-link:hover { color: var(--text); }
  .scanner-vault-icon { color: var(--ga-gold-hi); }

  .scanner-body { flex: 1; overflow-y: auto; display: flex; flex-direction: column; align-items: center; padding: 32px 24px 48px; }
  @media (max-width: 768px) { .scanner-body { padding: 20px 16px 80px; } }

  .scanner-widget-wrap { width: 100%; max-width: 560px; }

  /* ── Widget token aliases — resolves AIHeroWidget internal vars ── */
  :root {
    --bg:       var(--shell);
    --goldHi:   var(--ga-gold-hi);
    --gold:     var(--ga-gold);
    --borderHi: var(--border-hi);
    --textDim:  var(--text-dim);
  }

  /* ── RESULT CARD — cream tokens scoped to .identify-result ── */
  .identify-result {
    --c-bg:         #EFE7D9;
    --c-surface:    #E6DCCB;
    --c-surface-lo: #EAE1D2;
    --c-border:     #C4B49E;
    --c-border-lo:  rgba(196,180,158,.3);
    --c-text:       #1C1810;
    --c-text-dim:   #5C5040;
    --c-text-mid:   #8A7A66;
    --c-gold:       #7A5C20;
    --c-dark:       #1C1810;
    --font-display: 'Playfair Display', Didot, Georgia, serif;
    --font-serif:   'Prata', Georgia, serif;
    width: 100%; max-width: 560px; margin: 32px 0 0;
    border: 1px solid var(--c-border); background: var(--c-bg);
  }
  .result-badges { display: flex; align-items: center; justify-content: space-between; padding: 20px 20px 0; }
  .result-category { font-family: var(--font-serif); font-size: 10px; letter-spacing: 4px; text-transform: uppercase; color: var(--c-gold); }
  .result-confidence { font-family: var(--font-serif); font-size: 10px; letter-spacing: 2px; text-transform: uppercase; padding: 4px 10px; border: 1px solid var(--c-border); color: var(--c-text-mid); }
  .result-title { font-family: var(--font-display); font-size: clamp(20px,4vw,28px); font-weight: 400; font-style: italic; color: var(--c-text); padding: 12px 20px 0; margin: 0; }
  .result-desc { font-family: var(--font-serif); font-size: 15px; line-height: 1.9; color: var(--c-text-dim); padding: 14px 20px; border-bottom: 1px solid var(--c-border); margin: 0; }
  .typed-cursor { display: inline-block; width: 2px; height: 1em; background: var(--c-gold); margin-left: 2px; vertical-align: text-bottom; animation: blink .7s step-end infinite; }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }
  .result-id-table { padding: 0 20px; border-bottom: 1px solid var(--c-border); }
  .result-id-row { display: flex; gap: 16px; align-items: flex-start; padding: 12px 0; border-bottom: 1px solid var(--c-border-lo); }
  .result-id-row:last-child { border-bottom: none; }
  .result-id-key { width: 90px; flex-shrink: 0; font-family: var(--font-serif); font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--c-text-mid); padding-top: 2px; }
  .result-id-val { font-family: var(--font-serif); font-size: 15px; color: var(--c-text); line-height: 1.5; flex: 1; }
  .result-value-block { background: var(--c-surface); border-bottom: 1px solid var(--c-border); padding: 28px 20px; text-align: center; }
  .result-value-label { font-family: var(--font-serif); font-size: 10px; letter-spacing: 4px; text-transform: uppercase; color: var(--c-text-mid); margin-bottom: 10px; }
  .result-value { font-family: var(--font-display); font-size: clamp(28px,6vw,44px); font-weight: 400; color: var(--c-gold); letter-spacing: -1px; }
  .result-notes-preview { padding: 24px 20px; background: var(--c-surface-lo); }
  .result-notes-label { font-family: var(--font-serif); font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--c-text-mid); margin-bottom: 10px; }
  .result-notes-text { font-family: var(--font-serif); font-size: 15px; line-height: 1.9; color: var(--c-text-dim); }
  .result-footer-bar { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-top: 1px solid var(--c-border); }
  .result-footer-brand { font-family: var(--font-display); font-size: 13px; font-style: italic; color: var(--c-gold); }
  .result-footer-ref { font-family: var(--font-serif); font-size: 10px; letter-spacing: 2px; color: var(--c-text-mid); }
  .result-view-report { padding: 16px 20px; box-sizing: border-box; width: 100%; display: none; }
  .result-view-report a { display: block; width: 100%; padding: 16px; background: var(--c-dark); font-family: var(--font-serif); font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: var(--c-bg); text-align: center; text-decoration: none; }
  .save-note { display: none; padding: 10px 20px; font-family: var(--font-serif); font-size: 9px; letter-spacing: 3px; text-transform: uppercase; color: var(--c-gold); }
  .save-note.visible { display: block; }
</style>

<div class="scanner-shell">

  <!-- Minimal header — back + title + credits -->
  <div class="scanner-header">
    <a href="/identify" class="scanner-back">
      <svg class="scanner-back-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      Scanners
    </a>
    <span class="scanner-title">Antiques Scanner</span>
    <a href="/library" class="scanner-vault-link" title="The Vault">
      <svg class="scanner-vault-icon" width="16" height="16" viewBox="0 0 14 14" fill="none"><rect x="1" y="1" width="5" height="5" fill="currentColor"/><rect x="8" y="1" width="5" height="5" fill="currentColor"/><rect x="1" y="8" width="5" height="5" fill="currentColor"/><rect x="8" y="8" width="5" height="5" fill="currentColor" opacity="0.28"/></svg>
    </a>
  </div>

  <!-- Scanner body -->
  <div class="scanner-body">
    <div class="scanner-widget-wrap" id="identify-widget-wrap" data-credit-cost={creditCostIdentify}>
      <AIHeroWidget context="general" category="Antiques" />
    </div>

    <div id="identify-result" class="identify-result" style="display:none">
      <div class="result-badges">
        <span class="result-category" id="result-category"></span>
        <span class="result-confidence" id="result-confidence"></span>
      </div>
      <h2 class="result-title" id="result-title"></h2>
      <p class="result-desc"><span id="typed-text"></span><span class="typed-cursor" id="typed-cursor"></span></p>
      <div class="result-id-table">
        <div class="result-id-row" id="row-maker" style="display:none"><div class="result-id-key">Maker</div><div class="result-id-val" id="result-maker"></div></div>
        <div class="result-id-row" id="row-period" style="display:none"><div class="result-id-key">Period</div><div class="result-id-val" id="result-period"></div></div>
        <div class="result-id-row" id="row-origin" style="display:none"><div class="result-id-key">Origin</div><div class="result-id-val" id="result-origin"></div></div>
        <div class="result-id-row"><div class="result-id-key">Condition</div><div class="result-id-val" id="result-condition"></div></div>
      </div>
      <div class="result-value-block">
        <div class="result-value-label">Estimated Value</div>
        <div class="result-value" id="result-value"></div>
      </div>
      <div class="result-notes-preview">
        <div class="result-notes-label">Appraiser Notes</div>
        <div class="result-notes-text" id="result-notes"></div>
      </div>
      <div class="result-view-report" id="result-view-report">
        <a id="view-report-link" href="#">View Full Report</a>
      </div>
      <div class="result-footer-bar">
        <span class="result-footer-brand">GAUK Antiques</span>
        <span class="result-footer-ref" id="result-ref"></span>
      </div>
      <div class="save-note" id="save-note">Saved to your library</div>
    </div>
  </div>
</div>

<script>
  import { supabase } from '../../lib/supabase-browser'
  import { ANTIQUES_SITE_ID } from '../../lib/constants'

  const { data: { session } } = await supabase.auth.getSession()
  if (!session) { window.location.href = 'https://gaukauth.com?from=gaukantiques.com&next=/library' }

  if (session) {
    window.__gauk_user_id = session.user.id
    window.__gauk_token = session.access_token


  }

  document.addEventListener('widget-reset-result', () => {
    const r = document.getElementById('identify-result') as HTMLElement
    if (r) r.style.display = 'none'
  })

  document.addEventListener('identification-complete', (e: any) => {
    const identifyData = e.detail
    const r = identifyData.result

    document.getElementById('result-category')!.textContent = r.category
    document.getElementById('result-confidence')!.textContent = r.confidence
    document.getElementById('result-title')!.textContent = r.subcategory
    document.getElementById('result-condition')!.textContent = r.condition

    const notes = [r.condition_notes, r.confidence_notes].filter(Boolean).join(' ')
    const notesEl = document.getElementById('result-notes')
    if (notesEl && notes) notesEl.textContent = notes

    const typedText = document.getElementById('typed-text') as HTMLElement
    const typedCursor = document.getElementById('typed-cursor') as HTMLElement
    if (typedText && typedCursor) {
      const desc = r.description || ''
      let ti = 0
      typedText.textContent = ''
      typedCursor.style.display = 'inline-block'
      function typeChar() {
        if (ti < desc.length) { typedText.textContent += desc[ti]; ti++; setTimeout(typeChar, 22) }
        else { typedCursor.style.display = 'none' }
      }
      setTimeout(typeChar, 400)
    }

    document.getElementById('result-value')!.textContent =
      '£' + (r.value_range_low || 0).toLocaleString() + ' – £' + (r.value_range_high || 0).toLocaleString() + ' / $' + Math.round((r.value_range_low || 0) * 1.27).toLocaleString() + ' – $' + Math.round((r.value_range_high || 0) * 1.27).toLocaleString()

    if (r.maker) { document.getElementById('result-maker')!.textContent = r.maker; document.getElementById('row-maker')!.style.display = 'flex' }
    if (r.period) { document.getElementById('result-period')!.textContent = r.period + (r.circa ? ' — ' + r.circa : ''); document.getElementById('row-period')!.style.display = 'flex' }
    if (r.country_of_origin) { document.getElementById('result-origin')!.textContent = r.country_of_origin; document.getElementById('row-origin')!.style.display = 'flex' }

    if (identifyData.id) {
      const ref = document.getElementById('result-ref')
      if (ref) ref.textContent = 'REF ' + identifyData.id.slice(0,8).toUpperCase()
      if (session) {
        const viewReport = document.getElementById('result-view-report') as HTMLElement
        const viewLink = document.getElementById('view-report-link') as HTMLAnchorElement
        if (viewReport) viewReport.style.display = 'block'
        if (viewLink) viewLink.href = '/valuation/' + identifyData.id
      }
    }

    const result = document.getElementById('identify-result') as HTMLElement
    result.style.display = 'block'
    result.scrollIntoView({ behavior: 'smooth', block: 'start' })

    if (session?.user?.id && identifyData.id) {
      const saveNote = document.getElementById('save-note')
      if (saveNote) saveNote.classList.add('visible')
    }
  })
</script>

<AppBottomNav activePage="scan" />
</AppLayout>
