---
import { ANTIQUES_SITE_ID, GI_SITE_ID } from '../lib/constants'
import AppLayout from '../layouts/AppLayout.astro'
import { supabase } from '../lib/supabase'

const [
  { data: plan },
  { data: identifyCost },
  { data: enrichCost },
] = await Promise.all([
  supabase.from('plans').select('credits').eq('site_id', ANTIQUES_SITE_ID).eq('plan_type', 'free').eq('active', true).single(),
  supabase.from('site_settings').select('value').eq('site_id', ANTIQUES_SITE_ID).eq('key', 'credit_cost_identify').single(),
  supabase.from('site_settings').select('value').eq('site_id', ANTIQUES_SITE_ID).eq('key', 'credit_cost_enrich').single(),
])

const freeCredits = plan?.credits || 5
const creditCostIdentify = parseInt(identifyCost?.value ?? '1', 10)
const creditCostEnrich = parseInt(enrichCost?.value ?? '5', 10)

// Detect most recent scan to determine CTA
// We check via cookie/session — done client-side since we don't have user context server-side here
const isGIUser = false // overridden client-side
---

<AppLayout title="Welcome to GAUK">
<style is:global>
  .wizard-shell {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 24px 80px;
    background: var(--shell);
  }

  .wizard-wrap {
    width: 100%;
    max-width: 480px;
  }

  /* ── STEP ── */
  .wizard-step { display: none; }
  .wizard-step.active { display: block; }

  /* ── HEADER ── */
  .wizard-eyebrow {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--ga-gold-hi);
    margin-bottom: 10px;
  }
  .wizard-title {
    font-family: var(--font-display);
    font-size: clamp(28px, 5vw, 38px);
    font-weight: 400;
    font-style: italic;
    color: var(--text);
    line-height: 1.2;
    margin-bottom: 8px;
  }
  .wizard-sub {
    font-family: var(--font-ui);
    font-size: 15px;
    color: var(--text-dim);
    line-height: 1.7;
    margin-bottom: 32px;
  }

  /* ── CREDITS BADGE ── */
  .wizard-credits-badge {
    background: var(--surface);
    border: 1px solid var(--border-hi);
    border-left: 3px solid var(--ga-gold);
    padding: 24px 28px;
    margin-bottom: 28px;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .wizard-credits-number {
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 400;
    color: var(--ga-gold-hi);
    line-height: 1;
    flex-shrink: 0;
  }
  .wizard-credits-label {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-mute);
    margin-bottom: 8px;
  }
  .wizard-credits-detail {
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--text-dim);
    line-height: 1.6;
  }

  /* ── DIVIDER ── */
  .wizard-divider {
    height: 1px;
    background: var(--border);
    margin: 28px 0;
  }

  /* ── CURRENCY STEP ── */
  .wizard-detect-label {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
    margin-bottom: 8px;
    font-weight: 600;
  }
  .wizard-detected {
    font-family: var(--font-display);
    font-size: 24px;
    font-style: italic;
    color: var(--text);
    margin-bottom: 6px;
  }
  .wizard-detect-note {
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--text-mute);
    margin-bottom: 24px;
  }
  .wizard-currency-select {
    width: 100%;
    padding: 13px 16px;
    background: var(--surface);
    border: 1px solid var(--border-hi);
    font-family: var(--font-ui);
    font-size: 15px;
    color: var(--text);
    appearance: none;
    outline: none;
    margin-bottom: 8px;
    cursor: pointer;
  }
  .wizard-currency-select:focus { border-color: var(--ga-gold); }
  .wizard-currency-note {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--text-mute);
    margin-bottom: 28px;
    line-height: 1.6;
  }

  /* ── BUTTONS ── */
  .wizard-btn {
    display: block;
    width: 100%;
    padding: 16px;
    background: var(--ga-gold);
    border: none;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    transition: opacity 0.2s;
    margin-bottom: 12px;
  }
  .wizard-btn:hover { opacity: 0.85; }
  .wizard-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .wizard-btn-ghost {
    display: block;
    width: 100%;
    padding: 13px;
    background: none;
    border: 1px solid var(--border-hi);
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-mute);
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }
  .wizard-btn-ghost:hover { border-color: var(--ga-gold); color: var(--text); }

  /* ── PROGRESS ── */
  .wizard-progress {
    display: flex;
    gap: 6px;
    margin-bottom: 36px;
  }
  .wizard-progress-dot {
    height: 2px;
    flex: 1;
    background: var(--border-hi);
    transition: background 0.3s;
  }
  .wizard-progress-dot.active { background: var(--ga-gold); }

  /* ── LOGO ── */
  .wizard-logo {
    margin-bottom: 36px;
  }
</style>

<div class="wizard-shell">
  <div class="wizard-wrap">

    <div class="wizard-logo">
      <img src="/gauk-logo.png" alt="GAUK" height="28" />
    </div>

    <div class="wizard-progress">
      <div class="wizard-progress-dot active" id="dot-1"></div>
      <div class="wizard-progress-dot" id="dot-2"></div>
    </div>

    <!-- STEP 1: Welcome + Credits -->
    <div class="wizard-step active" id="step-1">
      <div class="wizard-eyebrow">Welcome to GAUK</div>
      <div class="wizard-title">Your account is ready</div>
      <div class="wizard-sub">You have {freeCredits} free credits to get started. Here is what you can do with them.</div>

      <div class="wizard-credits-badge">
        <div class="wizard-credits-number">{freeCredits}</div>
        <div>
          <div class="wizard-credits-label">Free Credits, On Us</div>
          <div class="wizard-credits-detail">
            Use {creditCostIdentify} credit to identify a piece. We return the maker, period, condition and estimated value.<br/>
            Use {creditCostEnrich} credits to unlock a full valuation report with expert notes, market history and comparable sales.
          </div>
        </div>
      </div>

      <div class="wizard-divider"></div>

      <div style="font-family:var(--font-ui);font-size:13px;color:var(--text-mute);line-height:1.7;margin-bottom:28px;">
        Credits never expire and work across the GAUK network. Top up any time from your account page.
      </div>

      <button class="wizard-btn" id="step-1-next">Next: Set Your Currency</button>
    </div>

    <!-- STEP 2: Currency -->
    <div class="wizard-step" id="step-2">
      <div class="wizard-eyebrow">Your Currency</div>
      <div class="wizard-title">Where are you based?</div>
      <div class="wizard-sub">All valuations across the GAUK network will display in your currency. You can change this later in your account settings.</div>

      <div class="wizard-detect-label">Detected location</div>
      <div class="wizard-detected" id="detected-location">Detecting...</div>
      <div class="wizard-detect-note" id="detected-note">Confirm your currency below or select a different one.</div>

      <select class="wizard-currency-select" id="currency-select">
        <option value="GBP">GBP British Pound £</option>
        <option value="USD">USD US Dollar $</option>
        <option value="NZD">NZD New Zealand Dollar NZ$</option>
        <option value="AUD">AUD Australian Dollar AU$</option>
        <option value="EUR">EUR Euro €</option>
      </select>
      <div class="wizard-currency-note">This sets the display currency for valuations, price estimates and replacement costs across GAUK Antiques and GAUK Insurance.</div>

      <button class="wizard-btn" id="step-2-confirm" data-dest="library">Confirm and Go to My Collection</button>
      <div id="step-2-audit-cta" style="display:none;">
        <button class="wizard-btn" id="step-2-audit" style="margin-top:8px;background:var(--gi-sage);" data-dest="audit">Start My Room Audit</button>
      </div>
    </div>

  </div>
</div>

<script>
  import { supabase } from '../lib/supabase-browser'
  import { GI_SITE_ID } from '../lib/constants'

  const { data: { session } } = await supabase.auth.getSession()

  // ── Step navigation ────────────────────────────────────────────────────────
  document.getElementById('step-1-next')?.addEventListener('click', () => {
    document.getElementById('step-1')?.classList.remove('active')
    document.getElementById('step-2')?.classList.add('active')
    document.getElementById('dot-1')?.classList.remove('active')
    document.getElementById('dot-2')?.classList.add('active')
  })

  // ── Location detection ─────────────────────────────────────────────────────
  const COUNTRY_CURRENCY: Record<string, { currency: string; locale: string; label: string }> = {
    GB: { currency: 'GBP', locale: 'en-GB', label: 'United Kingdom' },
    US: { currency: 'USD', locale: 'en-US', label: 'United States' },
    NZ: { currency: 'NZD', locale: 'en-NZ', label: 'New Zealand' },
    AU: { currency: 'AUD', locale: 'en-AU', label: 'Australia' },
    DE: { currency: 'EUR', locale: 'de-DE', label: 'Germany' },
    FR: { currency: 'EUR', locale: 'fr-FR', label: 'France' },
  }

  const locationEl = document.getElementById('detected-location')!
  const noteEl = document.getElementById('detected-note')!
  const currencySelect = document.getElementById('currency-select') as HTMLSelectElement

  let detectedLocale = 'en-GB'

  try {
    const res = await fetch('https://ipapi.co/json/')
    const data = await res.json()
    const countryCode = data.country_code || 'GB'
    const match = COUNTRY_CURRENCY[countryCode]

    if (match) {
      locationEl.textContent = match.label
      currencySelect.value = match.currency
      detectedLocale = match.locale
    } else {
      locationEl.textContent = data.country_name || 'Unknown'
      currencySelect.value = 'GBP'
    }
    noteEl.textContent = 'We detected your location. Confirm your currency below or select a different one.'
  } catch {
    locationEl.textContent = 'Could not detect location'
    currencySelect.value = 'GBP'
  }

  // ── Confirm currency ───────────────────────────────────────────────────────
  async function saveAndRedirect() {
    const btn = document.getElementById('step-2-confirm') as HTMLButtonElement
    if (btn) { btn.disabled = true; btn.textContent = 'Saving...' }

    const currency = currencySelect.value
    const localeMap: Record<string, string> = {
      GBP: 'en-GB', USD: 'en-US', NZD: 'en-NZ', AUD: 'en-AU', EUR: 'en-GB'
    }
    const locale = localeMap[currency] || detectedLocale

    if (session) {
      await fetch('/api/user-settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${session.access_token}` },
        body: JSON.stringify({ currency, locale })
      })
    }

    // Redirect based on last scan type
    const dest = (document.getElementById('step-2-confirm') as HTMLButtonElement)?.dataset.dest || 'library'
    window.location.href = dest === 'audit' ? '/audit/setup' : '/library'
  }

  // Detect if most recent scan is GI — show audit CTA
  if (session) {
    try {
      const { data: lastScan } = await supabase
        .from('identifications')
        .select('site_id')
        .eq('user_id', session.user.id)
        .order('created_at', { ascending: false })
        .limit(1)
        .single()

      if (lastScan?.site_id === GI_SITE_ID) {
        // Show audit CTA, update confirm button destination
        const auditCta = document.getElementById('step-2-audit-cta')
        const confirmBtn = document.getElementById('step-2-confirm') as HTMLButtonElement
        if (auditCta) auditCta.style.display = 'block'
        if (confirmBtn) {
          confirmBtn.textContent = 'Confirm and Go to My Collection'
          confirmBtn.dataset.dest = 'library'
        }

        // Audit button
        document.getElementById('step-2-audit')?.addEventListener('click', async () => {
          const btn = document.getElementById('step-2-audit') as HTMLButtonElement
          if (btn) { btn.disabled = true; btn.textContent = 'Starting...' }
          const currency = (document.getElementById('currency-select') as HTMLSelectElement)?.value || 'GBP'
          const localeMap: Record<string, string> = { GBP: 'en-GB', USD: 'en-US', NZD: 'en-NZ', AUD: 'en-AU', EUR: 'en-GB' }
          if (session) {
            await fetch('/api/user-settings', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${session.access_token}` },
              body: JSON.stringify({ currency, locale: localeMap[currency] || 'en-GB' })
            })
          }
          window.location.href = '/audit/setup'
        })

        // Override confirm to go to library
        const confirmBtnEl = document.getElementById('step-2-confirm') as HTMLButtonElement
        if (confirmBtnEl) confirmBtnEl.dataset.giListenerAdded = 'true'
        confirmBtnEl?.addEventListener('click', async () => {
          const btn = document.getElementById('step-2-confirm') as HTMLButtonElement
          if (btn) { btn.disabled = true; btn.textContent = 'Saving...' }
          const currency = (document.getElementById('currency-select') as HTMLSelectElement).value
          const localeMap: Record<string, string> = { GBP: 'en-GB', USD: 'en-US', NZD: 'en-NZ', AUD: 'en-AU', EUR: 'en-GB' }
          if (session) {
            await fetch('/api/user-settings', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${session.access_token}` },
              body: JSON.stringify({ currency, locale: localeMap[currency] || 'en-GB' })
            })
          }
          window.location.href = '/library'
        })
      }
    } catch { /* no scan yet */ }
  }

  // Only add default listener if not GI user (GI user has its own listeners added above)
  if (!document.getElementById('step-2-confirm')?.dataset.giListenerAdded) {
    document.getElementById('step-2-confirm')?.addEventListener('click', saveAndRedirect)
  }

</script>
</AppLayout>
