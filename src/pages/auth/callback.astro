<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Signing you in — GAUK</title>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      width: 100%; height: 100%;
      background: #1b1b1b;
      color: #ffffff;
      font-family: 'Montserrat', sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .callback-wrap {
      min-height: 100svh;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      padding: 40px 20px;
    }
    .callback-card { width: 100%; max-width: 400px; text-align: center; }
    .callback-title {
      font-size: 22px; font-weight: 300;
      letter-spacing: 0.02em; color: #ffffff;
      margin-bottom: 10px;
    }
    .callback-sub {
      font-size: 13px; font-weight: 400;
      color: rgba(255,255,255,0.45); line-height: 1.7;
    }
    .callback-error {
      font-size: 13px; color: #ef4444;
      background: rgba(239,68,68,0.08);
      border: 1px solid rgba(239,68,68,0.2);
      padding: 12px 16px; margin-top: 20px; display: none;
    }
    .callback-wordmark {
      font-size: 13px; font-weight: 600;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: #ffffff; margin-bottom: 32px;
    }
    .callback-wordmark span { color: #3a8197; }
  </style>
</head>
<body>
<div class="callback-wrap">
  <div class="callback-card">
    <div class="callback-wordmark">GAUK <span>Network</span></div>
    <div class="callback-title">Signing you in…</div>
    <div class="callback-sub">Please wait a moment.</div>
    <div class="callback-error" id="callback-error"></div>
  </div>
</div>

<script>
  import { supabase } from '../../lib/supabase-browser'

  async function handleCallback() {
    var errorEl = document.getElementById('callback-error')
    var params  = new URLSearchParams(window.location.search)
    var next    = params.get('next') || '/library'
    var accessToken  = params.get('access_token')
    var refreshToken = params.get('refresh_token')

    if (!accessToken || !refreshToken) {
      errorEl.textContent = 'Invalid sign-in link. Please sign in again.'
      errorEl.style.display = 'block'
      setTimeout(function() { window.location.href = 'https://gaukauth.com?from=gaukantiques.com&next=/library' }, 3000)
      return
    }

    var result = await supabase.auth.setSession({
      access_token:  accessToken,
      refresh_token: refreshToken
    })

    if (result.error || !result.data.session) {
      errorEl.textContent = 'Session handoff failed. Please sign in again.'
      errorEl.style.display = 'block'
      setTimeout(function() { window.location.href = 'https://gaukauth.com?from=gaukantiques.com&next=/library' }, 3000)
      return
    }

    // Claim pending GA guest scan if exists
    var gaPendingScan = ''
    try { gaPendingScan = localStorage.getItem('ga_pending_scan') || '' } catch(e) {}
    if (gaPendingScan) {
      await fetch('/api/claim-identification', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + result.data.session.access_token },
        body: JSON.stringify({ identification_id: gaPendingScan })
      })
      try { localStorage.removeItem('ga_pending_scan') } catch(e) {}
    }

    // Claim pending GI guest scan if exists
    var giPendingScan = ''
    try { giPendingScan = localStorage.getItem('gi_pending_scan') || '' } catch(e) {}
    if (giPendingScan) {
      await fetch('/api/claim-identification', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + result.data.session.access_token },
        body: JSON.stringify({ identification_id: giPendingScan })
      })
      try { localStorage.removeItem('gi_pending_scan') } catch(e) {}
    }

    // Claim pending GR guest scan if exists — passed via URL param from gaukreceipts.com
    var grPendingScan = params.get('pending_scan') || ''
    if (grPendingScan) {
      await fetch('/api/claim-receipt', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + result.data.session.access_token },
        body: JSON.stringify({ receipt_id: grPendingScan })
      })
    }

    window.location.href = next
  }

  handleCallback()
</script>
