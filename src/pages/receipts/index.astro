---

import AppLayout from '../../layouts/AppLayout.astro'
import AppSidebar from '../../components/AppSidebar.astro'
import AppBottomNav from '../../components/AppBottomNav.astro'
---
<AppLayout title="My Receipts — GAUK">
<style is:global>
  .app-shell { display: flex; height: 100vh; overflow: hidden; }
  .app-main  { margin-left: 220px; flex: 1; display: flex; flex-direction: column; overflow: hidden; min-width: 0; }
  @media (max-width: 768px) { .app-main { margin-left: 0; padding-bottom: 64px; } }

  /* Topbar */
  .page-topbar { background: var(--surface); border-bottom: 1px solid var(--border); display: flex; flex-direction: column; flex-shrink: 0; }
  .topbar-row1 { height: 52px; display: flex; align-items: center; padding: 0 24px; gap: 12px; }
  .topbar-row2 { display: flex; align-items: center; gap: 8px; padding: 8px 24px; border-top: 1px solid var(--border); }
  @media (min-width: 769px) { .topbar-row2 { padding: 8px 24px 10px; } }

  /* Filter bar */
  .filter-bar { display: flex; gap: 8px; flex-wrap: wrap; padding: 16px 24px 0; }
  .filter-chip { font-family: var(--font-ui); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 600; padding: 5px 14px; border: 1px solid var(--border-hi); background: none; color: var(--text-mute); cursor: pointer; transition: border-color 0.15s, color 0.15s; }
  .filter-chip:hover { border-color: var(--gr-violet); color: var(--text); }
  .filter-chip.active { border-color: var(--gr-violet); color: var(--gr-violet); }

  /* Scroll area */
  .receipts-scroll { flex: 1; overflow-y: auto; padding: 20px 24px 24px; }
  @media (max-width: 768px) { .receipts-scroll { padding: 16px; } }

  /* Grid */
  .receipts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }

  /* Card */
  .receipt-card {
    background: var(--surface); border: 1px solid var(--border-hi);
    cursor: pointer; transition: border-color 0.15s;
    animation: fadeUp 0.22s ease forwards; overflow: hidden;
    display: flex; flex-direction: column;
  }
  .receipt-card:hover { border-color: #363636; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

  .card-thumb {
    height: 140px; display: flex; align-items: center; justify-content: center;
    background: var(--surface-hi); border-bottom: 1px solid var(--border); overflow: hidden; position: relative;
  }
  .card-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .card-thumb-placeholder { font-size: 48px; opacity: 0.15; user-select: none; }

  .card-body { padding: 14px 16px; display: flex; flex-direction: column; gap: 8px; flex: 1; }

  .card-badge {
    display: inline-flex; align-items: center; padding: 2px 7px;
    font-family: var(--font-ui); font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.11em;
    border: 1px solid rgba(122,110,158,0.3); color: var(--gr-violet); background: rgba(122,110,158,0.07);
    align-self: flex-start;
  }

  .card-merchant { font-family: var(--font-ui); font-size: 14px; font-weight: 600; color: var(--text); line-height: 1.3; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; }

  .card-meta { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 4px; }
  .card-date { font-family: var(--font-ui); font-size: 12px; color: var(--text-mute); }
  .card-total { font-family: var(--font-ui); font-size: 18px; font-weight: 700; color: var(--gr-violet); }

  /* Quick-view drawer */
  .qv-overlay {
    display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 100;
    opacity: 0; transition: opacity 0.2s;
  }
  .qv-overlay.open { display: block; opacity: 1; }

  .qv-drawer {
    position: fixed; top: 0; right: -480px; width: 480px; max-width: 100vw;
    height: 100vh; background: var(--surface); border-left: 1px solid var(--border-hi);
    z-index: 101; display: flex; flex-direction: column;
    transition: right 0.25s cubic-bezier(0.32, 0, 0.2, 1);
    overflow: hidden;
  }
  .qv-drawer.open { right: 0; }

  .qv-header {
    height: 52px; background: var(--surface-lo); border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 20px; flex-shrink: 0;
  }
  .qv-title { font-family: var(--font-ui); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; color: var(--text-mute); }
  .qv-close { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: none; border: 1px solid var(--border-hi); color: var(--text-mute); font-size: 18px; cursor: pointer; transition: color 0.15s; }
  .qv-close:hover { color: var(--text); }

  .qv-body { flex: 1; overflow-y: auto; }

  .qv-image { width: 100%; max-height: 280px; object-fit: contain; background: var(--surface-hi); border-bottom: 1px solid var(--border); display: block; padding: 16px; box-sizing: border-box; }

  .qv-section { padding: 20px; border-bottom: 1px solid var(--border); }
  .qv-label { font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gr-violet); font-weight: 600; margin-bottom: 12px; display: block; }

  .qv-merchant { font-family: var(--font-ui); font-size: 20px; font-weight: 700; color: var(--text); margin-bottom: 4px; }
  .qv-meta-row { display: flex; gap: 16px; font-family: var(--font-ui); font-size: 13px; color: var(--text-mute); flex-wrap: wrap; }

  .qv-total-block { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .qv-stat { display: flex; flex-direction: column; gap: 4px; }
  .qv-stat-label { font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-mute); }
  .qv-stat-value { font-family: var(--font-ui); font-size: 22px; font-weight: 700; color: var(--gr-violet); }
  .qv-stat-value.neutral { color: var(--text); }

  .qv-items-list { display: flex; flex-direction: column; gap: 0; }
  .qv-item-row { display: flex; justify-content: space-between; align-items: baseline; padding: 8px 0; border-bottom: 1px solid var(--border-hi); gap: 12px; }
  .qv-item-row:last-child { border-bottom: none; }
  .qv-item-desc { font-family: var(--font-ui); font-size: 13px; color: var(--text-dim); flex: 1; }
  .qv-item-amount { font-family: var(--font-ui); font-size: 13px; font-weight: 600; color: var(--text); flex-shrink: 0; }
  .qv-item-meta { font-family: var(--font-ui); font-size: 11px; color: var(--text-mute); margin-top: 2px; display: flex; gap: 8px; align-items: center; }
  .qv-sale-badge { font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #c97b2b; background: rgba(201,123,43,0.12); border: 1px solid rgba(201,123,43,0.3); padding: 1px 6px; }
  .qv-original-price { font-size: 11px; color: var(--text-mute); text-decoration: line-through; }
  .qv-savings-row { display: flex; justify-content: space-between; padding: 8px 0; font-family: var(--font-ui); font-size: 13px; color: #5a9e68; font-weight: 600; border-top: 1px solid var(--border-hi); margin-top: 4px; }
  .qv-tax-row { display: flex; justify-content: space-between; padding: 6px 0; font-family: var(--font-ui); font-size: 12px; color: var(--text-mute); }
  .qv-total-row { display: flex; justify-content: space-between; padding: 10px 0 0; font-family: var(--font-ui); font-size: 15px; font-weight: 700; color: var(--text); border-top: 1px solid var(--border-hi); margin-top: 4px; }

  .qv-warranty { background: rgba(122,110,158,0.08); border: 1px solid rgba(122,110,158,0.2); padding: 12px 16px; margin: 20px; }
  .qv-warranty-label { font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gr-violet); font-weight: 600; margin-bottom: 4px; display: block; }
  .qv-warranty-text { font-family: var(--font-ui); font-size: 13px; color: var(--text-dim); }

  .qv-notes { padding: 0 20px 20px; font-family: var(--font-ui); font-size: 13px; color: var(--text-mute); line-height: 1.7; font-style: italic; }

  /* Lightbox */
  .qv-image { cursor: zoom-in; }
  .lb-overlay {
    display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.92);
    z-index: 200; align-items: center; justify-content: center;
    cursor: zoom-out;
  }
  .lb-overlay.open { display: flex; }
  .lb-img { max-width: 96vw; max-height: 92vh; object-fit: contain; box-shadow: 0 8px 48px rgba(0,0,0,0.6); }
  .lb-close { position: fixed; top: 16px; right: 20px; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: white; font-size: 20px; cursor: pointer; z-index: 201; }
  .lb-nav { position: fixed; top: 50%; transform: translateY(-50%); width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: white; font-size: 20px; cursor: pointer; z-index: 201; }
  .lb-prev { left: 16px; }
  .lb-next { right: 64px; }
  .qv-item-image { width: 100%; max-height: 200px; object-fit: contain; background: var(--surface-hi); border-bottom: 1px solid var(--border); display: block; padding: 12px; box-sizing: border-box; cursor: zoom-in; }
  .qv-photo-strip { display: flex; gap: 8px; padding: 14px 20px; border-top: 1px solid var(--border); overflow-x: auto; flex-wrap: nowrap; }
  .qv-photo-thumb { position: relative; flex-shrink: 0; width: 80px; height: 80px; cursor: zoom-in; }
  .qv-photo-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .qv-photo-delete { position: absolute; top: 2px; right: 2px; width: 18px; height: 18px; background: rgba(0,0,0,0.7); color: white; border: none; font-size: 10px; cursor: pointer; display: flex; align-items: center; justify-content: center; line-height: 1; }
  .qv-photo-add { flex-shrink: 0; width: 80px; height: 80px; border: 1px dashed var(--border-hi); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; cursor: pointer; transition: border-color 0.15s; color: var(--text-mute); }
  .qv-photo-add:hover { border-color: var(--gr-violet); color: var(--gr-violet); }
  .qv-photo-add-label { font-family: var(--font-ui); font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; }

  /* States */
  .loading-state { display: flex; align-items: center; justify-content: center; min-height: 50vh; }
  .loading-dots { display: flex; gap: 6px; }
  .loading-dots span { width: 6px; height: 6px; border-radius: 50%; background: var(--gr-violet); animation: dot-pulse 1.2s ease-in-out infinite; }
  .loading-dots span:nth-child(2) { animation-delay: 0.2s; }
  .loading-dots span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes dot-pulse { 0%,80%,100% { opacity:0.2; transform:scale(0.8); } 40% { opacity:1; transform:scale(1); } }

  .empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 50vh; gap: 16px; }

  /* Search + controls */
  .search-wrap { display: flex; align-items: center; gap: 8px; flex: 1; max-width: 280px; background: var(--surface-hi); border: 1px solid var(--border-hi); padding: 0 10px; height: 32px; }
  .search-wrap svg { flex-shrink: 0; opacity: 0.3; }
  .search-input { font-family: var(--font-ui); font-size: 13px; background: none; border: none; outline: none; color: var(--text); width: 100%; }
  .search-input::placeholder { color: var(--text-faint); }
  .date-filter { height: 32px; padding: 0 10px; border: 1px solid var(--border-hi); background: var(--surface-hi); color: var(--text-mute); font-family: var(--font-ui); font-size: 12px; appearance: none; -webkit-appearance: none; cursor: pointer; }
  .date-filter option { background: var(--surface); color: var(--text-dim); }
  .view-toggle { display: flex; border: 1px solid var(--border-hi); overflow: hidden; flex-shrink: 0; }
  .view-btn { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; background: transparent; color: var(--text-faint); transition: background 0.1s, color 0.1s; border: none; cursor: pointer; }
  .view-btn.active { background: rgba(255,255,255,0.06); color: var(--gr-violet); }

  /* List view */
  .receipts-list { display: flex; flex-direction: column; border-top: 1px solid var(--border); }
  .receipt-list-row { display: flex; align-items: center; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--border); cursor: pointer; transition: background 0.1s, padding-left 0.1s; }
  .receipt-list-row:hover { background: var(--surface-hi); padding-left: 8px; }
  .receipt-list-merchant { font-family: var(--font-ui); font-size: 14px; font-weight: 600; color: var(--text); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .receipt-list-date { font-family: var(--font-ui); font-size: 12px; color: var(--text-mute); flex-shrink: 0; }
  .receipt-list-cat { font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gr-violet); background: rgba(122,110,158,0.1); padding: 2px 8px; flex-shrink: 0; }
  .receipt-list-total { font-family: var(--font-ui); font-size: 14px; font-weight: 700; color: var(--gr-violet); flex-shrink: 0; }
  @media (max-width: 480px) { .receipt-list-cat { display: none; } }

  /* Confidence gauge */
  .qv-confidence-wrap { display: flex; align-items: center; gap: 14px; padding: 20px; border-bottom: 1px solid var(--border); }
  .qv-conf-text { font-family: var(--font-ui); font-size: 13px; color: var(--text-dim); line-height: 1.6; flex: 1; }

  /* Delete */
  .qv-delete-zone { padding: 20px; border-top: 1px solid var(--border); }
  .qv-delete-btn { width: 100%; padding: 10px; background: none; border: 1px solid rgba(196,96,40,0.3); color: #c46028; font-family: var(--font-ui); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; cursor: pointer; transition: background 0.15s; }
  .qv-delete-btn:hover { background: rgba(196,96,40,0.08); }
  .qv-delete-confirm { display: none; flex-direction: column; gap: 10px; margin-top: 10px; }
  .qv-delete-confirm.visible { display: flex; }
  .qv-delete-confirm p { font-family: var(--font-ui); font-size: 13px; color: var(--text-dim); margin: 0; }
  .qv-delete-actions { display: flex; gap: 8px; }
  .qv-delete-yes { flex: 1; padding: 10px; background: rgba(196,96,40,0.12); border: 1px solid rgba(196,96,40,0.4); color: #c46028; font-family: var(--font-ui); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 600; cursor: pointer; }
  .qv-delete-no { flex: 1; padding: 10px; background: none; border: 1px solid var(--border-hi); color: var(--text-mute); font-family: var(--font-ui); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 600; cursor: pointer; }
</style>

<div class="app-shell">
  <AppSidebar activePage="receipts" />
  <div class="app-main">

    <div class="page-topbar">
      <div class="topbar-row1">
        <span style="font-family: var(--font-ui); font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-mute); flex-shrink:0;">My Receipts</span>
        <span id="receipt-count" style="font-family: var(--font-ui); font-size: 12px; color: var(--text-faint);"></span>
        <div class="view-toggle" style="margin-left:auto;">
          <button class="view-btn active" id="btn-grid" title="Grid">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><rect x="1" y="1" width="5" height="5" fill="currentColor"/><rect x="8" y="1" width="5" height="5" fill="currentColor"/><rect x="1" y="8" width="5" height="5" fill="currentColor"/><rect x="8" y="8" width="5" height="5" fill="currentColor" opacity="0.4"/></svg>
          </button>
          <button class="view-btn" id="btn-list" title="List">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><line x1="1" y1="3" x2="13" y2="3" stroke="currentColor" stroke-width="1.5"/><line x1="1" y1="7" x2="13" y2="7" stroke="currentColor" stroke-width="1.5"/><line x1="1" y1="11" x2="13" y2="11" stroke="currentColor" stroke-width="1.5"/></svg>
          </button>
        </div>
        <a href="/receipts/scan" style="font-family: var(--font-ui); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; color: var(--gr-violet); text-decoration: none; border: 1px solid var(--gr-violet); padding: 6px 14px; flex-shrink: 0;">+ Scan</a>
      </div>
      <div class="topbar-row2">
        <div class="search-wrap" style="flex:1;">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input class="search-input" id="receipt-search" type="text" placeholder="Search merchant or item..." autocomplete="off" />
        </div>
        <select class="date-filter" id="date-filter">
          <option value="0">All time</option>
          <option value="30">Last 30 days</option>
          <option value="90">Last 3 months</option>
          <option value="365">Last year</option>
        </select>
      </div>
    </div>

    <div id="filter-bar" class="filter-bar" style="display: none;"></div>

    <div class="receipts-scroll">
      <div class="loading-state" id="loading-state"><div class="loading-dots"><span></span><span></span><span></span></div></div>
      <div class="receipts-grid" id="receipts-grid" style="display: none;"></div>
      <div class="receipts-list" id="receipts-list" style="display: none;"></div>
      <div class="empty-state" id="empty-state" style="display: none;">
        <svg width="48" height="48" viewBox="0 0 48 48" fill="none"><rect x="8" y="4" width="32" height="40" rx="2" stroke="var(--gr-violet)" stroke-width="1.6" fill="none" opacity="0.5"/><line x1="14" y1="16" x2="34" y2="16" stroke="var(--gr-violet)" stroke-width="1.2" opacity="0.5"/><line x1="14" y1="22" x2="34" y2="22" stroke="var(--gr-violet)" stroke-width="1.2" opacity="0.5"/><line x1="14" y1="28" x2="28" y2="28" stroke="var(--gr-violet)" stroke-width="1.2" opacity="0.5"/></svg>
        <p style="font-family: var(--font-ui); font-size: 14px; color: var(--text-mute); text-align: center; max-width: 280px; line-height: 1.7;">No receipts yet. Scan your first receipt to start building your proof of purchase vault.</p>
        <a href="/receipts/scan" style="font-family: var(--font-ui); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; color: var(--gr-violet); text-decoration: none; border: 1px solid var(--gr-violet); padding: 10px 24px;">Scan a Receipt</a>
      </div>
    </div>

  </div>
</div>
<!-- Lightbox -->
<div class="lb-overlay" id="lb-overlay">
  <button class="lb-close" id="lb-close">&#x2715;</button>
  <button class="lb-nav lb-prev" id="lb-prev" style="display:none;">&#x2039;</button>
  <button class="lb-nav lb-next" id="lb-next" style="display:none;">&#x203a;</button>
  <img class="lb-img" id="lb-img" src="" alt="Receipt" />
</div>
<input type="file" id="item-photo-input" accept="image/*" style="display:none;" />

<AppBottomNav activePage="receipts" />

<!-- Quick-view overlay + drawer -->
<div class="qv-overlay" id="qv-overlay"></div>
<div class="qv-drawer" id="qv-drawer">
  <div class="qv-header">
    <span class="qv-title">Receipt</span>
    <button class="qv-close" id="qv-close">&#x2715;</button>
  </div>
  <div class="qv-body" id="qv-body"></div>
  <div class="qv-delete-zone" id="qv-delete-zone" style="display:none;">
    <button class="qv-delete-btn" id="qv-delete-btn">Delete this receipt</button>
    <div class="qv-delete-confirm" id="qv-delete-confirm">
      <p>This will permanently remove this receipt from your vault.</p>
      <div class="qv-delete-actions">
        <button class="qv-delete-yes" id="qv-delete-yes">Delete</button>
        <button class="qv-delete-no" id="qv-delete-no">Cancel</button>
      </div>
    </div>
  </div>
</div>

</AppLayout>

<script>
  import { supabase } from '../../lib/supabase-browser'

  const R2_CDN = 'https://pub-c3f96dd742f540188b92599aeed807c7.r2.dev'
  let allReceipts: any[] = []
  let activeCategory = 'all'
  let activeView: 'grid' | 'list' = 'grid'
  let currentReceiptId: string | null = null


  function formatDate(d: string) {
    if (!d) return ''
    try { return new Date(d).toLocaleDateString('en-NZ', { day: 'numeric', month: 'short', year: 'numeric' }) }
    catch { return d }
  }

  function formatTotal(total: number, currency: string) {
    if (!total) return ''
    const sym: Record<string,string> = { NZD: 'NZ$', AUD: 'A$', GBP: '£', USD: '$', EUR: '€' }
    return (sym[currency] || (currency ? currency + ' ' : '$')) + Number(total).toFixed(2)
  }

  function matchesSearch(r: any, q: string): boolean {
    if (!q) return true
    const s = q.toLowerCase()
    if (r.merchant?.toLowerCase().includes(s)) return true
    if (r.category?.toLowerCase().includes(s)) return true
    if (r.notes?.toLowerCase().includes(s)) return true
    return r.rj_items?.some((i: any) => i.description?.toLowerCase().includes(s))
  }

  function matchesDate(r: any, days: number): boolean {
    if (!days) return true
    if (!r.date) return false
    const cutoff = new Date()
    cutoff.setDate(cutoff.getDate() - days)
    return new Date(r.date) >= cutoff
  }

  function getFiltered(): any[] {
    const q = (document.getElementById('receipt-search') as HTMLInputElement)?.value || ''
    const days = parseInt((document.getElementById('date-filter') as HTMLSelectElement)?.value || '0')
    return allReceipts.filter(r =>
      matchesSearch(r, q) &&
      matchesDate(r, days) &&
      (activeCategory === 'all' || r.category === activeCategory)
    )
  }

  function applyFilters() { renderReceipts(getFiltered()) }

  function confScore(c: string): number {
    return c === 'High' ? 94 : c === 'Medium' ? 72 : 45
  }

  function confGauge(score: number): string {
    const r = 20, circ = 2 * Math.PI * r
    const offset = circ - (circ * score / 100)
    return '<svg width="44" height="44" viewBox="0 0 44 44" style="flex-shrink:0;transform:rotate(-90deg)">'
      + '<circle cx="22" cy="22" r="' + r + '" fill="none" stroke="var(--border-hi)" stroke-width="3"/>'
      + '<circle cx="22" cy="22" r="' + r + '" fill="none" stroke="var(--gr-violet)" stroke-width="3"'
      + ' stroke-dasharray="' + circ.toFixed(2) + '" stroke-dashoffset="' + offset.toFixed(2) + '"'
      + ' stroke-linecap="round"/>'
      + '<text x="22" y="27" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" font-weight="600"'
      + ' fill="var(--text)" transform="rotate(90,22,22)">' + score + '%</text>'
      + '</svg>'
  }

  function confNote(c: string): string {
    if (c === 'High') return 'Strong match — the AI is highly confident in this receipt extraction.'
    if (c === 'Medium') return 'Good match — most data extracted accurately. Review line items for any errors.'
    return 'Low confidence — the receipt may be unclear. Verify the details manually.'
  }

  function buildCard(r: any) {
    const card = document.createElement('div')
    card.className = 'receipt-card'
    card.dataset.id = r.id

    const thumbHtml = r.image_key
      ? `<div class="card-thumb"><img src="${R2_CDN}/${r.image_key}" alt="${r.merchant || 'Receipt'}" loading="lazy" /></div>`
      : `<div class="card-thumb"><span class="card-thumb-placeholder">🧾</span></div>`

    const badge = r.category ? `<span class="card-badge">${r.category}</span>` : ''
    const vaultBadge = r.identification_id ? `<span class="card-badge" style="border-color:rgba(124,144,130,0.3);color:var(--gi-sage);background:rgba(124,144,130,0.07);">Vault item</span>` : ''

    card.innerHTML = `
      ${thumbHtml}
      <div class="card-body">
        ${badge}${vaultBadge}
        <div class="card-merchant">${r.merchant || 'Unknown merchant'}</div>
        <div class="card-meta">
          <span class="card-date">${formatDate(r.date)}</span>
          <span class="card-total">${formatTotal(r.total, r.currency)}</span>
        </div>
      </div>
    `
    card.addEventListener('click', () => openDrawer(r))
    return card
  }

  function renderReceipts(receipts: any[]) {
    const grid = document.getElementById('receipts-grid')!
    const list = document.getElementById('receipts-list')!
    grid.innerHTML = ''
    list.innerHTML = ''

    if (!receipts.length) {
      grid.style.display = 'none'
      list.style.display = 'none'
      document.getElementById('empty-state')!.style.display = 'flex'
      return
    }

    document.getElementById('empty-state')!.style.display = 'none'

    if (activeView === 'grid') {
      grid.style.display = 'grid'
      list.style.display = 'none'
      receipts.forEach((r: any) => grid.appendChild(buildCard(r)))
    } else {
      grid.style.display = 'none'
      list.style.display = 'flex'
      receipts.forEach((r: any) => {
        const row = document.createElement('div')
        row.className = 'receipt-list-row'
        const catHtml = r.category ? '<span class="receipt-list-cat">' + r.category + '</span>' : ''
        row.innerHTML = '<div class="receipt-list-merchant">' + (r.merchant || 'Unknown') + '</div>'
          + '<span class="receipt-list-date">' + formatDate(r.date) + '</span>'
          + catHtml
          + '<span class="receipt-list-total">' + formatTotal(r.total, r.currency) + '</span>'
        row.addEventListener('click', () => openDrawer(r))
        list.appendChild(row)
      })
    }
  }

  function buildFilters(receipts: any[]) {
    const cats: string[] = ['all']
    receipts.forEach((r: any) => { if (r.category && !cats.includes(r.category)) cats.push(r.category) })
    if (cats.length <= 2) return

    const bar = document.getElementById('filter-bar')!
    bar.innerHTML = ''
    bar.style.display = 'flex'

    cats.forEach((cat: string) => {
      const chip = document.createElement('button')
      chip.className = 'filter-chip' + (cat === 'all' ? ' active' : '')
      chip.textContent = cat === 'all' ? 'All' : cat
      chip.addEventListener('click', () => {
        activeCategory = cat
        document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'))
        chip.classList.add('active')
        renderReceipts(cat === 'all' ? allReceipts : allReceipts.filter((r: any) => r.category === cat))
      })
      bar.appendChild(chip)
    })
  }

  // ── Quick-view drawer ──────────────────────────────────────
  function openDrawer(r: any) {
    const body = document.getElementById('qv-body')!
    const items: any[] = r.rj_items && r.rj_items.length ? r.rj_items : r.line_items || []

    const imageHtml = r.image_key
      ? `<img class="qv-image" src="${R2_CDN}/${r.image_key}" alt="${r.merchant || 'Receipt'}" />`
      : ''
    const photos: any[] = r.receipt_images || []
    const photoThumbsHtml = photos.map((img: any, idx: number) =>
      `<div class="qv-photo-thumb" data-key="${img.image_key}" data-id="${img.id}" data-idx="${idx}">`
      + `<img src="${R2_CDN}/${img.image_key}" alt="Item photo ${idx + 1}" />`
      + `<button class="qv-photo-delete" data-img-id="${img.id}" title="Remove">&times;</button>`
      + `</div>`
    ).join('')
    const itemImgHtml = `<div class="qv-photo-strip" id="qv-photo-strip">`
      + photoThumbsHtml
      + `<div class="qv-photo-add" id="qv-add-photo-btn">`
      + `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>`
      + `<span class="qv-photo-add-label">Add photo</span>`
      + `</div></div>`

    // Merchant section
    const merchantMeta = [
      r.rj_merchant_branch || '',
      r.rj_merchant_gst ? 'GST No. ' + r.rj_merchant_gst : '',
    ].filter(Boolean).join(' — ')

    const dateTime = [formatDate(r.date), r.rj_time || ''].filter(Boolean).join(' ')

    // Items — use rich data if available
    const itemsHtml = items.length
      ? items.map((i: any) => {
          const usesRich = 'unit_price' in i
          const desc = i.description || ''
          const itemCat = i.category || ''
          const qty = usesRich ? (i.quantity ?? 1) : 1
          const price = usesRich ? (i.line_total ?? i.unit_price ?? 0) : (i.amount ?? 0)
          const origPrice = usesRich ? (i.original_price ?? null) : null
          const onSale = usesRich ? !!i.is_on_sale : false
          const saleBadge = onSale ? `<span class="qv-sale-badge">SALE</span>` : ''
          const origHtml = origPrice ? `<span class="qv-original-price">${formatTotal(origPrice, r.currency)}</span>` : ''
          const metaItems = [
            itemCat,
            qty > 1 ? `Qty ${qty}` : '',
          ].filter(Boolean).join(' · ')
          return `
            <div class="qv-item-row">
              <div class="qv-item-desc">
                <div>${desc}</div>
                ${metaItems ? `<div class="qv-item-meta">${metaItems} ${saleBadge}</div>` : ''}
              </div>
              <div style="text-align:right;flex-shrink:0;">
                <div class="qv-item-amount">${formatTotal(price, r.currency)}</div>
                ${origHtml}
              </div>
            </div>`
        }).join('')
      : '<p style="font-family:var(--font-ui);font-size:13px;color:var(--text-mute);">No line items recorded.</p>'

    // Totals
    const taxRow = r.rj_tax_amount
      ? `<div class="qv-tax-row"><span>${r.rj_tax_label || 'Tax'} included</span><span>${formatTotal(r.rj_tax_amount, r.currency)}</span></div>`
      : ''
    const savingsRow = r.rj_savings
      ? `<div class="qv-savings-row"><span>You saved</span><span>${formatTotal(r.rj_savings, r.currency)}</span></div>`
      : ''
    const paymentNote = r.rj_payment && r.rj_payment !== 'unknown'
      ? `<div style="font-family:var(--font-ui);font-size:11px;color:var(--text-mute);margin-top:8px;text-transform:uppercase;letter-spacing:0.1em;">${r.rj_payment}</div>`
      : ''

    // Warranty
    const warrantyHtml = r.warranty_expiry
      ? `<div class="qv-warranty">
           <span class="qv-warranty-label">Warranty</span>
           <span class="qv-warranty-text">${r.warranty_years ? r.warranty_years + ' year warranty' : ''} — expires ${formatDate(r.warranty_expiry)}</span>
         </div>`
      : ''

    const notesHtml = r.notes
      ? `<div class="qv-notes">${r.notes}</div>`
      : ''

    const confHtml = '<div class="qv-confidence-wrap">' + confGauge(confScore(r.confidence || 'High')) + '<span class="qv-conf-text">' + confNote(r.confidence || 'High') + '</span></div>'
    body.innerHTML = `
      ${imageHtml}
      ${itemImgHtml}
      <div class="qv-section">
        <span class="qv-label">Merchant</span>
        <div class="qv-merchant">${r.merchant || 'Unknown'}</div>
        <div class="qv-meta-row">
          ${merchantMeta ? `<span>${merchantMeta}</span>` : ''}
        </div>
        <div class="qv-meta-row" style="margin-top:4px;">
          <span>${dateTime}</span>
          ${r.category ? `<span>${r.category}</span>` : ''}
          ${r.receipt_number ? `<span>Ref ${r.receipt_number}</span>` : ''}
          ${r.identification_id ? `<a href="/valuation/${r.identification_id}" style="color:var(--gi-sage);font-size:11px;text-decoration:none;border-bottom:1px solid rgba(124,144,130,0.3);">View vault item</a>` : ''}
        </div>
      </div>
      <div class="qv-section">
        <span class="qv-label">Items (${items.length})</span>
        <div class="qv-items-list">${itemsHtml}</div>
        <div style="margin-top:8px;">
          ${taxRow}
          ${savingsRow}
          <div class="qv-total-row"><span>Total paid</span><span>${formatTotal(r.total, r.currency)}</span></div>
          ${paymentNote}
        </div>
      </div>
      ${confHtml}
      ${warrantyHtml}
      ${notesHtml}
    `

    currentReceiptId = r.id
    document.getElementById('qv-delete-zone')!.style.display = 'block'
    document.getElementById('qv-delete-btn')!.style.display = 'block'
    document.getElementById('qv-delete-confirm')!.classList.remove('visible')
    document.getElementById('qv-overlay')!.classList.add('open')
    document.getElementById('qv-drawer')!.classList.add('open')

    // Wire lightbox — receipt scan + all item photos
    const lbImages: string[] = []
    if (r.image_key) lbImages.push(R2_CDN + '/' + r.image_key)
    photos.forEach((img: any) => lbImages.push(R2_CDN + '/' + img.image_key))

    const qvImg = document.querySelector('.qv-image') as HTMLImageElement | null
    if (qvImg) qvImg.addEventListener('click', () => { if ((window as any).__lbOpenSet) (window as any).__lbOpenSet(lbImages, 0) })

    // Wire photo thumbnails — open lightbox at correct index
    const strip = document.getElementById('qv-photo-strip')
    if (strip) {
      strip.querySelectorAll('.qv-photo-thumb').forEach((thumb: Element) => {
        const idx = parseInt((thumb as HTMLElement).dataset.idx || '0')
        thumb.querySelector('img')?.addEventListener('click', () => {
          if ((window as any).__lbOpenSet) (window as any).__lbOpenSet(lbImages, idx + (r.image_key ? 1 : 0))
        })
        thumb.querySelector('.qv-photo-delete')?.addEventListener('click', async (e: Event) => {
          e.stopPropagation()
          const imgId = (e.currentTarget as HTMLElement).dataset.imgId
          if (!imgId) return
          await supabase.from('receipt_images').delete().eq('id', imgId)
          const ri = allReceipts.findIndex((r: any) => r.id === currentReceiptId)
          if (ri > -1) allReceipts[ri].receipt_images = allReceipts[ri].receipt_images.filter((img: any) => img.id !== imgId)
          const updated = allReceipts.find((r: any) => r.id === currentReceiptId)
          if (updated) openDrawer(updated)
        })
      })
    }

    // Wire add photo button
    const addPhotoBtn = document.getElementById('qv-add-photo-btn')
    if (addPhotoBtn) {
      addPhotoBtn.addEventListener('click', () => {
        const input = document.getElementById('item-photo-input') as HTMLInputElement
        input.onchange = async () => {
          const file = input.files?.[0]
          if (!file || !currentReceiptId) return
          try {
            const stripped = await stripExif(file)
            const fd = new FormData()
            fd.append('file', stripped)
            const up = await fetch('/api/upload-url', { method: 'POST', body: fd })
            const upData = await up.json()
            if (upData.error) throw new Error(upData.error)
            const sortOrder = (allReceipts.find((r: any) => r.id === currentReceiptId)?.receipt_images?.length || 0)
            const { data: newImg } = await supabase.from('receipt_images')
              .insert({ receipt_id: currentReceiptId, image_key: upData.key, sort_order: sortOrder })
              .select().single()
            if (newImg) {
              const ri = allReceipts.findIndex((r: any) => r.id === currentReceiptId)
              if (ri > -1) allReceipts[ri].receipt_images = [...(allReceipts[ri].receipt_images || []), newImg]
              const updated = allReceipts.find((r: any) => r.id === currentReceiptId)
              if (updated) openDrawer(updated)
            }
          } catch (err) {
            console.error('Upload failed:', err)
          }
          input.value = ''
        }
        input.click()
      })
    }
  }

  function closeDrawer() {
    document.getElementById('qv-overlay')!.classList.remove('open')
    document.getElementById('qv-drawer')!.classList.remove('open')
  }

  document.getElementById('qv-close')!.addEventListener('click', closeDrawer)
  document.getElementById('qv-overlay')!.addEventListener('click', closeDrawer)

  // Delete
  document.getElementById('qv-delete-btn')!.addEventListener('click', () => {
    document.getElementById('qv-delete-btn')!.style.display = 'none'
    document.getElementById('qv-delete-confirm')!.classList.add('visible')
  })
  document.getElementById('qv-delete-no')!.addEventListener('click', () => {
    document.getElementById('qv-delete-btn')!.style.display = 'block'
    document.getElementById('qv-delete-confirm')!.classList.remove('visible')
  })
  document.getElementById('qv-delete-yes')!.addEventListener('click', async () => {
    if (!currentReceiptId) return
    const { error } = await supabase.from('receipts').delete().eq('id', currentReceiptId)
    if (!error) {
      allReceipts = allReceipts.filter(r => r.id !== currentReceiptId)
      document.getElementById('receipt-count')!.textContent =
        allReceipts.length + ' receipt' + (allReceipts.length !== 1 ? 's' : '')
      closeDrawer()
      applyFilters()
    }
  })

  // Search + date filter
  document.getElementById('receipt-search')!.addEventListener('input', applyFilters)
  document.getElementById('date-filter')!.addEventListener('change', applyFilters)

  // View toggle
  document.getElementById('btn-grid')!.addEventListener('click', () => {
    activeView = 'grid'
    document.getElementById('btn-grid')!.classList.add('active')
    document.getElementById('btn-list')!.classList.remove('active')
    applyFilters()
  })
  document.getElementById('btn-list')!.addEventListener('click', () => {
    activeView = 'list'
    document.getElementById('btn-list')!.classList.add('active')
    document.getElementById('btn-grid')!.classList.remove('active')
    applyFilters()
  })

  // Lightbox
  let lbImages: string[] = []
  let lbIndex = 0

  function openLightbox(src: string) {
    lbImages = [src]; lbIndex = 0
    const img = document.getElementById('lb-img') as HTMLImageElement
    img.src = src
    document.getElementById('lb-prev')!.style.display = 'none'
    document.getElementById('lb-next')!.style.display = 'none'
    document.getElementById('lb-overlay')!.classList.add('open')
  }

  function openLightboxSet(images: string[], index: number) {
    lbImages = images; lbIndex = index
    const img = document.getElementById('lb-img') as HTMLImageElement
    img.src = images[index]
    const showNav = images.length > 1
    document.getElementById('lb-prev')!.style.display = showNav ? 'flex' : 'none'
    document.getElementById('lb-next')!.style.display = showNav ? 'flex' : 'none'
    document.getElementById('lb-overlay')!.classList.add('open')
  }

  document.getElementById('lb-prev')!.addEventListener('click', (e) => {
    e.stopPropagation()
    lbIndex = (lbIndex - 1 + lbImages.length) % lbImages.length
    ;(document.getElementById('lb-img') as HTMLImageElement).src = lbImages[lbIndex]
  })
  document.getElementById('lb-next')!.addEventListener('click', (e) => {
    e.stopPropagation()
    lbIndex = (lbIndex + 1) % lbImages.length
    ;(document.getElementById('lb-img') as HTMLImageElement).src = lbImages[lbIndex]
  })
  function closeLightbox() {
    document.getElementById('lb-overlay')!.classList.remove('open')
  }
  document.getElementById('lb-overlay')!.addEventListener('click', closeLightbox)
  document.getElementById('lb-close')!.addEventListener('click', (e) => { e.stopPropagation(); closeLightbox(); })

  // Expose so openDrawer can wire it up
  ;(window as any).__lbOpen = openLightbox
  ;(window as any).__lbOpenSet = openLightboxSet

  // ── Load receipts ─────────────────────────────────────────
  function stripExif(file: File): Promise<File> {
    return new Promise((resolve, reject) => {
      const img = new Image()
      const url = URL.createObjectURL(file)
      img.onload = () => {
        const canvas = document.createElement('canvas')
        canvas.width = img.naturalWidth; canvas.height = img.naturalHeight
        const ctx = canvas.getContext('2d')
        if (!ctx) { reject(new Error('Canvas unavailable')); return }
        ctx.drawImage(img, 0, 0)
        canvas.toBlob(blob => {
          URL.revokeObjectURL(url)
          if (!blob) { reject(new Error('toBlob failed')); return }
          resolve(new File([blob], file.name, { type: 'image/jpeg', lastModified: Date.now() }))
        }, 'image/jpeg', 0.92)
      }
      img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('Image load failed')) }
      img.src = url
    })
  }

  async function init() {
    const { data: { session } } = await supabase.auth.getSession()
    if (!session) {
      window.location.href = 'https://gaukauth.com?from=gaukantiques.com&next=/receipts'
      return
    }

    const { data, error } = await supabase
      .from('receipts')
      .select('id, merchant, date, total, currency, category, confidence, warranty_years, warranty_expiry, receipt_number, notes, image_key, result_json, identification_id, created_at')
      .eq('user_id', session.user.id)
      .order('created_at', { ascending: false })

    document.getElementById('loading-state')!.style.display = 'none'

    if (error || !data) {
      document.getElementById('empty-state')!.style.display = 'flex'
      return
    }

    // Fetch line items for all receipts in one query
    const ids = data.map((r: any) => r.id)
    let lineItemMap: Record<string, any[]> = {}
    if (ids.length) {
      const { data: lines } = await supabase
        .from('receipt_line_items')
        .select('receipt_id, description, amount')
        .in('receipt_id', ids)
      if (lines) {
        lines.forEach((l: any) => {
          if (!lineItemMap[l.receipt_id]) lineItemMap[l.receipt_id] = []
          lineItemMap[l.receipt_id].push(l)
        })
      }
    }

    // Fetch item photos for all receipts
    let receiptImagesMap: Record<string, any[]> = {}
    if (ids.length) {
      const { data: rimgs } = await supabase
        .from('receipt_images')
        .select('receipt_id, id, image_key, sort_order')
        .in('receipt_id', ids)
        .order('sort_order', { ascending: true })
      if (rimgs) {
        rimgs.forEach((img: any) => {
          if (!receiptImagesMap[img.receipt_id]) receiptImagesMap[img.receipt_id] = []
          receiptImagesMap[img.receipt_id].push(img)
        })
      }
    }

    allReceipts = data.map((r: any) => ({
      ...r,
      line_items: lineItemMap[r.id] || [],
      // Rich item data from result_json
      rj_items:        r.result_json?.items        || [],
      rj_tax_amount:   r.result_json?.tax_amount   ?? null,
      rj_tax_label:    r.result_json?.tax_label     || null,
      rj_savings:      r.result_json?.savings_total ?? null,
      rj_merchant_branch: r.result_json?.merchant_branch || null,
      rj_merchant_gst: r.result_json?.merchant_gst_no   || null,
      rj_time:         r.result_json?.time          || null,
      rj_payment:      r.result_json?.payment_method || null,
      identification_id: r.identification_id || null,
      receipt_images: receiptImagesMap[r.id] || [],
    }))

    document.getElementById('receipt-count')!.textContent =
      allReceipts.length + ' receipt' + (allReceipts.length !== 1 ? 's' : '')

    buildFilters(allReceipts)
    renderReceipts(allReceipts)
  }

  init().then(() => {
    const urlReceipt = new URLSearchParams(window.location.search).get('receipt')
    if (urlReceipt) {
      const target = allReceipts.find((r: any) => r.id === urlReceipt)
      if (target) openDrawer(target)
    }
  })
</script>
