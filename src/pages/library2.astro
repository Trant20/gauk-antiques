---
import AppShell from '../layouts/AppShell.astro'
import { R2_CDN, GI_SITE_ID, ANTIQUES_SITE_ID } from '../lib/constants'
---
<AppShell title="The Vault — GAUK">

<style>
  /* ── PAGE LAYOUT ── */
  .vault-wrap {
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
    background: var(--shell);
  }

  /* ── TOPBAR ── */
  .vault-topbar {
    height: 52px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    padding: 0 24px;
    gap: 14px;
    flex-shrink: 0;
    z-index: 40;
  }

  .vault-search-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    max-width: 320px;
    background: var(--surface-hi);
    border: 1px solid var(--border-hi);
    padding: 0 11px;
    height: 32px;
  }
  .vault-search-wrap svg { flex-shrink: 0; opacity: 0.28; }
  .vault-search {
    background: transparent;
    border: none;
    outline: none;
    color: var(--text);
    font-family: var(--font-ui);
    font-size: 13px;
    width: 100%;
  }
  .vault-search::placeholder { color: var(--text-faint); }

  .vault-spacer { flex: 1; }

  .vault-sort-label {
    font-family: var(--font-ui);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-mute);
    font-weight: 600;
    white-space: nowrap;
  }
  .vault-sort {
    height: 32px;
    padding: 0 10px;
    border: 1px solid var(--border-hi);
    background: var(--surface-hi);
    color: var(--text-mute);
    font-family: var(--font-ui);
    font-size: 12px;
    outline: none;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
  }
  .vault-sort option { background: var(--surface); color: var(--text-dim); }

  .vault-view-toggle {
    display: flex;
    border: 1px solid var(--border-hi);
    overflow: hidden;
    flex-shrink: 0;
  }
  .vault-view-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--text-faint);
    transition: background 0.1s, color 0.1s;
  }
  .vault-view-btn:first-child { border-right: 1px solid var(--border-hi); }
  .vault-view-btn.active { background: rgba(255,255,255,0.06); color: var(--text-dim); }

  /* ── STATS BAR ── */
  .vault-stats {
    padding: 10px 24px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    background: var(--surface-lo);
  }
  .vault-stats-left {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--text-mute);
  }
  .vault-stats-left strong { color: var(--text-dim); font-weight: 500; }
  .vault-stats-right {
    display: flex;
    gap: 20px;
  }
  .vault-stats-gi { font-family: var(--font-ui); font-size: 12px; color: var(--text-mute); }
  .vault-stats-gi strong { color: var(--gi-sage); font-weight: 500; }
  .vault-stats-ga { font-family: var(--font-ui); font-size: 12px; color: var(--text-mute); }
  .vault-stats-ga strong { color: var(--ga-gold-hi); font-weight: 500; }

  /* ── SCROLL AREA ── */
  .vault-scroll {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
  }

  /* ── GRID ── */
  .vault-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(272px, 1fr));
    gap: 20px;
  }

  /* ── LIST ── */
  .vault-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }

  /* ── CARD ── */
  .vault-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border-hi);
    cursor: pointer;
    transition: border-color 0.15s;
    animation: fadeUp 0.22s ease forwards;
    overflow: hidden;
    position: relative;
    text-decoration: none;
    color: inherit;
  }
  .vault-card:hover { border-color: #363636; }
  .vault-card:hover .card-actions { opacity: 1; }

  /* Card thumb */
  .card-thumb {
    height: 164px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    position: relative;
  }
  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .card-thumb-ltr {
    font-family: var(--font-display);
    font-size: 72px;
    font-weight: 400;
    opacity: 0.22;
    line-height: 1;
    user-select: none;
    pointer-events: none;
  }

  /* Card body */
  .card-body {
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }
  .card-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 7px;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    border: 1px solid;
    align-self: flex-start;
    margin-bottom: 10px;
  }
  .card-badge-gi {
    color: var(--gi-sage);
    background: rgba(124,144,130,0.07);
    border-color: rgba(124,144,130,0.18);
  }
  .card-badge-ga {
    color: var(--ga-gold-hi);
    background: rgba(200,149,46,0.07);
    border-color: rgba(200,149,46,0.18);
  }
  .card-title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
    color: var(--text);
    line-height: 1.3;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    flex: 1;
  }
  .card-value-row {
    margin-top: 14px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
  }
  .card-value-label {
    font-family: var(--font-ui);
    font-size: 11px;
    color: var(--text-mute);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    margin-bottom: 3px;
    white-space: nowrap;
  }
  .card-value {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 500;
    color: var(--text-dim);
    letter-spacing: 0.01em;
  }
  .card-date {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--text-mute);
    flex-shrink: 0;
    text-align: right;
  }

  /* Card hover actions */
  .card-actions {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    gap: 1px;
    background: var(--border);
    opacity: 0;
    transition: opacity 0.15s;
  }
  .card-action-btn {
    flex: 1;
    padding: 9px 6px;
    background: var(--surface-lo);
    border: none;
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
    cursor: pointer;
    transition: background 0.1s, color 0.1s;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .card-action-btn:hover { background: var(--surface-hi); color: var(--text); }
  .card-action-btn.danger:hover { color: #c46028; }

  /* ── LIST CARD ── */
  .vault-list .vault-card {
    flex-direction: row;
    height: 66px;
    border: none;
    border-bottom: 1px solid var(--border);
    animation: none;
    border-left-width: 3px;
    border-left-style: solid;
  }
  .vault-list .vault-card:hover { background: rgba(255,255,255,0.018); }
  .vault-list .card-thumb {
    width: 66px !important;
    min-width: 66px !important;
    height: 66px !important;
  }
  .vault-list .card-body {
    flex-direction: row;
    align-items: center;
    padding: 0 20px;
    gap: 20px;
  }
  .vault-list .card-badge { display: none; }
  .vault-list .card-title { font-size: 15px; -webkit-line-clamp: 1; }
  .vault-list .card-value-row { margin-top: 0; }
  .vault-list .card-actions { display: none; }

  .list-cat {
    display: none;
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--text-mute);
    white-space: nowrap;
    flex-shrink: 0;
    min-width: 120px;
  }
  .vault-list .list-cat { display: block; }
  .list-title-wrap { flex: 1; min-width: 0; }

  /* ── STATES ── */
  .vault-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 420px;
    gap: 20px;
    text-align: center;
  }
  .vault-state-icon {
    width: 44px;
    height: 44px;
    border: 1px solid var(--border-hi);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .vault-state-title {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 400;
    color: var(--text-mute);
    margin-bottom: 8px;
  }
  .vault-state-sub {
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--text-mute);
    line-height: 1.5;
  }
  .vault-state-btn {
    padding: 10px 22px;
    background: var(--gi-sage);
    color: #fff;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    cursor: pointer;
    border: none;
    text-decoration: none;
    display: inline-block;
  }

  /* ── SHIMMER ── */
  .shimmer {
    background: linear-gradient(90deg, var(--surface) 25%, var(--surface-hi) 50%, var(--surface) 75%);
    background-size: 400px 100%;
    animation: shimmer 1.4s ease-in-out infinite;
  }
  .shimmer-card { background: var(--surface); border: 1px solid var(--border-hi); }
  .shimmer-thumb { height: 164px; }
  .shimmer-line { height: 10px; border-radius: var(--radius); margin: 12px 14px 4px; }
  .shimmer-line-short { height: 10px; border-radius: var(--radius); margin: 4px 14px 14px; width: 55%; }

  /* ── DELETE MODAL ── */
  .del-overlay {
    position: fixed;
    inset: 0;
    z-index: 500;
    background: rgba(0,0,0,0.65);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .del-modal {
    background: var(--surface);
    border: 1px solid var(--border-hi);
    padding: 32px 24px;
    max-width: 320px;
    width: 100%;
    text-align: center;
  }
  .del-modal-title {
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--text);
    margin-bottom: 10px;
  }
  .del-modal-sub {
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--text-mute);
    line-height: 1.7;
    margin-bottom: 24px;
  }
  .del-modal-btns { display: flex; gap: 8px; }
  .del-cancel {
    flex: 1;
    padding: 12px;
    background: none;
    border: 1px solid var(--border-hi);
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
    cursor: pointer;
  }
  .del-confirm {
    flex: 1;
    padding: 12px;
    background: #c46028;
    border: none;
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    cursor: pointer;
  }

  /* ── MOBILE ── */
  @media (max-width: 768px) {
    .vault-topbar { padding: 0 16px; gap: 10px; }
    .vault-sort-label { display: none; }
    .vault-stats { display: none; }
    .vault-scroll { padding: 16px; }
    .vault-grid { grid-template-columns: 1fr; }
    .card-actions { opacity: 1; }
  }
</style>

<div class="vault-wrap">

  <!-- TOPBAR -->
  <div class="vault-topbar">
    <div class="vault-search-wrap">
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
        <circle cx="5" cy="5" r="4" stroke="currentColor" stroke-width="1.6"/>
        <path d="M8.2 8.2L11 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
      <input class="vault-search" id="vault-search" placeholder="Search items…" />
    </div>

    <div class="vault-spacer"></div>

    <span class="vault-sort-label">Sort by</span>
    <select class="vault-sort" id="vault-sort">
      <option value="newest">Newest first</option>
      <option value="oldest">Oldest first</option>
      <option value="value-high">Value: high → low</option>
      <option value="value-low">Value: low → high</option>
      <option value="az">Name A–Z</option>
    </select>

    <div class="vault-view-toggle">
      <button class="vault-view-btn active" id="btn-grid" title="Grid view">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
          <rect x="0.5" y="0.5" width="4.5" height="4.5" stroke="currentColor" stroke-width="1.3"/>
          <rect x="7" y="0.5" width="4.5" height="4.5" stroke="currentColor" stroke-width="1.3"/>
          <rect x="0.5" y="7" width="4.5" height="4.5" stroke="currentColor" stroke-width="1.3"/>
          <rect x="7" y="7" width="4.5" height="4.5" stroke="currentColor" stroke-width="1.3"/>
        </svg>
      </button>
      <button class="vault-view-btn" id="btn-list" title="List view">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
          <line x1="0" y1="2" x2="12" y2="2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          <line x1="0" y1="6" x2="12" y2="6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          <line x1="0" y1="10" x2="12" y2="10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- STATS BAR -->
  <div class="vault-stats" id="vault-stats">
    <span class="vault-stats-left">
      <strong id="stats-count">—</strong> items
      <span style="margin:0 8px;color:var(--border-hi);">·</span>
      est. total <strong id="stats-total">—</strong>
    </span>
    <div class="vault-stats-right">
      <span class="vault-stats-gi"><strong id="stats-gi">—</strong> insured</span>
      <span class="vault-stats-ga"><strong id="stats-ga">—</strong> catalogued</span>
    </div>
  </div>

  <!-- CONTENT -->
  <div class="vault-scroll" id="vault-scroll">

    <!-- Loading shimmer -->
    <div id="vault-loading" class="vault-grid" id="shimmer-grid"></div>

    <!-- Auth gate -->
    <div id="vault-auth-gate" class="vault-state hidden">
      <div class="vault-state-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </div>
      <div>
        <div class="vault-state-title">Sign in to view your Vault</div>
        <div class="vault-state-sub">Your identification history is saved to your account.</div>
      </div>
      <a href="/auth" class="vault-state-btn">Sign In</a>
    </div>

    <!-- Empty state -->
    <div id="vault-empty" class="vault-state hidden">
      <div class="vault-state-icon">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <rect x="1.5" y="1.5" width="6" height="6" stroke="currentColor" stroke-width="1.5"/>
          <rect x="10.5" y="1.5" width="6" height="6" stroke="currentColor" stroke-width="1.5"/>
          <rect x="1.5" y="10.5" width="6" height="6" stroke="currentColor" stroke-width="1.5"/>
          <rect x="10.5" y="10.5" width="6" height="6" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </div>
      <div>
        <div class="vault-state-title">Your inventory is empty</div>
        <div class="vault-state-sub">Start by scanning your first item.</div>
      </div>
      <a href="/identify" class="vault-state-btn">Scan an item</a>
    </div>

    <!-- Cards container -->
    <div id="vault-cards" class="vault-grid hidden"></div>

    <!-- Load more -->
    <div style="padding:24px;text-align:center;">
      <button id="vault-load-more" style="display:none;padding:10px 28px;background:transparent;border:1px solid var(--border-hi);font-family:var(--font-ui);font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-mute);cursor:pointer;">Load more</button>
    </div>

  </div>
</div>

<!-- DELETE MODAL -->
<div class="del-overlay hidden" id="del-overlay">
  <div class="del-modal">
    <div class="del-modal-title">Delete this item?</div>
    <div class="del-modal-sub">This will permanently remove it from your Vault.</div>
    <div class="del-modal-btns">
      <button class="del-cancel" id="del-cancel">Cancel</button>
      <button class="del-confirm" id="del-confirm">Delete</button>
    </div>
  </div>
</div>

<script>
  import { supabase } from '../lib/supabase-browser'
  import { escapeHtml } from '../lib/utils'
  import { formatValueRange, formatGIValueRange } from '../lib/currency'
  import { GI_SITE_ID, ANTIQUES_SITE_ID, R2_CDN } from '../lib/constants'

  const BATCH = 24
  let offset = 0
  let totalCount = 0
  let allItems: any[] = []
  let filteredItems: any[] = []
  let activeProperty = 'all'
  let activeSort = 'newest'
  let searchQuery = ''
  let viewMode = 'grid'
  let pendingDeleteId: string | null = null

  // Elements
  const elLoading   = document.getElementById('vault-loading')!
  const elAuthGate  = document.getElementById('vault-auth-gate')!
  const elEmpty     = document.getElementById('vault-empty')!
  const elCards     = document.getElementById('vault-cards')!
  const elScroll    = document.getElementById('vault-scroll')!
  const btnGrid     = document.getElementById('btn-grid')!
  const btnList     = document.getElementById('btn-list')!
  const elSearch    = document.getElementById('vault-search') as HTMLInputElement
  const elSort      = document.getElementById('vault-sort') as HTMLSelectElement
  const loadMoreBtn = document.getElementById('vault-load-more')!
  const delOverlay  = document.getElementById('del-overlay')!
  const delConfirm  = document.getElementById('del-confirm')!
  const delCancel   = document.getElementById('del-cancel')!

  // Shimmer
  elLoading.innerHTML = Array(6).fill(0).map(() => `
    <div class="shimmer-card">
      <div class="shimmer-thumb shimmer"></div>
      <div class="shimmer-line shimmer"></div>
      <div class="shimmer-line-short shimmer"></div>
    </div>
  `).join('')

  // Helpers
  function fmt(v: number) { return '£' + Math.round(v).toLocaleString('en-GB') }

  function formatValue(r: any, siteId: string) {
    if (siteId === GI_SITE_ID) return formatGIValueRange(r.value_range_low || 0, r.value_range_high || 0, r.currency || 'USD')
    return formatValueRange(r.value_range_low || 0, r.value_range_high || 0)
  }

  function fmtDate(iso: string) {
    return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
  }

  function isGI(item: any) { return item.site_id === GI_SITE_ID }

  function thumbHtml(imageKey: string, alt: string, isGIItem: boolean) {
    const bg = isGIItem ? 'rgba(124,144,130,0.07)' : 'rgba(122,92,32,0.07)'
    const color = isGIItem ? 'var(--gi-sage)' : 'var(--ga-gold)'
    const letter = escapeHtml((alt || 'I')[0])
    if (imageKey) {
      return `<div class="card-thumb" style="background:${bg};">
        <img src="${R2_CDN}/${imageKey}" alt="${escapeHtml(alt)}" loading="lazy" style="width:100%;height:100%;object-fit:cover;" />
      </div>`
    }
    return `<div class="card-thumb" style="background:${bg};">
      <span class="card-thumb-ltr" style="color:${color};">${letter}</span>
    </div>`
  }

  function cardHtml(item: any) {
    const r = item.result_json || {}
    const title = escapeHtml(r.subcategory || r.title || 'Unidentified Item')
    const category = escapeHtml(r.category || 'Uncategorised')
    const gi = isGI(item)
    const borderColor = gi ? 'var(--gi-sage)' : 'var(--ga-gold)'
    const badgeClass = gi ? 'card-badge-gi' : 'card-badge-ga'
    const valueLabel = gi ? 'Est. Replacement Cost' : 'Valuation'
    const value = formatValue(r, item.site_id)
    const date = fmtDate(item.created_at)

    return `<div class="vault-card" style="border-left:3px solid ${borderColor};" data-id="${item.id}">
      ${thumbHtml(item.image_key, r.subcategory || r.title || 'Item', gi)}
      <div class="card-body">
        <div class="card-badge ${badgeClass}">${category}</div>
        <div class="list-cat">${category}</div>
        <div class="list-title-wrap">
          <div class="card-title">${title}</div>
        </div>
        <div class="card-value-row">
          <div>
            <div class="card-value-label">${valueLabel}</div>
            <div class="card-value">${value}</div>
          </div>
          <div class="card-date">${date}</div>
        </div>
      </div>
      <div class="card-actions">
        <a href="/valuation/${item.id}" class="card-action-btn">View</a>
        <button class="card-action-btn" data-quickview="${item.id}">Quick View</button>
        <button class="card-action-btn danger" data-delete="${item.id}">Delete</button>
      </div>
    </div>`
  }

  function applyFilters() {
    let result = [...allItems]

    // Property filter
    if (activeProperty === 'insurance') result = result.filter(i => isGI(i))
    if (activeProperty === 'antiques')  result = result.filter(i => !isGI(i))

    // Search
    if (searchQuery) {
      const q = searchQuery.toLowerCase()
      result = result.filter(i => {
        const r = i.result_json || {}
        return (r.subcategory || r.title || '').toLowerCase().includes(q) ||
               (r.category || '').toLowerCase().includes(q)
      })
    }

    // Sort
    result = result.sort((a, b) => {
      const ra = a.result_json || {}, rb = b.result_json || {}
      if (activeSort === 'newest')     return new Date(b.created_at).getTime() - new Date(a.created_at).getTime()
      if (activeSort === 'oldest')     return new Date(a.created_at).getTime() - new Date(b.created_at).getTime()
      if (activeSort === 'value-high') return (rb.value_range_high || 0) - (ra.value_range_high || 0)
      if (activeSort === 'value-low')  return (ra.value_range_low || 0) - (rb.value_range_low || 0)
      if (activeSort === 'az')         return (ra.subcategory || ra.title || '').localeCompare(rb.subcategory || rb.title || '')
      return 0
    })

    filteredItems = result
    render()
  }

  function render() {
    if (filteredItems.length === 0) {
      elCards.classList.add('hidden')
      elEmpty.classList.remove('hidden')
      return
    }
    elEmpty.classList.add('hidden')
    elCards.classList.remove('hidden')
    elCards.innerHTML = filteredItems.map(cardHtml).join('')
    bindCardActions()
  }

  function updateStats() {
    const giItems  = allItems.filter(i => isGI(i))
    const gaItems  = allItems.filter(i => !isGI(i))
    const total    = filteredItems.reduce((s, i) => {
      const r = i.result_json || {}
      return s + ((r.value_range_low || 0) + (r.value_range_high || 0)) / 2
    }, 0)

    document.getElementById('stats-count')!.textContent = String(filteredItems.length)
    document.getElementById('stats-total')!.textContent = fmt(total)
    document.getElementById('stats-gi')!.textContent    = String(giItems.length)
    document.getElementById('stats-ga')!.textContent    = String(gaItems.length)

    // Dispatch counts to SideNav
    window.dispatchEvent(new CustomEvent('vault:counts', {
      detail: { total: allItems.length, insurance: giItems.length, antiques: gaItems.length }
    }))
  }

  function bindCardActions() {
    // Quick view
    elCards.querySelectorAll('[data-quickview]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault()
        e.stopPropagation()
        const id = (btn as HTMLElement).dataset.quickview!
        window.dispatchEvent(new CustomEvent('vault:quickview', { detail: { id } }))
      })
    })

    // Delete
    elCards.querySelectorAll('[data-delete]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault()
        e.stopPropagation()
        pendingDeleteId = (btn as HTMLElement).dataset.delete!
        delOverlay.classList.remove('hidden')
      })
    })
  }

  // View toggle
  btnGrid.addEventListener('click', () => {
    viewMode = 'grid'
    btnGrid.classList.add('active'); btnList.classList.remove('active')
    elCards.className = elCards.className.replace('vault-list', 'vault-grid')
    if (!elCards.classList.contains('vault-grid')) elCards.classList.add('vault-grid')
  })
  btnList.addEventListener('click', () => {
    viewMode = 'list'
    btnList.classList.add('active'); btnGrid.classList.remove('active')
    elCards.className = elCards.className.replace('vault-grid', 'vault-list')
    if (!elCards.classList.contains('vault-list')) elCards.classList.add('vault-list')
  })

  // Search
  elSearch.addEventListener('input', () => {
    searchQuery = elSearch.value.trim()
    applyFilters()
    updateStats()
  })

  // Sort
  elSort.addEventListener('change', () => {
    activeSort = elSort.value
    applyFilters()
  })

  // Property filter from SideNav
  window.addEventListener('vault:filter', (e: Event) => {
    activeProperty = (e as CustomEvent).detail.property
    applyFilters()
    updateStats()
  })

  // Delete modal
  delCancel.addEventListener('click', () => {
    delOverlay.classList.add('hidden')
    pendingDeleteId = null
  })
  delConfirm.addEventListener('click', async () => {
    if (!pendingDeleteId) return
    delConfirm.textContent = 'Deleting…'
    ;(delConfirm as HTMLButtonElement).disabled = true
    const { data: { session } } = await supabase.auth.getSession()
    if (!session) { window.location.href = '/auth'; return }
    await supabase.from('identifications').delete().eq('id', pendingDeleteId).eq('user_id', session.user.id)
    allItems = allItems.filter(i => i.id !== pendingDeleteId)
    pendingDeleteId = null
    delOverlay.classList.add('hidden')
    delConfirm.textContent = 'Delete'
    ;(delConfirm as HTMLButtonElement).disabled = false
    applyFilters()
    updateStats()
  })

  // Load more
  loadMoreBtn.addEventListener('click', async () => {
    loadMoreBtn.textContent = 'Loading…'
    ;(loadMoreBtn as HTMLButtonElement).disabled = true
    const { data: { session } } = await supabase.auth.getSession()
    if (!session) return
    const { data: more } = await supabase
      .from('identifications')
      .select('id, site_id, image_key, result_json, created_at, value_range_low, value_range_high')
      .eq('user_id', session.user.id)
      .order('created_at', { ascending: false })
      .range(offset, offset + BATCH - 1)
    if (more && more.length > 0) {
      allItems = [...allItems, ...more]
      offset += more.length
      applyFilters()
      updateStats()
      updateLoadMore()
    }
  })

  function updateLoadMore() {
    if (offset >= totalCount) {
      loadMoreBtn.style.display = 'none'
    } else {
      loadMoreBtn.textContent = 'Load more'
      ;(loadMoreBtn as HTMLButtonElement).disabled = false
      loadMoreBtn.style.display = 'inline-block'
    }
  }

  // ── INIT ──
  const { data: { session } } = await supabase.auth.getSession()

  if (!session) {
    elLoading.classList.add('hidden')
    elAuthGate.classList.remove('hidden')
  } else {
    // Get total count
    const { count } = await supabase
      .from('identifications')
      .select('*', { count: 'exact', head: true })
      .eq('user_id', session.user.id)
    totalCount = count || 0

    // Fetch first batch
    const { data, error } = await supabase
      .from('identifications')
      .select('id, site_id, image_key, result_json, created_at, value_range_low, value_range_high')
      .eq('user_id', session.user.id)
      .order('created_at', { ascending: false })
      .range(0, BATCH - 1)

    elLoading.classList.add('hidden')

    if (error || !data || data.length === 0) {
      elEmpty.classList.remove('hidden')
    } else {
      allItems = data
      offset = data.length
      applyFilters()
      updateStats()
      updateLoadMore()
    }
  }
</script>

</AppShell>
