---
interface Props {
  currentProperty: 'ga' | 'gi' | 'mb' | 'gr'
}
const { currentProperty } = Astro.props

const properties = [
  {
    id: 'ga',
    name: 'GAUK Antiques',
    domain: 'gaukantiques.com',
    next: '/library',
    color: '#c8952e',
  },
  {
    id: 'gi',
    name: 'GAUK Insurance',
    domain: 'gaukantiques.com',
    next: '/audit',
    color: '#7c9082',
  },
  {
    id: 'gr',
    name: 'GAUK Receipts',
    domain: 'gaukantiques.com',
    next: '/receipts',
    color: '#3a8197',
  },
  {
    id: 'mb',
    name: 'MotorBuzz',
    domain: 'gaukmotorbuzz.com',
    next: '/man-cave',
    color: '#FF8000',
  },
]

const current = properties.find(p => p.id === currentProperty)!
---

<div class="ps-wrap">
  <button class="ps-current" id="ps-toggle" aria-label="Switch property">
    <span class="ps-dot" style={`background:${current.color}`}></span>
    <span class="ps-name">{current.name}</span>
    <svg class="ps-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none">
      <path d="M2 4l3 3 3-3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    </svg>
  </button>
  <div class="ps-panel" id="ps-panel">
    {properties.map(p => (
      p.id === currentProperty ? (
        <div class="ps-tile ps-tile-active" style={`--pc:${p.color}`}>
          <span class="ps-dot" style={`background:${p.color}`}></span>
          <span>{p.name}</span>
        </div>
      ) : (
        <a
          href={`https://gaukauth.com?from=${p.domain}&next=${p.next}`}
          class="ps-tile"
          style={`--pc:${p.color}`}
        >
          <span class="ps-dot" style={`background:${p.color}`}></span>
          <span>{p.name}</span>
        </a>
      )
    ))}
  </div>
</div>

<style is:global>
  .ps-wrap { position: relative; }
  .ps-current {
    display: flex; align-items: center; gap: 8px; width: 100%;
    background: none; border: none; padding: 0;
    font-family: var(--font-ui); font-size: 12px; font-weight: 600;
    color: var(--text-dim); cursor: pointer; text-align: left;
    transition: color 0.15s;
  }
  .ps-current:hover { color: var(--text); }
  .ps-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
  .ps-name { flex: 1; }
  .ps-chevron { color: var(--text-mute); flex-shrink: 0; transition: transform 0.2s; }
  .ps-panel {
    display: none; position: absolute; top: calc(100% + 8px);
    left: -18px; right: -18px;
    background: var(--surface-hi); border: 1px solid var(--border-hi);
    z-index: 200; padding: 4px;
  }
  .ps-panel.open { display: block; }
  .ps-tile {
    display: flex; align-items: center; gap: 8px;
    padding: 9px 12px; font-family: var(--font-ui); font-size: 12px;
    color: var(--text-mute); text-decoration: none;
    transition: background 0.12s, color 0.12s; cursor: pointer;
  }
  .ps-tile:hover { background: var(--surface); color: var(--text); }
  .ps-tile-active { color: var(--pc, var(--text)); cursor: default; font-weight: 600; }
</style>

<script>
  const toggle = document.getElementById('ps-toggle')
  const panel  = document.getElementById('ps-panel')
  const chevron = toggle?.querySelector('.ps-chevron') as SVGElement | null

  toggle?.addEventListener('click', () => {
    const open = panel?.classList.toggle('open')
    if (chevron) chevron.style.transform = open ? 'rotate(180deg)' : ''
  })

  document.addEventListener('click', (e) => {
    if (!toggle?.contains(e.target as Node) && !panel?.contains(e.target as Node)) {
      panel?.classList.remove('open')
      if (chevron) chevron.style.transform = ''
    }
  })
</script>
