---
import { R2_CDN, ANTIQUES_SITE_ID } from '../lib/constants'
import { formatPriceRange, formatPrice } from '../lib/currency'
import GAEnrichGate from './GAEnrichGate.astro'
import GAEnrichmentSections from './GAEnrichmentSections.astro'
import { supabase } from '../lib/supabase'

interface Props {
  item: any
  currency?: string
}

const { item, currency = 'GBP' } = Astro.props
const r = item.result_json || {}
const imageUrl = item.image_key ? `${R2_CDN}/${item.image_key}` : null
// currency comes from user_settings via Astro.locals — passed as prop
const confidenceScore = r.confidence === 'High' ? 94 : r.confidence === 'Medium' ? 72 : 45
const confCircumference = 2 * Math.PI * 20
const confOffset = confCircumference - (confCircumference * confidenceScore / 100)
const valueDisplay = formatPriceRange(r.value_range_low || 0, r.value_range_high || 0, currency)
const userValue = item.user_value ?? null
const userValueDisplay = userValue ? formatPrice(userValue, currency) : null
const valueLow = formatPrice(r.value_range_low || 0, currency)
const valueHigh = formatPrice(r.value_range_high || 0, currency)
const date = new Date(item.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })

// For is_antique items — fetch GA enrichment cost and enrichment data
let creditCostEnrich = 5
let gaEnrichment: any = null
if (r.is_antique) {
  const { data: costSetting } = await supabase
    .from('site_settings')
    .select('value')
    .eq('site_id', ANTIQUES_SITE_ID)
    .eq('key', 'credit_cost_enrich')
    .single()
  creditCostEnrich = parseInt(costSetting?.value ?? '5', 10)

  // Check if this item already has enrichment
  if (item.enrichment_json) {
    gaEnrichment = item.enrichment_json
  }
}
const retailPrices: any[] = item.retail_prices || []
const hasRetail = retailPrices.length > 0
const retailLow = hasRetail ? Math.min(...retailPrices.map((r: any) => r.extracted_price).filter((p: any) => p > 0)) : null
const retailHigh = hasRetail ? Math.max(...retailPrices.map((r: any) => r.extracted_price).filter((p: any) => p > 0)) : null
const retailSources = hasRetail ? [...new Set(retailPrices.map((r: any) => r.source).filter(Boolean))].slice(0, 3) : []
---

<style is:global>
  .gi-card {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 32px 24px 80px;
  }

  /* ── IMAGE ── */
  .gi-image-wrap {
    position: relative;
    width: 100%;
    border-left: 3px solid var(--gi-sage);
    background: var(--surface);
    margin-bottom: 24px;
  }
  .gi-image {
    width: 100%;
    max-height: 380px;
    object-fit: contain;
    background: var(--surface);
    display: block;
  }
  .gi-image-placeholder {
    width: 100%;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
  }
  .gi-image-placeholder-icon { color: var(--text-faint); }

  .gi-conf-arc {
    position: absolute;
    bottom: 14px;
    right: 14px;
    z-index: 10;
  }
  .gi-conf-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-ui);
    font-size: 9px;
    font-weight: 600;
    color: var(--gi-sage);
  }

  /* ── BADGE + TITLE ── */
  .gi-badge {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--gi-sage);
    border: 1px solid var(--gi-sage);
    padding: 3px 10px;
    margin-bottom: 12px;
  }
  .gi-title {
    font-family: var(--font-display);
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 400;
    font-style: italic;
    color: var(--text);
    line-height: 1.2;
    margin-bottom: 6px;
  }
  .gi-date {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--text-mute);
    letter-spacing: 0.05em;
    margin-bottom: 24px;
  }

  /* ── VALUE BLOCK ── */
  .gi-value-block {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--gi-sage);
    padding: 28px 24px;
    margin-bottom: 24px;
  }
  .gi-value-cap {
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gi-sage);
    margin-bottom: 12px;
    text-align: center;
  }
  .gi-value-amount {
    font-family: var(--font-ui);
    font-size: clamp(28px, 6vw, 42px);
    font-weight: 600;
    color: var(--gi-sage);
    letter-spacing: -1px;
    text-align: center;
    margin-bottom: 6px;
  }
  .gi-value-note {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--text-mute);
    text-align: center;
    margin-bottom: 20px;
  }
  .gi-value-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--border);
    margin-top: 16px;
  }
  .gi-value-strip-cell {
    background: var(--surface-hi);
    padding: 14px 8px;
    text-align: center;
  }
  .gi-value-strip-label {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
    margin-bottom: 6px;
  }
  .gi-value-strip-val {
    font-family: var(--font-ui);
    font-size: 20px;
    font-weight: 500;
    color: var(--text);
  }

  /* ── EDIT VALUE ── */
  .gi-edit-wrap {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .gi-edit-label {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
    margin-bottom: 8px;
  }

  /* ── RETAIL PRICES ── */
  .gi-retail-block {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .gi-retail-cap {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.08em;
