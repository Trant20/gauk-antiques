  }
  .gi-enrich-gate-btn:hover { opacity: 0.85; }
  .gi-enrich-gate-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .gi-enrich-loading-text {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gi-sage);
    display: none;
    margin-top: 12px;
    animation: pulse 1.5s ease-in-out infinite;
  }
  .gi-enrich-saved {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--gi-sage);
    display: none;
    margin-top: 10px;
  }

  /* ── RETAIL CARDS ── */
  .gi-retail-section { padding: 24px 0; border-bottom: 1px solid var(--border); }
  .gi-retail-section-head { margin-bottom: 16px; padding-left: 12px; border-left: 2px solid var(--gi-sage); }
  .gi-retail-section-title { font-family: var(--font-ui); font-size: 11px; letter-spacing: 0.16em; font-weight: 700; color: var(--gi-sage); text-transform: uppercase; }
  .gi-retail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 10px; }
  @media (max-width: 480px) { .gi-retail-grid { grid-template-columns: 1fr; } }
  .gi-retail-card {
    background: var(--surface);
    border: 1px solid var(--border-hi);
    border-left: 3px solid var(--gi-sage);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s;
  }
  .gi-retail-card:hover { border-color: var(--gi-sage); background: var(--surface-hi); }
  .gi-retail-card-thumb { height: 120px; background: var(--surface-hi); display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; }
  .gi-retail-card-thumb img { width: 100%; height: 100%; object-fit: contain; padding: 8px; }
  .gi-retail-card-thumb-placeholder { font-family: var(--font-ui); font-size: 32px; color: var(--gi-sage); opacity: 0.2; }
  .gi-retail-card-body { padding: 14px; flex: 1; display: flex; flex-direction: column; }
  .gi-retail-card-source { font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gi-sage); font-weight: 600; margin-bottom: 6px; }
  .gi-retail-card-title { font-family: var(--font-ui); font-size: 13px; color: var(--text); line-height: 1.4; margin-bottom: 10px; flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .gi-retail-card-price { font-family: var(--font-ui); font-size: 22px; font-weight: 600; color: var(--gi-sage); }
  .gi-retail-card-footer { padding: 8px 14px; border-top: 1px solid var(--border); font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-mute); }
  .gi-retail-disclaimer { font-family: var(--font-ui); font-size: 10px; color: var(--text-mute); font-style: italic; margin-top: 10px; }

  /* ── ENRICH LOADING ANIMATION ── */
  .gi-enrich-progress { height: 2px; background: var(--border-hi); margin: 16px 0; overflow: hidden; }
  .gi-enrich-progress-bar { height: 100%; background: var(--gi-sage); width: 0%; transition: width 0.6s ease; }
  .gi-edit-row { display: flex; gap: 8px; align-items: center; }
  .gi-edit-input { min-width: 0;
    flex: 1;
    padding: 10px 12px;
    background: var(--shell);
    border: 1px solid var(--border-hi);
    font-family: var(--font-ui);
    font-size: 16px;
    font-weight: 500;
    color: var(--text);
    outline: none;
  }
