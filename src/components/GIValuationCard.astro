---
import { R2_CDN } from '../lib/constants'
import { formatGIValueRange, formatGISingleValue } from '../lib/currency'

interface Props {
  item: any
}

const { item } = Astro.props
const r = item.result_json || {}
const imageUrl = item.image_key ? `${R2_CDN}/${item.image_key}` : null
const currency = r.currency || 'USD'
const confidenceScore = r.confidence === 'High' ? 94 : r.confidence === 'Medium' ? 72 : 45
const confCircumference = 2 * Math.PI * 20
const confOffset = confCircumference - (confCircumference * confidenceScore / 100)
const valueDisplay = formatGIValueRange(r.value_range_low || 0, r.value_range_high || 0, currency)
const valueLow = formatGISingleValue(r.value_range_low || 0, currency)
const valueHigh = formatGISingleValue(r.value_range_high || 0, currency)
const date = new Date(item.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
---

<style is:global>
  .gi-card { width: 100%; max-width: 100%; padding-bottom: 100px; background: var(--c-bg); }

  /* ── HEADER ── */
  .gi-header {
    position: sticky; top: 0; z-index: 50;
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 20px;
    background: var(--c-dark-bg); backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--c-border);
  }
  .gi-logo { font-family: var(--font-serif); font-size: 12px; letter-spacing: 4px; text-transform: uppercase; color: var(--c-text); }
  .gi-logo span { color: var(--c-sage); }
  .gi-breadcrumb { display: flex; align-items: center; gap: 6px; }
  .gi-bc-link { font-family: var(--font-serif); font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--c-sage); text-decoration: none; }
  .gi-bc-link:hover { color: var(--c-text); }
  .gi-bc-sep { font-family: var(--font-serif); font-size: 10px; color: var(--c-border); }
  .gi-bc-cur { font-family: var(--font-serif); font-size: 10px; letter-spacing: 1px; color: var(--c-text-mid); text-transform: uppercase; max-width: 100px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .gi-delete-btn { font-family: var(--font-serif); font-size: 9px; letter-spacing: 2px; text-transform: uppercase; color: var(--c-text-mid); background: none; border: 1px solid var(--c-border); padding: 6px 12px; cursor: pointer; transition: border-color .2s, color .2s; }
  .gi-delete-btn:hover { border-color: var(--c-warn); color: var(--c-warn); }

  /* ── DELETE MODAL ── */
  .gi-del-overlay { position: fixed; inset: 0; z-index: 200; background: rgba(28,24,16,.5); backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center; padding: 24px; }
  .gi-del-modal { background: var(--c-bg); border: 1px solid var(--c-border); padding: 32px 24px; max-width: 320px; width: 100%; text-align: center; }
  .gi-del-title { font-family: var(--font-display); font-size: 20px; font-style: italic; color: var(--c-text); margin-bottom: 10px; }
  .gi-del-sub { font-family: var(--font-serif); font-size: 14px; color: var(--c-text-mid); line-height: 1.7; margin-bottom: 24px; }
  .gi-del-btns { display: flex; gap: 8px; }
  .gi-del-cancel { flex: 1; font-family: var(--font-serif); font-size: 10px; letter-spacing: 2px; text-transform: uppercase; background: none; border: 1px solid var(--c-border); padding: 12px; cursor: pointer; color: var(--c-text-dim); }
  .gi-del-confirm { flex: 1; font-family: var(--font-serif); font-size: 10px; letter-spacing: 2px; text-transform: uppercase; background: var(--c-dark); border: 1px solid var(--c-dark); padding: 12px; cursor: pointer; color: var(--c-bg); }

  /* ── IMAGE ── */
  .gi-image-wrap { position: relative; width: 100%; background: var(--c-surface); }
  .gi-image { width: 100%; max-height: 380px; object-fit: contain; background: var(--c-surface); display: block; }
  .gi-image-placeholder { width: 100%; height: 200px; display: flex; align-items: center; justify-content: center; background: var(--c-surface); }
  .gi-image-placeholder-icon { color: var(--c-border); }
  .gi-conf-arc { position: absolute; bottom: 14px; right: 14px; z-index: 10; }
  .gi-conf-label { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-family: var(--font-serif); font-size: 8px; color: var(--c-sage); }

  /* ── SECTION ── */
  .gi-section { padding: 28px 20px; border-bottom: 1px solid var(--c-border); }
  .gi-section-head { margin-bottom: 20px; padding-left: 12px; border-left: 2px solid var(--c-sage); }
  .gi-section-title { font-size: 16px; letter-spacing: 2px; font-weight: 700; color: var(--c-sage); text-transform: uppercase; font-family: var(--font-serif); }

  /* ── BADGE ── */
  .gi-badge { display: inline-block; font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--c-sage); border: 1px solid var(--c-sage); padding: 3px 10px; margin: 16px 20px 0; }

  /* ── TITLE ── */
  .gi-title { font-family: var(--font-display); font-size: clamp(22px, 5vw, 30px); font-weight: 400; font-style: italic; color: var(--c-text); padding: 10px 20px 6px; line-height: 1.2; }
  .gi-date { font-family: var(--font-ui); font-size: 11px; color: var(--c-text-mid); letter-spacing: 0.05em; padding: 0 20px 16px; }

  /* ── VALUE ── */
  .gi-value-block { background: var(--c-surface); border-top: 1px solid var(--c-border); border-bottom: 1px solid var(--c-border); padding: 28px 20px; }
  .gi-value-cap { font-family: var(--font-serif); font-size: 9px; letter-spacing: 3px; text-transform: uppercase; color: var(--c-text-mid); margin-bottom: 10px; text-align: center; }
  .gi-value-amount { font-family: var(--font-display); font-size: clamp(28px, 6vw, 42px); font-weight: 400; color: var(--c-sage); letter-spacing: -1px; text-align: center; margin-bottom: 6px; }
  .gi-value-note { font-family: var(--font-ui); font-size: 11px; color: var(--c-text-mid); text-align: center; margin-bottom: 20px; }
  .gi-value-strip { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--c-border); margin-top: 16px; }
  .gi-value-strip-cell { background: var(--c-surface); padding: 14px 8px; text-align: center; }
  .gi-value-strip-label { font-family: var(--font-serif); font-size: 9px; letter-spacing: 3px; text-transform: uppercase; color: var(--c-text-mid); margin-bottom: 6px; }
  .gi-value-strip-val { font-family: var(--font-display); font-size: 20px; color: var(--c-text); }

  /* ── EDIT VALUE ── */
  .gi-edit-wrap { margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--c-border); }
  .gi-edit-label { font-family: var(--font-serif); font-size: 9px; letter-spacing: 3px; text-transform: uppercase; color: var(--c-text-mid); margin-bottom: 8px; }
  .gi-edit-row { display: flex; gap: 8px; align-items: center; }
  .gi-edit-input { flex: 1; padding: 10px 12px; background: var(--c-bg); border: 1px solid var(--c-border); font-family: var(--font-display); font-size: 18px; color: var(--c-text); outline: none; }
  .gi-edit-input:focus { border-color: var(--c-sage); }
  .gi-edit-btn { padding: 10px 16px; background: var(--c-sage); border: none; font-family: var(--font-serif); font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: #fff; cursor: pointer; transition: opacity .2s; }
  .gi-edit-btn:hover { opacity: 0.85; }
  .gi-edit-saved { font-family: var(--font-serif); font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--c-sage); display: none; margin-top: 6px; }

  /* ── ID TABLE ── */
  .gi-id-row { display: flex; gap: 16px; align-items: flex-start; padding: 12px 0; border-bottom: 1px solid var(--c-border-lo); }
  .gi-id-row:last-child { border-bottom: none; }
  .gi-id-key { width: 120px; flex-shrink: 0; font-family: var(--font-serif); font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--c-text-mid); padding-top: 2px; }
  .gi-id-val { font-family: var(--font-serif); font-size: 16px; color: var(--c-text); line-height: 1.5; flex: 1; }

  /* ── CONFIDENCE ── */
  .gi-confidence-wrap { display: flex; align-items: center; gap: 16px; padding: 16px 0; }
  .gi-confidence-text { font-family: var(--font-serif); font-size: 14px; color: var(--c-text-dim); line-height: 1.7; flex: 1; }

  /* ── ROOM ── */
  .gi-room-select { width: 100%; padding: 12px 14px; background: var(--c-bg); border: 1px solid var(--c-border); font-family: var(--font-serif); font-size: 15px; color: var(--c-text); outline: none; appearance: none; cursor: pointer; }
  .gi-room-select:focus { border-color: var(--c-sage); }
  .gi-room-saved { font-family: var(--font-serif); font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--c-sage); display: none; margin-top: 8px; }

  /* ── NOTES ── */
  .gi-notes-text { font-family: var(--font-serif); font-size: 15px; line-height: 1.9; color: var(--c-text-dim); }

  /* ── FOOTER ── */
  .gi-footer { padding: 20px; border-top: 1px solid var(--c-border); display: flex; justify-content: space-between; align-items: center; }
  .gi-footer-brand { font-family: var(--font-display); font-size: 13px; font-style: italic; color: var(--c-sage); margin-bottom: 3px; }
  .gi-ai-disclaimer { font-family: var(--font-serif); font-size: 9px; letter-spacing: 1px; color: var(--c-text-mid); line-height: 1.6; max-width: 200px; }

  /* ── STICKY ACTIONS ── */
  /* ── ANTIQUE HANDOFF ── */
  .gi-antique-banner { background: var(--c-dark); border-left: 3px solid var(--c-sage); padding: 24px 20px; display: flex; flex-direction: column; gap: 12px; }
  .gi-antique-title { font-family: var(--font-display); font-size: 20px; color: #ffffff; font-style: italic; }
  .gi-antique-body { font-family: var(--font-ui); font-size: 13px; color: rgba(255,255,255,0.65); line-height: 1.7; }
  .gi-antique-cta { display: inline-block; font-family: var(--font-ui); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--c-dark); background: var(--c-sage); padding: 12px 24px; text-decoration: none; margin-top: 4px; align-self: flex-start; }
  .gi-antique-value { font-family: var(--font-display); font-size: 28px; color: var(--c-gold-hi); font-style: italic; }

  .gi-sticky-actions { position: fixed; bottom: 0; left: 0; right: 0; z-index: 100; background: var(--c-dark-bg); backdrop-filter: blur(20px); border-top: 1px solid var(--c-border); padding: 12px 20px calc(24px + env(safe-area-inset-bottom)); display: flex; gap: 8px; }
  .gi-action-btn { flex: 1; padding: 13px; background: transparent; border: 1px solid var(--c-border); font-family: var(--font-serif); font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--c-text-dim); cursor: pointer; text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 6px; transition: border-color .2s; }
  .gi-action-btn:hover { border-color: var(--c-sage); color: var(--c-text); }
  .gi-action-btn.primary { background: var(--c-dark); border-color: var(--c-dark); color: var(--c-bg); }
</style>

<div class="gi-card">

  <!-- HEADER -->
  <header class="gi-header">
    <div class="gi-logo">GAUK <span>Insurance</span></div>
    <nav class="gi-breadcrumb">
      <a href="/library" class="gi-bc-link">The Vault</a>
      <span class="gi-bc-sep">&rsaquo;</span>
      <span class="gi-bc-cur">{r.category || 'Item'}</span>
    </nav>
  </header>

  <!-- IMAGE -->
  <div class="gi-image-wrap">
    {imageUrl ? (
      <img class="gi-image" src={imageUrl} alt={r.title || 'Item'} />
    ) : (
      <div class="gi-image-placeholder">
        <svg class="gi-image-placeholder-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="0"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      </div>
    )}
    <div class="gi-conf-arc">
      <svg width="44" height="44" viewBox="0 0 44 44">
        <circle cx="22" cy="22" r="20" fill="rgba(239,231,217,.92)" stroke="var(--c-surface-mid)" stroke-width="2"/>
        <circle cx="22" cy="22" r="20" fill="none" stroke="var(--c-sage)" stroke-width="2.5"
          stroke-dasharray={confCircumference} stroke-dashoffset={confOffset} stroke-linecap="round"
          transform="rotate(-90 22 22)"/>
      </svg>
      <div class="gi-conf-label">{confidenceScore}%</div>
    </div>
  </div>

  <!-- BADGE + TITLE -->
  <div class="gi-badge">GAUK Insurance</div>
  {r.antique_category && r.antique_category !== r.category && (
    <div class="gi-badge" style="background:rgba(122,92,32,0.12);color:var(--c-gold);border-color:var(--c-gold);">{r.antique_category}</div>
  )}
  <div class="gi-title">{r.title || r.subcategory || 'Unidentified Item'}</div>
  <div class="gi-date">{date}</div>

  <!-- VALUE -->
  <div class="gi-value-block">
    <div class="gi-value-cap">Est. Replacement Cost</div>
    <div class="gi-value-amount" id="gi-value-display">{valueDisplay}</div>
    <div class="gi-value-note">AI estimate based on current retail pricing</div>
    <div class="gi-value-strip">
      <div class="gi-value-strip-cell">
        <div class="gi-value-strip-label">Low estimate</div>
        <div class="gi-value-strip-val">{valueLow}</div>
      </div>
      <div class="gi-value-strip-cell">
        <div class="gi-value-strip-label">High estimate</div>
        <div class="gi-value-strip-val">{valueHigh}</div>
      </div>
    </div>
    <div class="gi-edit-wrap">
      <div class="gi-edit-label">Override value</div>
      <div class="gi-edit-row">
        <input class="gi-edit-input" id="gi-edit-input" type="number" placeholder={String(r.value_range_high || 0)} />
        <button class="gi-edit-btn" id="gi-edit-btn">Confirm</button>
      </div>
      <div class="gi-edit-saved" id="gi-edit-saved">Value updated</div>
    </div>
  </div>

  <!-- IDENTIFICATION -->
  <div class="gi-section">
    <div class="gi-section-head"><div class="gi-section-title">Item Details</div></div>
    {r.description && <div class="gi-id-row"><div class="gi-id-key">Description</div><div class="gi-id-val">{r.description}</div></div>}
    {r.category && <div class="gi-id-row"><div class="gi-id-key">Category</div><div class="gi-id-val">{r.category}</div></div>}
    {r.subcategory && r.subcategory !== r.title && <div class="gi-id-row"><div class="gi-id-key">Type</div><div class="gi-id-val">{r.subcategory}</div></div>}
    {r.brand && <div class="gi-id-row"><div class="gi-id-key">Brand</div><div class="gi-id-val">{r.brand}</div></div>}
    {r.model && <div class="gi-id-row"><div class="gi-id-key">Model</div><div class="gi-id-val">{r.model}</div></div>}
    {r.condition && <div class="gi-id-row"><div class="gi-id-key">Condition</div><div class="gi-id-val">{r.condition}</div></div>}
    {r.purchase_year && <div class="gi-id-row"><div class="gi-id-key">Purchased</div><div class="gi-id-val">{r.purchase_year}</div></div>}
  </div>

  <!-- CONFIDENCE -->
  <div class="gi-section">
    <div class="gi-section-head"><div class="gi-section-title">Confidence</div></div>
    <div class="gi-confidence-wrap">
      <svg width="44" height="44" viewBox="0 0 44 44" style="flex-shrink:0">
        <circle cx="22" cy="22" r="20" fill="none" stroke="var(--c-surface-mid)" stroke-width="3"/>
        <circle cx="22" cy="22" r="20" fill="none" stroke="var(--c-sage)" stroke-width="3"
          stroke-dasharray={confCircumference} stroke-dashoffset={confOffset} stroke-linecap="round"
          transform="rotate(-90 22 22)"/>
        <text x="22" y="27" text-anchor="middle" font-family="Prata, Georgia, serif" font-size="11" fill="var(--c-text)">{confidenceScore}%</text>
      </svg>
      <div class="gi-confidence-text">
        {r.confidence === 'High'
          ? 'Strong match — the AI is highly confident in this identification and replacement cost estimate.'
          : r.confidence === 'Medium'
          ? 'Good match — the AI identified this item with reasonable confidence. Consider requesting a specialist assessment for high-value insurance purposes.'
          : 'Low confidence — the AI could not identify this item clearly. A manual review or specialist assessment is recommended before adding to your insurance policy.'}
      </div>
    </div>
  </div>

  <!-- ROOM ASSIGNMENT -->
  <div class="gi-section">
    <div class="gi-section-head"><div class="gi-section-title">Room Assignment</div></div>
    <select class="gi-room-select" id="gi-room-select">
      <option value="">Select a room</option>
      <option value="Living Room">Living Room</option>
      <option value="Bedroom">Bedroom</option>
      <option value="Master Bedroom">Master Bedroom</option>
      <option value="Kitchen">Kitchen</option>
      <option value="Dining Room">Dining Room</option>
      <option value="Study / Office">Study / Office</option>
      <option value="Bathroom">Bathroom</option>
      <option value="Garage">Garage</option>
      <option value="Garden / Outdoor">Garden / Outdoor</option>
      <option value="Loft / Storage">Loft / Storage</option>
      <option value="Other">Other</option>
    </select>
    <div class="gi-room-saved" id="gi-room-saved">Room saved</div>
  </div>

  <!-- CONDITION NOTES -->
  {r.condition_notes && (
    <div class="gi-section">
      <div class="gi-section-head"><div class="gi-section-title">Condition Notes</div></div>
      <div class="gi-notes-text">{r.condition_notes}</div>
    </div>
  )}

  <!-- ANTIQUE HANDOFF — shown when GI scan identifies a potential antique -->
  {r.is_antique && (r.maker || r.period || r.condition) && (
    <div class="gi-section">
      <div class="gi-section-head"><div class="gi-section-title">Antique Details</div></div>
      {r.maker && <div class="gi-id-row"><div class="gi-id-key">Maker</div><div class="gi-id-val">{r.maker}</div></div>}
      {r.period && <div class="gi-id-row"><div class="gi-id-key">Period</div><div class="gi-id-val">{r.period}</div></div>}
      {r.condition && <div class="gi-id-row"><div class="gi-id-key">Condition</div><div class="gi-id-val">{r.condition}</div></div>}
      {r.antique_value_range_low && r.antique_value_range_high && (
        <div style="padding-top:16px;border-top:1px solid var(--c-border);margin-top:12px;">
          <div style="font-family:var(--font-serif);font-size:9px;letter-spacing:3px;text-transform:uppercase;color:var(--c-text-mid);margin-bottom:8px;">Estimated Antique Value</div>
          <div class="gi-antique-value">{formatGIValueRange(r.antique_value_range_low, r.antique_value_range_high, currency)}</div>
        </div>
      )}
    </div>
  )}

  {r.is_antique && (
    <div class="gi-antique-banner">
      <div class="gi-antique-title">
        This item may be an antique worth specialist assessment.
      </div>
      <div class="gi-antique-body">
        Our AI has flagged this as a potential antique. A specialist deep dive checks our antiques knowledge graph, recent auction results and maker databases to give you a definitive picture &mdash; so you know exactly what you have and what it is worth to insure correctly.
      </div>
      <a class="gi-antique-cta" href={`/valuation/${item.id}`}>Get your specialist report</a>
    </div>
  )}

  <!-- FOOTER -->
  <div class="gi-footer">
    <div>
      <div class="gi-footer-brand">GAUK Insurance</div>
      <div class="gi-ai-disclaimer">AI estimate &middot; not a formal valuation &middot; {date}</div>
    </div>
    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:14px;">
      <div style="text-align:right">
        <div style="font-family:var(--font-serif);font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--c-text-mid);margin-bottom:4px;">Reference</div>
        <div style="font-family:var(--font-serif);font-size:9px;letter-spacing:1px;color:var(--c-text-dim);">{item.id.slice(0,8).toUpperCase()}</div>
      </div>
      <button id="gi-delete-btn" class="gi-delete-btn">Delete this item</button>
    </div>
  </div>

  <!-- DELETE MODAL -->
  <div class="gi-del-overlay hidden" id="gi-del-overlay">
    <div class="gi-del-modal">
      <div class="gi-del-title">Delete this item?</div>
      <div class="gi-del-sub">This will permanently remove the item from your vault and insurance record.</div>
      <div class="gi-del-btns">
        <button class="gi-del-cancel" id="gi-del-cancel">Cancel</button>
        <button class="gi-del-confirm" id="gi-del-confirm">Delete</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { supabase } from '../lib/supabase-browser'

  const { data: { session } } = await supabase.auth.getSession()
  const itemId = (window as any).__val?.itemId
  const GI_SITE_ID = 'd065c030-58b4-4f48-a2df-f14d666d6cfa'

  // ── Pre-populate room select ──────────────────────────────────────────────
  if (itemId && session) {
    const { data: item } = await supabase
      .from('identifications').select('room, user_value').eq('id', itemId).single()
    if (item?.room) {
      const roomSelect = document.getElementById('gi-room-select') as HTMLSelectElement
      if (roomSelect) roomSelect.value = item.room
    }
    if (item?.user_value) {
      const editInput = document.getElementById('gi-edit-input') as HTMLInputElement
      if (editInput) editInput.placeholder = String(item.user_value)
    }
  }

  // ── Edit price ────────────────────────────────────────────────────────────
  document.getElementById('gi-edit-btn')?.addEventListener('click', async () => {
    const input = document.getElementById('gi-edit-input') as HTMLInputElement
    const saved = document.getElementById('gi-edit-saved')
    if (!input || !session || !itemId) return
    const val = parseFloat(input.value)
    if (isNaN(val) || val <= 0) return
    const { error } = await supabase
      .from('identifications').update({ user_value: val })
      .eq('id', itemId).eq('user_id', session.user.id)
    if (!error && saved) {
      saved.style.display = 'block'
      setTimeout(() => { if (saved) saved.style.display = 'none' }, 2000)
    }
  })

  // ── Room save ─────────────────────────────────────────────────────────────
  document.getElementById('gi-room-select')?.addEventListener('change', async (e) => {
    const select = e.target as HTMLSelectElement
    const saved = document.getElementById('gi-room-saved')
    if (!session || !itemId) return
    const { error } = await supabase
      .from('identifications').update({ room: select.value })
      .eq('id', itemId).eq('user_id', session.user.id)
    if (!error && saved) {
      saved.style.display = 'block'
      setTimeout(() => { if (saved) saved.style.display = 'none' }, 2000)
    }
  })

  // ── Delete ────────────────────────────────────────────────────────────────
  document.getElementById('gi-delete-btn')?.addEventListener('click', () => {
    document.getElementById('gi-del-overlay')?.classList.remove('hidden')
  })
  document.getElementById('gi-del-cancel')?.addEventListener('click', () => {
    document.getElementById('gi-del-overlay')?.classList.add('hidden')
  })
  document.getElementById('gi-del-confirm')?.addEventListener('click', async () => {
    const btn = document.getElementById('gi-del-confirm') as HTMLButtonElement
    if (!btn || !session || !itemId) return
    btn.textContent = 'Deleting...'
    btn.disabled = true
    await supabase.from('identifications').delete()
      .eq('id', itemId).eq('user_id', session.user.id)
    window.location.href = '/library'
  })


</script>

