  .gi-enrich-gate-eyebrow {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--gi-sage);
    margin-bottom: 10px;
  }
  .gi-enrich-gate-title {
    font-family: var(--font-ui);
    font-size: 18px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 8px;
    line-height: 1.3;
  }
  .gi-enrich-gate-body {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.7;
    margin-bottom: 20px;
