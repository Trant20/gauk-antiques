  .gi-edit-input::placeholder { color: var(--text-faint); }
  .gi-edit-btn {
    padding: 10px 20px;
    background: var(--gi-sage);
    border: none;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    cursor: pointer;
    transition: opacity .2s;
  }
  .gi-edit-btn:hover { opacity: 0.85; }
  .gi-edit-saved {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gi-sage);
    display: none;
    margin-top: 6px;
  }

  /* ── SECTION ── */
  .gi-section {
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
  }
  .gi-section-head {
    margin-bottom: 20px;
    padding-left: 12px;
    border-left: 2px solid var(--gi-sage);
  }
  .gi-section-title {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.16em;
    font-weight: 700;
    color: var(--gi-sage);
    text-transform: uppercase;
  }

  /* ── ID TABLE ── */
  .gi-id-row {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .gi-id-row:last-child { border-bottom: none; }
  .gi-id-key {
    width: 120px;
    flex-shrink: 0;
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
    padding-top: 2px;
  }
  .gi-id-val {
    font-family: var(--font-ui);
    font-size: 15px;
    color: var(--text);
    line-height: 1.5;
    flex: 1;
  }

  /* ── CONFIDENCE ── */
  .gi-confidence-wrap {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 8px 0;
  }
  .gi-confidence-text {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.7;
    flex: 1;
  }

  /* ── ROOM ── */
  .gi-room-select {
    width: 100%;
    padding: 12px 14px;
    background: var(--shell);
    border: 1px solid var(--border-hi);
    font-family: var(--font-ui);
    font-size: 15px;
    color: var(--text);
    outline: none;
    appearance: none;
    cursor: pointer;
  }
  .gi-room-select:focus { border-color: var(--gi-sage); }
  .gi-room-saved {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gi-sage);
    display: none;
    margin-top: 8px;
  }

  /* ── NOTES ── */
  .gi-notes-text {
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.9;
    color: var(--text-dim);
  }

  /* ── INLINE EDIT ── */
  .gi-inline-edit-wrap { position: relative; }
  .gi-inline-text {
    font-family: var(--font-ui);
    font-size: 15px;
    color: var(--text);
    line-height: 1.6;
    flex: 1;
    cursor: pointer;
    border-bottom: 1px dashed var(--border-hi);
    padding-bottom: 2px;
    transition: border-color .2s;
  }
  .gi-inline-text:hover { border-bottom-color: var(--gi-sage); }
  .gi-inline-textarea {
    width: 100%;
    padding: 10px 12px;
    background: var(--shell);
    border: 1px solid var(--gi-sage);
    font-family: var(--font-ui);
    font-size: 15px;
    color: var(--text);
    line-height: 1.6;
    resize: vertical;
    min-height: 100px;
    outline: none;
    display: none;
  }
  .gi-inline-actions {
    display: none;
    gap: 8px;
    margin-top: 8px;
  }
  .gi-inline-save {
    padding: 7px 16px;
    background: var(--gi-sage);
    border: none;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    cursor: pointer;
  }
  .gi-inline-cancel {
    padding: 7px 16px;
    background: none;
    border: 1px solid var(--border-hi);
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
    cursor: pointer;
  }
  .gi-inline-hint {
    font-family: var(--font-ui);
    font-size: 10px;
    color: var(--text-mute);
    margin-top: 4px;
    display: block;
  }

  /* ── ANTIQUE HANDOFF ── */
  .gi-antique-banner {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--gi-sage);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 24px;
  }
  .gi-antique-title {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--text);
    font-style: italic;
  }
  .gi-antique-body {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.7;
  }
  .gi-antique-cta {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    background: var(--gi-sage);
    padding: 12px 24px;
    text-decoration: none;
    margin-top: 4px;
    align-self: flex-start;
  }
  .gi-antique-value {
    font-family: var(--font-ui);
    font-size: 28px;
    font-weight: 600;
    color: var(--gi-sage);
  }

  /* ── FOOTER ── */
  .gi-footer {
    padding: 24px 0;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
  }
  .gi-footer-brand {
    font-family: var(--font-display);
    font-size: 14px;
    font-style: italic;
    color: var(--gi-sage);
    margin-bottom: 4px;
  }
  .gi-ai-disclaimer {
    font-family: var(--font-ui);
    font-size: 11px;
    color: var(--text-mute);
    line-height: 1.6;
  }

  /* ── CARD ACTIONS (inline, not sticky) ── */
  .gi-card-actions {
    display: flex;
    gap: 8px;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .gi-action-btn {
    flex: 1;
    padding: 13px;
    background: transparent;
    border: 1px solid var(--border-hi);
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
    cursor: pointer;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: border-color .2s, color .2s;
  }
  .gi-action-btn:hover { border-color: var(--gi-sage); color: var(--text); }
  .gi-action-btn.primary {
    background: var(--gi-sage);
    border-color: var(--gi-sage);
    color: #fff;
  }
  .gi-action-btn.primary:hover { opacity: 0.85; }

  /* ── DELETE BUTTON ── */
  .gi-delete-btn {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-mute);
    background: none;
    border: 1px solid var(--border-hi);
    padding: 8px 14px;
    cursor: pointer;
    transition: border-color .2s, color .2s;
  }
  .gi-delete-btn:hover { border-color: #c46028; color: #c46028; }

  /* ── DELETE MODAL ── */
  .gi-del-overlay {
    position: fixed; inset: 0; z-index: 200;
    background: rgba(0,0,0,.7);
    backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center; padding: 24px;
  }
  .gi-del-modal {
    background: var(--surface);
    border: 1px solid var(--border-hi);
    padding: 32px 24px;
    max-width: 320px; width: 100%;
    text-align: center;
  }
  .gi-del-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-style: italic;
    color: var(--text);
    margin-bottom: 10px;
  }
  .gi-del-sub {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.7;
    margin-bottom: 24px;
  }
  .gi-del-btns { display: flex; gap: 8px; }
  .gi-del-cancel {
    flex: 1;
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: none;
    border: 1px solid var(--border-hi);
    padding: 12px;
    cursor: pointer;
    color: var(--text-dim);
  }
  .gi-del-confirm {
    flex: 1;
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: #c46028;
    border: 1px solid #c46028;
    padding: 12px;
    cursor: pointer;
    color: #fff;
  }

  @media (max-width: 768px) {
    .gi-card { padding: 20px 16px 100px; }
  }
</style>

<div class="gi-card">

  <!-- IMAGE -->
  <div class="gi-image-wrap">
    {imageUrl ? (
      <img class="gi-image" src={imageUrl} alt={r.title || 'Item'} />
    ) : (
      <div class="gi-image-placeholder">
        <svg class="gi-image-placeholder-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="0"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      </div>
    )}
    <div class="gi-conf-arc">
      <svg width="44" height="44" viewBox="0 0 44 44">
        <circle cx="22" cy="22" r="20" fill="var(--surface)" stroke="var(--border-hi)" stroke-width="2"/>
        <circle cx="22" cy="22" r="20" fill="none" stroke="var(--gi-sage)" stroke-width="2.5"
          stroke-dasharray={confCircumference} stroke-dashoffset={confOffset} stroke-linecap="round"
          transform="rotate(-90 22 22)"/>
      </svg>
      <div class="gi-conf-label">{confidenceScore}%</div>
    </div>
  </div>

  <!-- BADGE + TITLE -->
  <div class="gi-badge">GAUK Insurance</div>
  {r.antique_category && r.antique_category !== r.category && (
    <div class="gi-badge" style="margin-left:8px;color:var(--ga-gold);border-color:var(--ga-gold);">{r.antique_category}</div>
  )}
  <div class="gi-title">{r.title || r.subcategory || 'Unidentified Item'}</div>
  <div class="gi-date">{date}</div>

  <!-- VALUE -->
  <div class="gi-value-block">
    {userValueDisplay ? (
      <>
        <div class="gi-value-cap" id="gi-value-cap">Your valuation</div>
        <div class="gi-value-amount" id="gi-value-display">{userValueDisplay}</div>
        <div class="gi-value-note" id="gi-value-note">Human verified &middot; overrides AI estimate</div>
      </>
    ) : (
      <>
        <div class="gi-value-cap" id="gi-value-cap">Est. Replacement Cost</div>
        <div class="gi-value-amount" id="gi-value-display">{valueDisplay}</div>
        <div class="gi-value-note" id="gi-value-note">AI estimate based on current retail pricing</div>
        <div class="gi-value-strip">
          <div class="gi-value-strip-cell">
            <div class="gi-value-strip-label">Low estimate</div>
            <div class="gi-value-strip-val">{valueLow}</div>
          </div>
          <div class="gi-value-strip-cell">
            <div class="gi-value-strip-label">High estimate</div>
            <div class="gi-value-strip-val">{valueHigh}</div>
          </div>
        </div>

      </>
    )}
    <div class="gi-value-strip" id="gi-ai-strip" style={userValueDisplay ? 'display:none' : ''}></div>
    <div class="gi-edit-wrap">
      <div class="gi-edit-label">{userValueDisplay ? 'Update value' : 'Override value'}</div>
      <div class="gi-edit-row">
        <input class="gi-edit-input" id="gi-edit-input" type="number" placeholder={userValueDisplay ? String(userValue) : String(r.value_range_high || 0)} />
        <button class="gi-edit-btn" id="gi-edit-btn">Confirm</button>
      </div>
      <div class="gi-edit-saved" id="gi-edit-saved">Value updated</div>
    </div>
  </div>

  <!-- IDENTIFICATION -->
  <div class="gi-section">
    <div class="gi-section-head"><div class="gi-section-title">Item Details</div></div>
    {r.description && (
      <div class="gi-id-row">
        <div class="gi-id-key">Description</div>
        <div class="gi-id-val gi-inline-edit-wrap">
          <div class="gi-inline-text" id="gi-desc-text">{r.description}</div>
          <textarea class="gi-inline-textarea" id="gi-desc-textarea">{r.description}</textarea>
          <div class="gi-inline-actions" id="gi-desc-actions">
            <button class="gi-inline-save" id="gi-desc-save">Save</button>
            <button class="gi-inline-cancel" id="gi-desc-cancel">Cancel</button>
          </div>
          <span class="gi-inline-hint">Click to edit</span>
        </div>
      </div>
    )}
    {r.category && <div class="gi-id-row"><div class="gi-id-key">Category</div><div class="gi-id-val">{r.category}</div></div>}
    {r.subcategory && r.subcategory !== r.title && <div class="gi-id-row"><div class="gi-id-key">Type</div><div class="gi-id-val">{r.subcategory}</div></div>}
    {r.brand && <div class="gi-id-row"><div class="gi-id-key">Brand</div><div class="gi-id-val">{r.brand}</div></div>}
    {r.model && <div class="gi-id-row"><div class="gi-id-key">Model</div><div class="gi-id-val">{r.model}</div></div>}
    {r.condition && <div class="gi-id-row"><div class="gi-id-key">Condition</div><div class="gi-id-val">{r.condition}</div></div>}
    {r.purchase_year && <div class="gi-id-row"><div class="gi-id-key">Purchased</div><div class="gi-id-val">{r.purchase_year}</div></div>}
  </div>

  <!-- CONFIDENCE -->
  <div class="gi-section">
    <div class="gi-section-head"><div class="gi-section-title">Confidence</div></div>
    <div class="gi-confidence-wrap">
      <svg width="44" height="44" viewBox="0 0 44 44" style="flex-shrink:0">
        <circle cx="22" cy="22" r="20" fill="none" stroke="var(--border-hi)" stroke-width="3"/>
        <circle cx="22" cy="22" r="20" fill="none" stroke="var(--gi-sage)" stroke-width="3"
          stroke-dasharray={confCircumference} stroke-dashoffset={confOffset} stroke-linecap="round"
          transform="rotate(-90 22 22)"/>
        <text x="22" y="27" text-anchor="middle" font-family="Inter, sans-serif" font-size="10" font-weight="600" fill="var(--text)">{confidenceScore}%</text>
      </svg>
      <div class="gi-confidence-text">
        {r.confidence === 'High'
          ? 'Strong match — the AI is highly confident in this identification and replacement cost estimate.'
          : r.confidence === 'Medium'
          ? 'Good match — the AI identified this item with reasonable confidence. Consider requesting a specialist assessment for high-value insurance purposes.'
          : 'Low confidence — the AI could not identify this item clearly. A manual review or specialist assessment is recommended before adding to your insurance policy.'}
      </div>
    </div>
  </div>

  <!-- ROOM ASSIGNMENT -->
  <div class="gi-section">
    <div class="gi-section-head"><div class="gi-section-title">Room Assignment</div></div>
    <select class="gi-room-select" id="gi-room-select">
      <option value="">Select a room</option>
      <option value="Living Room">Living Room</option>
      <option value="Kitchen">Kitchen</option>
      <option value="Dining Room">Dining Room</option>
      <option value="Hallway">Hallway</option>
      <option value="Master Bedroom">Master Bedroom</option>
      <option value="Bedroom 2">Bedroom 2</option>
      <option value="Bedroom 3">Bedroom 3</option>
      <option value="Bedroom 4">Bedroom 4</option>
      <option value="Bathroom">Bathroom</option>
      <option value="Study / Home Office">Study / Home Office</option>
      <option value="Garage">Garage</option>
      <option value="Garden / Outdoor">Garden / Outdoor</option>
      <option value="Loft / Storage">Loft / Storage</option>
      <option value="Other">Other</option>
    </select>
    <div class="gi-room-saved" id="gi-room-saved">Room saved</div>
  </div>

  <!-- CONDITION NOTES -->
  {r.condition_notes && (
    <div class="gi-section">
      <div class="gi-section-head"><div class="gi-section-title">Condition Notes</div></div>
      <div class="gi-notes-text">{r.condition_notes}</div>
    </div>
  )}

  <!-- ANTIQUE DETAILS -->
  {r.is_antique && (r.maker || r.period || r.condition) && (
    <div class="gi-section">
      <div class="gi-section-head"><div class="gi-section-title">Antique Details</div></div>
      {r.maker && <div class="gi-id-row"><div class="gi-id-key">Maker</div><div class="gi-id-val">{r.maker}</div></div>}
      {r.period && <div class="gi-id-row"><div class="gi-id-key">Period</div><div class="gi-id-val">{r.period}</div></div>}
      {r.condition && <div class="gi-id-row"><div class="gi-id-key">Condition</div><div class="gi-id-val">{r.condition}</div></div>}
      {r.antique_value_range_low && r.antique_value_range_high && (
        <div style="padding-top:16px;border-top:1px solid var(--border);margin-top:12px;">
          <div style="font-family:var(--font-ui);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-mute);margin-bottom:8px;">Estimated Antique Value</div>
          <div class="gi-antique-value">{formatPriceRange(r.antique_value_range_low, r.antique_value_range_high, currency)}</div>
        </div>
      )}
    </div>
  )}

  <!-- ANTIQUE ENRICHMENT — renders GA enrichment gate and sections in place -->
  {r.is_antique && (
    <div style="margin-top:24px;">
      {gaEnrichment ? (
        <GAEnrichmentSections enrichment={gaEnrichment} r={r} item={item} currency={currency} />
      ) : (
        <GAEnrichGate item={item} r={r} creditCostEnrich={creditCostEnrich} />
      )}
    </div>
  )}

  <!-- FOOTER -->
  <div class="gi-footer">
    <div>
      <div class="gi-footer-brand">GAUK Insurance</div>
      <div class="gi-ai-disclaimer">AI estimate &middot; not a formal valuation &middot; {date}</div>
    </div>
    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:12px;">
      <div style="text-align:right;">
        <div style="font-family:var(--font-ui);font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-mute);margin-bottom:4px;">Reference</div>
        <div style="font-family:var(--font-ui);font-size:11px;color:var(--text-dim);">{item.id.slice(0,8).toUpperCase()}</div>
      </div>
      <button id="gi-delete-btn" class="gi-delete-btn">Delete this item</button>
    </div>
  </div>

  <!-- RETAIL PRICES SECTION -->
  <div class="gi-retail-section" id="gi-retail-section">
    <div class="gi-retail-section-head">
      <div class="gi-retail-section-title">Retail Price Reference</div>
    </div>

    {hasRetail ? (
      <>
        <div class="gi-retail-grid" id="gi-retail-grid">
          {retailPrices.slice(0, 6).map((rp: any) => (
            <a href={rp.link} target="_blank" rel="noopener noreferrer" class="gi-retail-card">
              <div class="gi-retail-card-thumb">
                {rp.thumbnail
                  ? <img src={rp.thumbnail} alt={rp.title} loading="lazy" />
                  : <div class="gi-retail-card-thumb-placeholder">£</div>
                }
              </div>
              <div class="gi-retail-card-body">
                <div class="gi-retail-card-source">{rp.source}</div>
                <div class="gi-retail-card-title">{rp.title}</div>
                <div class="gi-retail-card-price">{rp.price}</div>
              </div>
              <div class="gi-retail-card-footer">View listing</div>
            </a>
          ))}
        </div>
        <div class="gi-retail-disclaimer">Google Shopping results. Use as a reference to verify or override the AI estimate. Click any card to view the listing.</div>
      </>
    ) : (
      <div id="gi-enrich-gate">
        <div class="gi-enrich-gate">
          <div class="gi-enrich-gate-eyebrow">Real Replacement Cost</div>
          <div class="gi-enrich-gate-title">Get the actual retail price</div>
          <div class="gi-enrich-gate-body">We search Google Shopping in real time to find what this item costs to replace today from real retailers. No estimates. No guesswork.</div>
          <div class="gi-enrich-gate-cost">2 credits</div>
          <button class="gi-enrich-gate-btn" id="gi-enrich-btn">Search Retail Prices</button>
          <div class="gi-enrich-progress" id="gi-enrich-progress" style="display:none;">
            <div class="gi-enrich-progress-bar" id="gi-enrich-progress-bar"></div>
          </div>
          <div class="gi-enrich-loading-text" id="gi-enrich-loading">Searching retailers...</div>
          <div class="gi-enrich-saved" id="gi-enrich-saved"></div>
        </div>
      </div>
    )}
  </div>

  <!-- CARD ACTIONS -->
  <div class="gi-card-actions">
    <button class="gi-action-btn" onclick="window.print()">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
      Print
    </button>
    <a href="/identify/insurance" class="gi-action-btn primary">New Scan</a>
  </div>

  <!-- DELETE MODAL -->
  <div class="gi-del-overlay hidden" id="gi-del-overlay">
    <div class="gi-del-modal">
      <div class="gi-del-title">Delete this item?</div>
      <div class="gi-del-sub">This will permanently remove the item from your vault and insurance record.</div>
      <div class="gi-del-btns">
        <button class="gi-del-cancel" id="gi-del-cancel">Cancel</button>
        <button class="gi-del-confirm" id="gi-del-confirm">Delete</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { supabase } from '../lib/supabase-browser'

  const { data: { session } } = await supabase.auth.getSession()
  const itemId = (window as any).__val?.itemId
  const GI_SITE_ID = 'd065c030-58b4-4f48-a2df-f14d666d6cfa'

  // ── Pre-populate room select ──────────────────────────────────────────────
  if (itemId && session) {
    const { data: item } = await supabase
      .from('identifications').select('room, user_value').eq('id', itemId).single()
    if (item?.room) {
      const roomSelect = document.getElementById('gi-room-select') as HTMLSelectElement
      if (roomSelect) roomSelect.value = item.room
    }
    // user_value rendered server-side — no client placeholder needed
  }

  // ── Edit price ────────────────────────────────────────────────────────────
  document.getElementById('gi-edit-btn')?.addEventListener('click', async () => {
    const input = document.getElementById('gi-edit-input') as HTMLInputElement
    const saved = document.getElementById('gi-edit-saved')
    const capEl = document.getElementById('gi-value-cap')
    const displayEl = document.getElementById('gi-value-display')
    const noteEl = document.getElementById('gi-value-note')
    const aiStrip = document.getElementById('gi-ai-strip')
    if (!input || !session || !itemId) return
    const val = parseFloat(input.value)
    if (isNaN(val) || val <= 0) return
    const { error } = await supabase
      .from('identifications').update({ user_value: val })
      .eq('id', itemId).eq('user_id', session.user.id)
    if (!error) {
      // Update display to human verified state
      if (capEl) capEl.textContent = 'Your valuation'
      const userCurrency = (window as any).__val?.currency || 'GBP'
      const symbols: Record<string, string> = { GBP: '£', USD: '$', NZD: 'NZ$', AUD: 'AU$', EUR: '€' }
      const sym = symbols[userCurrency] || userCurrency + ' '
      if (displayEl) displayEl.textContent = sym + val.toLocaleString('en', { maximumFractionDigits: 0 })
      if (noteEl) noteEl.innerHTML = 'Human verified &middot; overrides AI estimate'
      if (aiStrip) aiStrip.style.display = 'none'
      input.placeholder = String(val)
      input.value = ''
      if (saved) {
        saved.style.display = 'block'
        setTimeout(() => { if (saved) saved.style.display = 'none' }, 2000)
      }
    }
  })

  // ── Room save ─────────────────────────────────────────────────────────────
  document.getElementById('gi-room-select')?.addEventListener('change', async (e) => {
    const select = e.target as HTMLSelectElement
    const saved = document.getElementById('gi-room-saved')
    if (!session || !itemId) return
    const { error } = await supabase
      .from('identifications').update({ room: select.value })
      .eq('id', itemId).eq('user_id', session.user.id)
    if (!error && saved) {
      saved.style.display = 'block'
      setTimeout(() => { if (saved) saved.style.display = 'none' }, 2000)
    }
  })

  // ── Edit description ─────────────────────────────────────────────────────
  const descText = document.getElementById('gi-desc-text')
  const descTextarea = document.getElementById('gi-desc-textarea') as HTMLTextAreaElement
  const descActions = document.getElementById('gi-desc-actions')
  const descSave = document.getElementById('gi-desc-save')
  const descCancel = document.getElementById('gi-desc-cancel')

  function openDescEdit() {
    if (!descText || !descTextarea || !descActions) return
    descTextarea.value = descText.textContent || ''
    descText.style.display = 'none'
    descTextarea.style.display = 'block'
    descActions.style.display = 'flex'
    descTextarea.focus()
  }

  function closeDescEdit() {
    if (!descText || !descTextarea || !descActions) return
    descText.style.display = 'block'
    descTextarea.style.display = 'none'
    descActions.style.display = 'none'
  }

  descText?.addEventListener('click', openDescEdit)

  descCancel?.addEventListener('click', closeDescEdit)

  descSave?.addEventListener('click', async () => {
    if (!descTextarea || !session || !itemId) return
    const newDesc = descTextarea.value.trim()
    if (!newDesc) return

    const currentResult = (window as any).__val?.resultJson || {}
    const updatedResult = { ...currentResult, description: newDesc }

    const { error } = await supabase
      .from('identifications')
      .update({ result_json: updatedResult })
      .eq('id', itemId)
      .eq('user_id', session.user.id)

    if (!error) {
      if (descText) descText.textContent = newDesc
      // Keep window.__val in sync
      if ((window as any).__val) (window as any).__val.resultJson = updatedResult
      closeDescEdit()
    }
  })

  // ── GI Enrichment ────────────────────────────────────────────────────────
  document.getElementById('gi-enrich-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('gi-enrich-btn') as HTMLButtonElement
    const loading = document.getElementById('gi-enrich-loading')
    const saved = document.getElementById('gi-enrich-saved')
    const gate = document.getElementById('gi-enrich-gate')
    const progress = document.getElementById('gi-enrich-progress')
    const progressBar = document.getElementById('gi-enrich-progress-bar')
    const retailSection = document.getElementById('gi-retail-section')
    if (!btn || !session || !itemId) return

    btn.disabled = true
    btn.textContent = 'Searching retailers...'
    if (loading) loading.style.display = 'block'
    if (progress) progress.style.display = 'block'

    // Animate progress bar
    let pct = 0
    const progressInterval = setInterval(() => {
      pct = Math.min(pct + 8, 85)
      if (progressBar) progressBar.style.width = pct + '%'
    }, 400)

    try {
      const res = await fetch('/api/enrich-gi', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${session.access_token}` },
        body: JSON.stringify({ identification_id: itemId, result: (window as any).__val?.resultJson || {}, locale: (window as any).__val?.locale || 'en-GB', currency: (window as any).__val?.currency || 'GBP' })
      })
      const data = await res.json()

      clearInterval(progressInterval)
      if (progressBar) progressBar.style.width = '100%'

      if (data.error) {
        if (loading) loading.style.display = 'none'
        if (progress) progress.style.display = 'none'
        btn.disabled = false
        btn.textContent = 'Search Retail Prices'
        if (saved) {
          saved.textContent = data.error
          saved.style.display = 'block'
        }
      } else if (data.retail_prices && data.retail_prices.length > 0) {
        // Render cards in place — no reload
        const cards = data.retail_prices.slice(0, 6).map((rp: any) => `
          <a href="${rp.link}" target="_blank" rel="noopener noreferrer" class="gi-retail-card">
            <div class="gi-retail-card-thumb">
              ${rp.thumbnail
                ? `<img src="${rp.thumbnail}" alt="${rp.title}" loading="lazy" />`
                : `<div class="gi-retail-card-thumb-placeholder">£</div>`
              }
            </div>
            <div class="gi-retail-card-body">
              <div class="gi-retail-card-source">${rp.source}</div>
              <div class="gi-retail-card-title">${rp.title}</div>
              <div class="gi-retail-card-price">${(() => { const sym = { GBP: '£', USD: '$', NZD: 'NZ$', AUD: 'AU$', EUR: '€' }; const c = (window.__val?.currency || 'GBP'); return (sym[c] || c + ' ') + (rp.extracted_price || 0).toLocaleString('en', { maximumFractionDigits: 0 }) })()}</div>
            </div>
            <div class="gi-retail-card-footer">View listing</div>
          </a>
        `).join('')

        if (retailSection) {
          retailSection.innerHTML = `
            <div class="gi-retail-section-head">
              <div class="gi-retail-section-title">Retail Price Reference</div>
            </div>
            <div class="gi-retail-grid">${cards}</div>
            <div class="gi-retail-disclaimer">Google Shopping results. Use as a reference to verify or override the AI estimate. Click any card to view the listing.</div>
          `
        }
      } else {
        if (loading) loading.style.display = 'none'
        if (progress) progress.style.display = 'none'
        btn.disabled = false
        btn.textContent = 'Search Retail Prices'
        if (saved) {
          saved.textContent = 'No retail listings found — try editing the item description and searching again'
          saved.style.display = 'block'
        }
      }
    } catch {
      clearInterval(progressInterval)
      if (loading) loading.style.display = 'none'
      if (progress) progress.style.display = 'none'
      btn.disabled = false
      btn.textContent = 'Search Retail Prices'
    }
  })

  // ── Delete ────────────────────────────────────────────────────────────────
  document.getElementById('gi-delete-btn')?.addEventListener('click', () => {
    document.getElementById('gi-del-overlay')?.classList.remove('hidden')
  })
  document.getElementById('gi-del-cancel')?.addEventListener('click', () => {
    document.getElementById('gi-del-overlay')?.classList.add('hidden')
  })
  document.getElementById('gi-del-confirm')?.addEventListener('click', async () => {
    const btn = document.getElementById('gi-del-confirm') as HTMLButtonElement
    if (!btn || !session || !itemId) return
    btn.textContent = 'Deleting...'
    btn.disabled = true
    await supabase.from('identifications').delete()
      .eq('id', itemId).eq('user_id', session.user.id)
    window.location.href = '/library'
  })
</script>
