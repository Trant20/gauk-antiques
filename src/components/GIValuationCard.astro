  }
  .gi-retail-sources {
    font-family: var(--font-ui);
    font-size: 11px;
    color: var(--text-mute);
    font-style: italic;
  }

  /* ── ENRICHMENT GATE ── */
  .gi-enrich-gate {
    margin-top: 24px;
    padding: 28px 24px;
    background: var(--surface);
