    margin-left: auto;
    margin-right: auto;
  }
  .gi-enrich-gate-cost {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--text-mute);
    margin-bottom: 16px;
  }
  .gi-enrich-gate-btn {
    display: inline-block;
    padding: 14px 32px;
    background: var(--gi-sage);
    border: none;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    cursor: pointer;
    transition: opacity 0.2s;
    width: 100%;
