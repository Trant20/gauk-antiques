---
import { ANTIQUES_SITE_ID } from '../lib/constants'

interface Props {
  item: any
  r: any
  creditCostEnrich: number
}

const { item, r, creditCostEnrich } = Astro.props
---

<style is:global>
  /* ── ENRICH GATE ── */
  .ga-enrich-gate {
    padding: 40px 24px;
    text-align: center;
    border-top: 1px solid var(--border);
  }
  .ga-enrich-gate-eyebrow {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--ga-gold-hi);
    margin-bottom: 12px;
  }
  .ga-enrich-gate-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-style: italic;
    color: var(--text);
    margin-bottom: 10px;
  }
  .ga-enrich-gate-body {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.8;
    margin-bottom: 24px;
    max-width: 320px;
    margin-left: auto;
    margin-right: auto;
  }
  .ga-enrich-gate-cost {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--text-mute);
    margin-bottom: 20px;
    letter-spacing: 0.05em;
  }
  .ga-enrich-btn {
    display: block;
    width: 100%;
    max-width: 320px;
    margin: 0 auto 10px;
    padding: 16px;
    background: var(--ga-gold);
    border: none;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    cursor: pointer;
    transition: opacity .2s;
  }
  .ga-enrich-btn:hover { opacity: 0.85; }
  .ga-enrich-link {
    display: none;
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
    padding: 16px;
    background: var(--ga-gold);
    border: none;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    text-align: center;
    box-sizing: border-box;
  }

  /* ── ENRICH LOADING ── */
  .ga-enrich-loading { padding: 32px 24px 40px; }
  .ga-enrich-stage {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--ga-gold-hi);
    text-align: center;
    margin-bottom: 20px;
    min-height: 16px;
    animation: pulse 2s ease-in-out infinite;
  }
  .ga-enrich-progress-wrap {
    height: 2px;
    background: var(--border-hi);
    margin-bottom: 20px;
    overflow: hidden;
  }
  .ga-enrich-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--ga-gold-hi), var(--ga-gold));
    width: 0%;
    transition: width .6s ease;
  }
  .ga-enrich-steps { display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px; }
  .ga-enrich-step {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: var(--surface);
    opacity: .4;
    transition: opacity .4s;
  }
  .ga-enrich-step.active { opacity: 1; }
  .ga-enrich-step.done { opacity: .7; }
  .ga-enrich-step-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--border-hi);
    flex-shrink: 0;
    transition: background .4s;
  }
  .ga-enrich-step.active .ga-enrich-step-dot { background: var(--ga-gold); }
  .ga-enrich-step.done .ga-enrich-step-dot { background: var(--ga-teal); }
  .ga-enrich-step-text {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .ga-enrich-disclaimer {
    font-family: var(--font-ui);
    font-size: 11px;
    color: var(--text-mute);
    line-height: 1.8;
    text-align: center;
    border-top: 1px solid var(--border);
    padding-top: 16px;
  }
</style>

<div id="enrich-cta" data-item-id={item.id} data-has-enrichment="false" data-result-json={JSON.stringify(r)}>
  <div class="ga-enrich-gate">
    <div class="ga-enrich-gate-eyebrow">Full Valuation Report</div>
    <div class="ga-enrich-gate-title">Unlock the complete report</div>
    <div class="ga-enrich-gate-body">Expert notes, maker biography, market history, comparable sales, desirability index and your options.</div>
    <div class="ga-enrich-gate-cost">Cost: {creditCostEnrich} credits</div>
    <div id="enrich-gate-wrap" data-credit-cost={creditCostEnrich}>
      <button id="enrich-btn" class="ga-enrich-btn">Generate Full Report — {creditCostEnrich} Credits</button>
      <a href="/account" id="enrich-topup" class="ga-enrich-link">Top Up Credits to Unlock</a>
      <a href="https://gaukauth.com?from=gaukantiques.com&next=/library" id="enrich-register" class="ga-enrich-link">Register Free to Unlock</a>
    </div>
  </div>
</div>

<div class="ga-enrich-loading" id="enrich-loading" style="display:none;">
  <div class="ga-enrich-stage" id="enrich-stage">Consulting auction records</div>
  <div class="ga-enrich-progress-wrap"><div class="ga-enrich-progress-bar" id="enrich-progress"></div></div>
  <div class="ga-enrich-steps">
    <div class="ga-enrich-step active" id="step-0"><div class="ga-enrich-step-dot"></div><div class="ga-enrich-step-text">Researching maker &amp; provenance</div></div>
    <div class="ga-enrich-step" id="step-1"><div class="ga-enrich-step-dot"></div><div class="ga-enrich-step-text">Analysing auction &amp; comparable sales</div></div>
    <div class="ga-enrich-step" id="step-2"><div class="ga-enrich-step-dot"></div><div class="ga-enrich-step-text">Building market value history</div></div>
    <div class="ga-enrich-step" id="step-3"><div class="ga-enrich-step-dot"></div><div class="ga-enrich-step-text">Compiling expert notes &amp; options</div></div>
    <div class="ga-enrich-step" id="step-4"><div class="ga-enrich-step-dot"></div><div class="ga-enrich-step-text">Preparing your full report</div></div>
  </div>
  <div class="ga-enrich-disclaimer">Full reports draw on multiple data sources &mdash;<br>this typically takes 10&ndash;15 seconds or more when busy.</div>
</div>

<script>
  import { supabase } from '../lib/supabase-browser'
  import { ANTIQUES_SITE_ID } from '../lib/constants'

  const { data: { session } } = await supabase.auth.getSession()
  const itemId = (window as any).__val?.itemId

  const enrichCta = document.getElementById('enrich-cta')
  if (enrichCta && enrichCta.dataset.hasEnrichment !== 'true') {
    enrichCta.dataset.itemId = itemId
    enrichCta.dataset.resultJson = JSON.stringify((window as any).__val?.resultJson || {})

    const enrichLoading = document.getElementById('enrich-loading')
    const enrichBtn = document.getElementById('enrich-btn') as HTMLButtonElement | null
    const enrichTopup = document.getElementById('enrich-topup')
    const enrichRegister = document.getElementById('enrich-register')

    if (!session) {
      if (enrichBtn) enrichBtn.style.display = 'none'
      if (enrichRegister) enrichRegister.style.display = 'block'
    } else {
      const creditsRes = await fetch(`/api/credits?site_id=${ANTIQUES_SITE_ID}`, {
        headers: { 'Authorization': `Bearer ${session.access_token}` }
      })
      const creditsData = await creditsRes.json()
      const balance = creditsData.balance ?? 0

      if (balance < 1) {
        if (enrichBtn) enrichBtn.style.display = 'none'
        if (enrichTopup) enrichTopup.style.display = 'block'
      } else {
        enrichBtn?.addEventListener('click', async () => {
          if (!enrichBtn) return
          enrichBtn.textContent = 'Generating...'
          enrichBtn.setAttribute('disabled', 'true')
          if (enrichCta) enrichCta.style.display = 'none'
          if (enrichLoading) enrichLoading.style.display = 'block'

          const stages = ['Consulting auction records', 'Researching maker history', 'Analysing comparable sales', 'Building market value data', 'Compiling expert notes', 'Preparing your full report']
          const progressEl = document.getElementById('enrich-progress')
          const stageEl = document.getElementById('enrich-stage')
          const steps = [0,1,2,3,4].map(i => document.getElementById('step-' + i))
          let currentStep = 0
          const stepDuration = 14000 / stages.length

          function advanceStep() {
            if (!progressEl || !stageEl) return
            const pct = Math.min(85, Math.round((currentStep / (stages.length - 1)) * 85))
            progressEl.style.width = pct + '%'
            stageEl.textContent = stages[currentStep]
            steps.forEach((s, i) => {
              if (!s) return
              s.classList.remove('active', 'done')
              if (i < currentStep) s.classList.add('done')
              else if (i === currentStep) s.classList.add('active')
            })
            if (currentStep < stages.length - 1) { currentStep++; setTimeout(advanceStep, stepDuration) }
          }
          setTimeout(advanceStep, 600)

          fetch('/api/enrich', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${session.access_token}` },
            body: JSON.stringify({ identification_id: itemId, result: JSON.parse(enrichCta.dataset.resultJson || '{}') })
          })
          .then(res => res.json())
          .then(data => {
            if (data.enrichment) {
              if (progressEl) progressEl.style.width = '100%'
              if (stageEl) stageEl.textContent = 'Report ready'
              setTimeout(() => window.location.reload(), 400)
            } else if (data.error) {
              if (enrichLoading) enrichLoading.innerHTML = `<div style="font-family:var(--font-ui);font-size:12px;color:var(--text-mute);padding:20px;text-align:center">Report generation unavailable — please refresh to try again.</div>`
            }
          })
          .catch(() => {
            if (enrichLoading) enrichLoading.innerHTML = `<div style="font-family:var(--font-ui);font-size:12px;color:var(--text-mute);padding:20px;text-align:center">Report generation unavailable — please refresh to try again.</div>`
          })
        })
      }
    }
  }
</script>
