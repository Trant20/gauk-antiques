---
import { ANTIQUES_SITE_ID } from '../lib/constants'
---

<!-- Desktop sidebar -->
<aside class="sidebar" id="sidebar">

  <!-- Logo -->
  <div class="sb-logo-wrap">
    <div class="sb-gauk">GAUK</div>
    <div class="sb-title">The Vault</div>
  </div>

  <!-- Nav -->
  <nav class="sb-nav">
    <a href="/library" class="sb-link" data-path="/library">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <rect x="1" y="1" width="5" height="5" fill="currentColor"/>
        <rect x="8" y="1" width="5" height="5" fill="currentColor"/>
        <rect x="1" y="8" width="5" height="5" fill="currentColor"/>
        <rect x="8" y="8" width="5" height="5" fill="currentColor" opacity="0.28"/>
      </svg>
      <span>The Vault</span>
    </a>
    <a href="/identify" class="sb-link" data-path="/identify">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <span>Identify</span>
    </a>
    <a href="/account" class="sb-link" data-path="/account">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
      </svg>
      <span>Account</span>
    </a>

    <!-- Property filter -->
    <div class="sb-section-label">Properties</div>
    <button class="sb-prop-btn" id="prop-all" data-prop="all">
      <span class="sb-prop-label">All items</span>
      <span class="sb-prop-count" id="prop-count-all">—</span>
    </button>
    <button class="sb-prop-btn" id="prop-insurance" data-prop="insurance">
      <span class="sb-prop-label sb-prop-gi">
        <span class="sb-prop-dot sb-prop-dot-gi"></span>
        Insurance
      </span>
      <span class="sb-prop-count" id="prop-count-insurance">—</span>
    </button>
    <button class="sb-prop-btn" id="prop-antiques" data-prop="antiques">
      <span class="sb-prop-label sb-prop-ga">
        <span class="sb-prop-dot sb-prop-dot-ga"></span>
        Antiques
      </span>
      <span class="sb-prop-count" id="prop-count-antiques">—</span>
    </button>

    <div class="sb-divider"></div>

    <!-- Credits -->
    <div class="sb-credits" id="sb-credits">
      <div class="sb-credits-label">Credits</div>
      <div class="sb-credits-value" id="sb-credits-val">—</div>
      <a href="/pricing" class="sb-credits-topup">Top Up</a>
    </div>
  </nav>

  <!-- Footer -->
  <div class="sb-foot">
    <button class="sb-signout" id="sb-signout">Sign Out</button>
    <a href="/auth" class="sb-signin" id="sb-signin">Sign In</a>
  </div>

</aside>

<!-- Mobile bottom nav -->
<nav class="bottom-nav" id="bottom-nav">
  <a href="/library" class="bn-tab" data-path="/library">
    <svg width="18" height="18" viewBox="0 0 14 14" fill="none">
      <rect x="1" y="1" width="5" height="5" fill="currentColor"/>
      <rect x="8" y="1" width="5" height="5" fill="currentColor"/>
      <rect x="1" y="8" width="5" height="5" fill="currentColor"/>
      <rect x="8" y="8" width="5" height="5" fill="currentColor" opacity="0.28"/>
    </svg>
    <span>Vault</span>
  </a>
  <a href="/identify" class="bn-tab" data-path="/identify">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>
    <span>Identify</span>
  </a>
  <a href="/account" class="bn-tab" data-path="/account">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
    </svg>
    <span>Account</span>
  </a>
  <a href="/pricing" class="bn-tab" data-path="/pricing">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="12" cy="12" r="10"/>
      <path d="M9.5 9a3 3 0 0 1 5 1c0 2-3 3-3 3M12 17h.01"/>
    </svg>
    <span>Credits</span>
  </a>
</nav>

<style>
  /* ── DESKTOP SIDEBAR ── */
  .sidebar {
    width: 220px;
    min-width: 220px;
    height: 100vh;
    background: var(--surface);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    position: fixed;
    left: 0;
    top: 0;
    z-index: 50;
    overflow: hidden;
  }

  /* Logo */
  .sb-logo-wrap {
    padding: 24px 22px 20px;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  .sb-gauk {
    font-family: var(--font-ui);
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-mute);
    font-weight: 600;
    margin-bottom: 5px;
  }
  .sb-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 400;
    color: var(--text);
    letter-spacing: 0.03em;
    line-height: 1;
  }

  /* Nav links */
  .sb-nav {
    flex: 1;
    padding: 10px 0;
    overflow-y: auto;
  }
  .sb-link {
    padding: 9px 22px;
    display: flex;
    align-items: center;
    gap: 11px;
    cursor: pointer;
    color: var(--text-dim);
    text-decoration: none;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 500;
    transition: color 0.12s;
    border-left: 2px solid transparent;
  }
  .sb-link:hover { color: var(--text); }
  .sb-link.active {
    color: var(--text);
    background: rgba(255,255,255,0.025);
    border-left-color: var(--text);
  }
  .sb-link svg { flex-shrink: 0; }

  /* Property filter */
  .sb-section-label {
    font-family: var(--font-ui);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-mute);
    font-weight: 600;
    padding: 16px 14px 6px;
    margin-top: 4px;
    border-top: 1px solid var(--border);
  }
  .sb-prop-btn {
    width: 100%;
    padding: 7px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    background: transparent;
    border: 1px solid transparent;
    margin-bottom: 2px;
    transition: background 0.1s;
    text-align: left;
  }
  .sb-prop-btn:hover { background: rgba(255,255,255,0.025); }
  .sb-prop-btn.active {
    background: rgba(255,255,255,0.04);
    border-color: var(--border-hi);
  }
  .sb-prop-label {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--text-mute);
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .sb-prop-gi { color: var(--gi-sage); }
  .sb-prop-ga { color: var(--ga-gold-hi); }
  .sb-prop-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    flex-shrink: 0;
    display: inline-block;
  }
  .sb-prop-dot-gi { background: var(--gi-sage); }
  .sb-prop-dot-ga { background: var(--ga-gold); }
  .sb-prop-count {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--text-mute);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  /* Divider */
  .sb-divider {
    height: 1px;
    background: var(--border);
    margin: 12px 14px;
  }

  /* Credits */
  .sb-credits {
    margin: 0 14px 14px;
    background: var(--surface-hi);
    border: 1px solid var(--border-hi);
    padding: 12px 14px;
    display: none;
  }
  .sb-credits.visible { display: block; }
  .sb-credits-label {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-mute);
    margin-bottom: 4px;
  }
  .sb-credits-value {
    font-family: var(--font-display);
    font-size: 28px;
    color: var(--ga-gold-hi);
    line-height: 1;
    margin-bottom: 10px;
  }
  .sb-credits-topup {
    display: block;
    width: 100%;
    padding: 8px;
    background: var(--gi-sage);
    border: none;
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    box-sizing: border-box;
    font-weight: 500;
  }

  /* Footer */
  .sb-foot {
    padding: 14px 20px;
    border-top: 1px solid var(--border);
    flex-shrink: 0;
  }
  .sb-signout {
    width: 100%;
    padding: 10px;
    background: none;
    border: 1px solid var(--border-hi);
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-mute);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
    display: none;
  }
  .sb-signout:hover { border-color: #c46028; color: #c46028; }
  .sb-signin {
    display: none;
    width: 100%;
    padding: 10px;
    background: var(--gi-sage);
    border: none;
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    box-sizing: border-box;
    font-weight: 500;
  }

  /* ── MOBILE BOTTOM NAV ── */
  .bottom-nav {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 64px;
    background: var(--surface-lo);
    border-top: 1px solid var(--border);
    align-items: center;
    justify-content: space-around;
    z-index: 100;
    padding: 0 4px;
  }
  .bn-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 8px 18px;
    color: var(--text-mute);
    text-decoration: none;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    transition: color 0.15s;
  }
  .bn-tab:hover { color: var(--text-dim); }
  .bn-tab.active { color: var(--gi-sage); }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .sidebar { display: none; }
    .bottom-nav { display: flex; }
  }
  @media (min-width: 769px) {
    .bottom-nav { display: none !important; }
  }
</style>

<script>
  import { supabase } from '../lib/supabase-browser'
  import { ANTIQUES_SITE_ID, GI_SITE_ID } from '../lib/constants'

  // Active links — sidebar
  const path = window.location.pathname
  document.querySelectorAll('.sb-link[data-path]').forEach(el => {
    const p = (el as HTMLElement).dataset.path!
    if (path === p || (p !== '/' && path.startsWith(p))) el.classList.add('active')
  })

  // Active links — bottom nav
  document.querySelectorAll('.bn-tab[data-path]').forEach(el => {
    const p = (el as HTMLElement).dataset.path!
    if (path === p || (p !== '/' && path.startsWith(p))) el.classList.add('active')
  })

  // Property filter — dispatch event for Vault page to consume
  document.querySelectorAll('.sb-prop-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.sb-prop-btn').forEach(b => b.classList.remove('active'))
      btn.classList.add('active')
      const prop = (btn as HTMLElement).dataset.prop!
      window.dispatchEvent(new CustomEvent('vault:filter', { detail: { property: prop } }))
    })
  })

  // Set default active property filter
  document.getElementById('prop-all')?.classList.add('active')

  // Auth
  const { data: { session } } = await supabase.auth.getSession()
  if (session) {
    const signout = document.getElementById('sb-signout')!
    const signin  = document.getElementById('sb-signin')!
    const credits = document.getElementById('sb-credits')!
    signout.style.display = 'block'
    signin.style.display  = 'none'
    credits.classList.add('visible')

    const { data } = await supabase
      .from('credits')
      .select('balance')
      .eq('user_id', session.user.id)
      .eq('site_id', ANTIQUES_SITE_ID)
      .single()

    document.getElementById('sb-credits-val')!.textContent = String(data?.balance ?? 0)

    signout.addEventListener('click', async () => {
      await supabase.auth.signOut()
      window.location.href = '/'
    })
  } else {
    document.getElementById('sb-signin')!.style.display = 'block'
    document.getElementById('sb-signout')!.style.display = 'none'
  }

  // Listen for count updates from Vault page
  window.addEventListener('vault:counts', (e: Event) => {
    const { total, insurance, antiques } = (e as CustomEvent).detail
    const el = (id: string) => document.getElementById(id)
    el('prop-count-all')!.textContent       = String(total)
    el('prop-count-insurance')!.textContent = String(insurance)
    el('prop-count-antiques')!.textContent  = String(antiques)
  })
</script>
