---
interface Props {
  activePage?: 'vault' | 'identify' | 'account'
}
const { activePage = 'vault' } = Astro.props
---

<nav class="bottom-nav">
  <a href="/library" class={`bn-tab${activePage === 'vault' ? ' active' : ''}`}>
    <svg width="18" height="18" viewBox="0 0 14 14" fill="none"><rect x="1" y="1" width="5" height="5" fill="currentColor"/><rect x="8" y="1" width="5" height="5" fill="currentColor"/><rect x="1" y="8" width="5" height="5" fill="currentColor"/><rect x="8" y="8" width="5" height="5" fill="currentColor" opacity="0.28"/></svg>
    <span>Vault</span>
  </a>
  <a href="/identify" class={`bn-tab${activePage === 'identify' ? ' active' : ''}`}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <span>Identify</span>
  </a>
  <a href="/account" class={`bn-tab${activePage === 'account' ? ' active' : ''}`}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    <span>Account</span>
  </a>
  <a href="/account" class={`bn-tab${activePage === 'credits' ? ' active' : ''}`}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M9.5 9a3 3 0 0 1 5 1c0 2-3 3-3 3M12 17h.01"/></svg>
    <span>Credits</span>
  </a>
</nav>

<style is:global>
  /* ── BOTTOM NAV ── */
  .bottom-nav { display: none; position: fixed; bottom: 0; left: 0; right: 0; height: 64px; background: var(--surface-lo); border-top: 1px solid var(--border); align-items: center; justify-content: space-around; z-index: 100; padding: 0 4px; }
  .bn-tab { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 8px 18px; color: var(--text-mute); font-size: 11px; font-weight: 500; letter-spacing: 0.04em; transition: color 0.15s; }
  .bn-tab:hover { color: var(--text-dim); }
  .bn-tab.active { color: var(--gi-sage); }

  @media (max-width: 768px)  { .bottom-nav { display: flex; } }
  @media (min-width: 769px)  { .bottom-nav { display: none !important; } }
</style>
