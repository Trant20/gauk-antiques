                  <span style="font-family:Inter,sans-serif;font-size:9px;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-mute)">Peak £{enrichment.price_peak.value.toLocaleString()} ({enrichment.price_peak.year})</span>
                </div>
              )}
              <p style="font-family:Inter,sans-serif;font-size:10px;color:var(--text-mute);margin-top:12px;font-style:italic">AI-estimated market trend · not verified auction data</p>
            </div>
          )
        })()}

