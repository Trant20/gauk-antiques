---
import { R2_CDN, ANTIQUES_SITE_ID } from '../lib/constants'
import { formatValueRange, formatSingleValue } from '../lib/currency'

interface Props {
  item: any
  creditCostEnrich: number
}

const { item, creditCostEnrich } = Astro.props
const r = item.result_json
const enrichment = item.enrichment_json || null
const imageUrl = `${R2_CDN}/${item.image_key}`
const secondaryImageUrl = item.secondary_image_key ? `${R2_CDN}/${item.secondary_image_key}` : null
const conditionScore = enrichment?.condition_score || (r.condition === 'Mint' ? 98 : r.condition === 'Excellent' ? 88 : r.condition === 'Good' ? 72 : r.condition === 'Fair' ? 50 : 30)
const desirabilityScore = enrichment?.desirability_score || 70
const rarityScore = r.rarity_score || 65
const confidenceScore = r.confidence === 'High' ? 94 : r.confidence === 'Medium' ? 72 : 45
const circumference = 2 * Math.PI * 34
const conditionOffset = circumference - (circumference * conditionScore / 100)
const desirabilityOffset = circumference - (circumference * desirabilityScore / 100)
const rarityOffset = circumference - (circumference * rarityScore / 100)
const confidenceOffset = circumference - (circumference * confidenceScore / 100)
const confCircumference = 2 * Math.PI * 20
const confOffset = confCircumference - (confCircumference * confidenceScore / 100)
const date = new Date(item.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
---

<style is:global>
  .ga-card {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 32px 24px 80px;
  }

  /* ── IMAGE ── */
  .ga-image-wrap {
    position: relative;
    border-left: 3px solid var(--ga-gold);
    background: var(--surface);
    margin-bottom: 24px;
  }
  .ga-image-single {
    width: 100%;
    max-height: 420px;
    object-fit: contain;
    background: var(--surface);
    display: block;
  }
  .ga-image-dual {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--border);
  }
  .ga-image-dual img {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: contain;
    background: var(--surface);
    display: block;
  }
  .ga-image-dual-label {
    font-family: var(--font-ui);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-mute);
    text-align: center;
    padding: 5px 0;
    background: var(--surface);
  }
  @media (max-width: 480px) {
    .ga-image-dual { grid-template-columns: 1fr; }
    .ga-image-dual img { aspect-ratio: 4/3; }
  }
  .ga-conf-arc {
    position: absolute;
    bottom: 14px;
    right: 14px;
    z-index: 10;
  }
  .ga-conf-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-ui);
    font-size: 9px;
    font-weight: 600;
    color: var(--ga-gold-hi);
  }

  /* ── TITLE ── */
  .ga-badges {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }
  .ga-category {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--ga-gold-hi);
  }
  .ga-title {
    font-family: var(--font-display);
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 400;
    line-height: 1.2;
    color: var(--text);
    font-style: italic;
    margin-bottom: 6px;
  }
  .ga-subtitle {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--text-dim);
    margin-bottom: 12px;
  }
  .ga-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }
  .ga-tag {
    display: inline-block;
    padding: 4px 10px;
    border: 1px solid var(--border-hi);
    font-family: var(--font-ui);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  /* ── VALUE ── */
  .ga-value-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--ga-gold);
    padding: 28px 24px;
    text-align: center;
    margin-bottom: 24px;
  }
  .ga-value-cap {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--text-mute);
    margin-bottom: 12px;
  }
  .ga-value-number {
    font-family: var(--font-display);
    font-size: clamp(32px, 7vw, 48px);
    font-weight: 400;
    line-height: 1;
    color: var(--ga-gold-hi);
    letter-spacing: -1px;
    margin-bottom: 6px;
  }
  .ga-value-sub {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--text-mute);
    margin-bottom: 20px;
  }
  .ga-value-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--border);
    margin-top: 16px;
  }
  .ga-value-strip-cell {
    background: var(--surface-hi);
    padding: 14px 8px;
  }
  .ga-value-strip-label {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
    margin-bottom: 6px;
  }
  .ga-value-strip-val {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--text);
  }

  /* ── SECTION ── */
  .ga-section {
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
  }
  .ga-section-head {
    margin-bottom: 20px;
    padding-left: 12px;
    border-left: 2px solid var(--ga-gold);
  }
  .ga-section-title {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.16em;
    font-weight: 700;
    color: var(--ga-gold-hi);
    text-transform: uppercase;
  }

  /* ── ID TABLE ── */
  .ga-id-row {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .ga-id-row:last-child { border-bottom: none; }
  .ga-id-key {
    width: 120px;
    flex-shrink: 0;
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
    padding-top: 2px;
  }
  .ga-id-val {
    font-family: var(--font-ui);
    font-size: 15px;
    color: var(--text);
    line-height: 1.5;
    flex: 1;
  }

  /* ── INLINE EDIT ── */
  .ga-inline-edit-wrap { position: relative; flex: 1; }
  .ga-inline-text {
    font-family: var(--font-ui);
    font-size: 15px;
    color: var(--text);
    line-height: 1.6;
    cursor: pointer;
    border-bottom: 1px dashed var(--border-hi);
    padding-bottom: 2px;
    transition: border-color .2s;
    display: block;
  }
  .ga-inline-text:hover { border-bottom-color: var(--ga-gold); }
  .ga-inline-textarea {
    width: 100%;
    padding: 10px 12px;
    background: var(--shell);
    border: 1px solid var(--ga-gold);
    font-family: var(--font-ui);
    font-size: 15px;
    color: var(--text);
    line-height: 1.6;
    resize: vertical;
    min-height: 100px;
    outline: none;
    display: none;
  }
  .ga-inline-actions {
    display: none;
    gap: 8px;
    margin-top: 8px;
  }
  .ga-inline-save {
    padding: 7px 16px;
    background: var(--ga-gold);
    border: none;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    cursor: pointer;
  }
  .ga-inline-cancel {
    padding: 7px 16px;
    background: none;
    border: 1px solid var(--border-hi);
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
    cursor: pointer;
  }
  .ga-inline-hint {
    font-family: var(--font-ui);
    font-size: 10px;
    color: var(--text-mute);
    margin-top: 4px;
    display: block;
  }

  /* ── GAUGES ── */
  .ga-gauges {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 12px;
    margin-bottom: 20px;
  }
  @media (max-width: 480px) {
    .ga-gauges { grid-template-columns: 1fr 1fr; gap: 16px; }
  }
  .ga-gauge { text-align: center; }
  .ga-gauge svg { display: block; margin: 0 auto 8px; transform: rotate(-90deg); }
  .ga-gauge-label {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  /* ── CONDITION ── */
  .ga-condition-grade {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 16px;
  }
  .ga-condition-grade-label {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .ga-condition-grade-val {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--text);
    font-style: italic;
  }
  .ga-check-list { display: flex; flex-direction: column; gap: 8px; margin-top: 16px; }
  .ga-check-item { display: flex; gap: 10px; align-items: flex-start; }
  .ga-check-icon {
    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.5;
    flex-shrink: 0;
    color: #2A7060;
    width: 16px;
  }
  .ga-check-icon.warn { color: #C46028; }
  .ga-check-text {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.5;
  }

  /* ── EXPERT NOTES ── */
  .ga-expert-para {
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.9;
    color: var(--text-dim);
    margin-bottom: 14px;
  }
  .ga-expert-para:last-child { margin-bottom: 0; }

  /* ── TIMELINE ── */
  .ga-timeline { position: relative; padding-left: 22px; }
  .ga-timeline-line {
    position: absolute;
    left: 5px; top: 10px; bottom: 10px;
    width: 1px;
    background: var(--border);
  }
  .ga-tl-item {
    position: relative;
    padding: 10px 0 10px 14px;
    border-bottom: 1px solid var(--border);
  }
  .ga-tl-item:last-child { border-bottom: none; }
  .ga-tl-dot {
    position: absolute;
    left: -17px; top: 14px;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--surface-hi);
    border: 1.5px solid var(--border-hi);
    z-index: 1;
  }
  .ga-tl-dot.highlight { background: var(--ga-gold); border-color: var(--ga-gold); }
  .ga-tl-inner { display: flex; gap: 10px; align-items: baseline; }
  .ga-tl-year {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--text-mute);
    flex-shrink: 0;
    width: 48px;
  }
  .ga-tl-year.highlight { color: var(--ga-gold-hi); font-style: italic; }
  .ga-tl-label {
    font-family: var(--font-ui);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
    margin-bottom: 2px;
  }
  .ga-tl-label.highlight { color: var(--ga-gold-hi); }
  .ga-tl-note {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.5;
  }

  /* ── OPTIONS ── */
  .ga-options { display: flex; flex-direction: column; gap: 1px; background: var(--border); }
  .ga-option {
    padding: 16px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: var(--surface);
  }
  .ga-option.rec { background: var(--surface-hi); }
  .ga-option-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 5px;
    background: var(--border-hi);
  }
  .ga-option-dot.rec { background: var(--ga-gold); }
  .ga-option-action {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--text-dim);
    margin-bottom: 4px;
  }
  .ga-option-action.rec { color: var(--text); font-style: italic; }
  .ga-option-rec-badge {
    font-family: var(--font-ui);
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--ga-gold-hi);
    margin-left: 10px;
  }
  .ga-option-detail {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--text-mute);
    line-height: 1.5;
  }

  /* ── COMPARABLES ── */
  .ga-comp-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
    gap: 12px;
  }
  .ga-comp-row:last-child { border-bottom: none; }
  .ga-comp-title {
    font-family: var(--font-ui);
    font-size: 15px;
    color: var(--text);
    margin-bottom: 2px;
  }
  .ga-comp-sub {
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--text-mute);
  }
  .ga-comp-val {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--ga-gold-hi);
    flex-shrink: 0;
  }

  /* ── FOOTER ── */
  .ga-footer {
    padding: 24px 0;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
  }
  .ga-footer-brand {
    font-family: var(--font-display);
    font-size: 14px;
    font-style: italic;
    color: var(--ga-gold-hi);
    margin-bottom: 4px;
  }
  .ga-ai-disclaimer {
    font-family: var(--font-ui);
    font-size: 11px;
    color: var(--text-mute);
    line-height: 1.6;
  }

  /* ── DELETE BUTTON ── */
  .ga-delete-btn {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-mute);
    background: none;
    border: 1px solid var(--border-hi);
    padding: 8px 14px;
    cursor: pointer;
    transition: border-color .2s, color .2s;
  }
  .ga-delete-btn:hover { border-color: #c46028; color: #c46028; }

  /* ── DELETE MODAL ── */
  .ga-del-overlay {
    position: fixed; inset: 0; z-index: 200;
    background: rgba(0,0,0,.7);
    backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center; padding: 24px;
  }
  .ga-del-modal {
    background: var(--surface);
    border: 1px solid var(--border-hi);
    padding: 32px 24px;
    max-width: 320px; width: 100%;
    text-align: center;
  }
  .ga-del-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-style: italic;
    color: var(--text);
    margin-bottom: 10px;
  }
  .ga-del-sub {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.7;
    margin-bottom: 24px;
  }
  .ga-del-btns { display: flex; gap: 8px; }
  .ga-del-cancel {
    flex: 1;
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: none;
    border: 1px solid var(--border-hi);
    padding: 12px;
    cursor: pointer;
    color: var(--text-dim);
  }
  .ga-del-confirm {
    flex: 1;
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: #c46028;
    border: 1px solid #c46028;
    padding: 12px;
    cursor: pointer;
    color: #fff;
  }

  /* ── CARD ACTIONS (inline) ── */
  .ga-card-actions {
    display: flex;
    gap: 8px;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .ga-action-btn {
    flex: 1;
    padding: 13px;
    background: transparent;
    border: 1px solid var(--border-hi);
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
    cursor: pointer;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: border-color .2s, color .2s;
  }
  .ga-action-btn:hover { border-color: var(--ga-gold); color: var(--text); }
  .ga-action-btn.primary {
    background: var(--ga-gold);
    border-color: var(--ga-gold);
    color: #fff;
  }
  .ga-action-btn.primary:hover { opacity: 0.85; }

  /* ── ENRICH GATE ── */
  .ga-enrich-gate {
    padding: 40px 24px;
    text-align: center;
    border-top: 1px solid var(--border);
  }
  .ga-enrich-gate-eyebrow {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--ga-gold-hi);
    margin-bottom: 12px;
  }
  .ga-enrich-gate-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-style: italic;
    color: var(--text);
    margin-bottom: 10px;
  }
  .ga-enrich-gate-body {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.8;
    margin-bottom: 24px;
    max-width: 320px;
    margin-left: auto;
    margin-right: auto;
  }
  .ga-enrich-gate-cost {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--text-mute);
    margin-bottom: 20px;
    letter-spacing: 0.05em;
  }
  .ga-enrich-btn {
    display: block;
    width: 100%;
    max-width: 320px;
    margin: 0 auto 10px;
    padding: 16px;
    background: var(--ga-gold);
    border: none;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    cursor: pointer;
    transition: opacity .2s;
  }
  .ga-enrich-btn:hover { opacity: 0.85; }
  .ga-enrich-link {
    display: none;
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
    padding: 16px;
    background: var(--ga-gold);
    border: none;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
    text-align: center;
    box-sizing: border-box;
  }

  /* ── ENRICH LOADING ── */
  .ga-enrich-loading { padding: 32px 24px 40px; }
  .ga-enrich-stage {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--ga-gold-hi);
    text-align: center;
    margin-bottom: 20px;
    min-height: 16px;
    animation: pulse 2s ease-in-out infinite;
  }
  .ga-enrich-progress-wrap {
    height: 2px;
    background: var(--border-hi);
    margin-bottom: 20px;
    overflow: hidden;
  }
  .ga-enrich-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--ga-gold-hi), var(--ga-gold));
    width: 0%;
    transition: width .6s ease;
  }
  .ga-enrich-steps { display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px; }
  .ga-enrich-step {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: var(--surface);
    opacity: .4;
    transition: opacity .4s;
  }
  .ga-enrich-step.active { opacity: 1; }
  .ga-enrich-step.done { opacity: .7; }
  .ga-enrich-step-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--border-hi);
    flex-shrink: 0;
    transition: background .4s;
  }
  .ga-enrich-step.active .ga-enrich-step-dot { background: var(--ga-gold); }
  .ga-enrich-step.done .ga-enrich-step-dot { background: #2A7060; }
  .ga-enrich-step-text {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .ga-enrich-disclaimer {
    font-family: var(--font-ui);
    font-size: 11px;
    color: var(--text-mute);
    line-height: 1.8;
    text-align: center;
    border-top: 1px solid var(--border);
    padding-top: 16px;
  }

  @media (max-width: 768px) {
    .ga-card { padding: 20px 16px 100px; }
  }
</style>

<div class="ga-card">

  <!-- IMAGE + CONFIDENCE ARC -->
  <div class="ga-image-wrap">
    {secondaryImageUrl ? (
