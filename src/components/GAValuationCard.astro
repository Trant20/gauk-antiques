  </div>

  <!-- DELETE MODAL -->
  <div class="ga-del-overlay hidden" id="del-overlay">
    <div class="ga-del-modal">
      <div class="ga-del-title">Delete this report?</div>
      <div class="ga-del-sub">This will permanently remove the identification and valuation from your library.</div>
      <div class="ga-del-btns">
        <button class="ga-del-cancel" id="del-cancel">Cancel</button>
        <button class="ga-del-confirm" id="del-confirm">Delete</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { supabase } from '../lib/supabase-browser'

  const itemId = (window as any).__val?.itemId
  const { data: { session } } = await supabase.auth.getSession()

  // ── Inline edit description ───────────────────────────────────────────────
  const descText = document.getElementById('ga-desc-text')
  const descTextarea = document.getElementById('ga-desc-textarea') as HTMLTextAreaElement
  const descActions = document.getElementById('ga-desc-actions')
  const descSave = document.getElementById('ga-desc-save')
  const descCancel = document.getElementById('ga-desc-cancel')

  function openDescEdit() {
    if (!descText || !descTextarea || !descActions) return
    descTextarea.value = descText.textContent || ''
    descText.style.display = 'none'
    descTextarea.style.display = 'block'
    descActions.style.display = 'flex'
    descTextarea.focus()
  }

  function closeDescEdit() {
    if (!descText || !descTextarea || !descActions) return
    descText.style.display = 'block'
    descTextarea.style.display = 'none'
    descActions.style.display = 'none'
  }

  descText?.addEventListener('click', openDescEdit)
  descCancel?.addEventListener('click', closeDescEdit)

  descSave?.addEventListener('click', async () => {
    if (!descTextarea || !session || !itemId) return
    const newDesc = descTextarea.value.trim()
    if (!newDesc) return
    const currentResult = (window as any).__val?.resultJson || {}
    const updatedResult = { ...currentResult, description: newDesc }
    const { error } = await supabase
      .from('identifications')
      .update({ result_json: updatedResult })
      .eq('id', itemId)
      .eq('user_id', session.user.id)
    if (!error) {
      if (descText) descText.textContent = newDesc
      if ((window as any).__val) (window as any).__val.resultJson = updatedResult
      closeDescEdit()
    }
  })
</script>
