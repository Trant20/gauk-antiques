---
import { R2_CDN, ANTIQUES_SITE_ID } from '../lib/constants'
import { formatValueRange, formatSingleValue } from '../lib/currency'
import GAConditionReport from './GAConditionReport.astro'
import GAEnrichmentSections from './GAEnrichmentSections.astro'
import GAEnrichGate from './GAEnrichGate.astro'

interface Props {
  item: any
  creditCostEnrich: number
}

const { item, creditCostEnrich } = Astro.props
const r = item.result_json
const enrichment = item.enrichment_json || null
const imageUrl = `${R2_CDN}/${item.image_key}`
const secondaryImageUrl = item.secondary_image_key ? `${R2_CDN}/${item.secondary_image_key}` : null
const conditionScore = enrichment?.condition_score || (r.condition === 'Mint' ? 98 : r.condition === 'Excellent' ? 88 : r.condition === 'Good' ? 72 : r.condition === 'Fair' ? 50 : 30)
const desirabilityScore = enrichment?.desirability_score || 70
const rarityScore = r.rarity_score || 65
const confidenceScore = r.confidence === 'High' ? 94 : r.confidence === 'Medium' ? 72 : 45
const circumference = 2 * Math.PI * 34
const conditionOffset = circumference - (circumference * conditionScore / 100)
const desirabilityOffset = circumference - (circumference * desirabilityScore / 100)
const rarityOffset = circumference - (circumference * rarityScore / 100)
const confidenceOffset = circumference - (circumference * confidenceScore / 100)
const confCircumference = 2 * Math.PI * 20
const confOffset = confCircumference - (confCircumference * confidenceScore / 100)
const date = new Date(item.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
const userValue = item.user_value ?? null
const userValueDisplay = userValue ? formatSingleValue(userValue) : null
---

<style is:global>
  .ga-card {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 32px 24px 80px;
  }

  /* ── IMAGE ── */
  .ga-image-wrap {
    position: relative;
    border-left: 3px solid var(--ga-gold);
    background: var(--surface);
    margin-bottom: 24px;
  }
  .ga-image-single {
    width: 100%;
    max-height: 420px;
    object-fit: contain;
    background: var(--surface);
    display: block;
  }
  .ga-image-dual {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--border);
  }
  .ga-image-dual img {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: contain;
    background: var(--surface);
    display: block;
  }
  .ga-image-dual-label {
    font-family: var(--font-ui);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-mute);
    text-align: center;
    padding: 5px 0;
    background: var(--surface);
  }
  @media (max-width: 480px) {
    .ga-image-dual { grid-template-columns: 1fr; }
    .ga-image-dual img { aspect-ratio: 4/3; }
  }
  .ga-conf-arc {
    position: absolute;
    bottom: 14px;
    right: 14px;
    z-index: 10;
  }
  .ga-conf-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-ui);
    font-size: 9px;
    font-weight: 600;
    color: var(--ga-gold-hi);
  }

  /* ── TITLE ── */
  .ga-badges {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }
  .ga-category {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--ga-gold-hi);
  }
  .ga-title {
    font-family: var(--font-display);
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 400;
    line-height: 1.2;
    color: var(--text);
    font-style: italic;
    margin-bottom: 6px;
  }
  .ga-subtitle {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--text-dim);
    margin-bottom: 12px;
  }
  .ga-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }
  .ga-tag {
    display: inline-block;
    padding: 4px 10px;
    border: 1px solid var(--border-hi);
    font-family: var(--font-ui);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
  }

  /* ── VALUE ── */
  .ga-value-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--ga-gold);
    padding: 28px 24px;
    text-align: center;
    margin-bottom: 24px;
  }
  .ga-value-cap {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--text-mute);
    margin-bottom: 12px;
  }
  .ga-value-number {
    font-family: var(--font-display);
    font-size: clamp(32px, 7vw, 48px);
    font-weight: 400;
    line-height: 1;
    color: var(--ga-gold-hi);
    letter-spacing: -1px;
    margin-bottom: 6px;
  }
  .ga-value-sub {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--text-mute);
    margin-bottom: 20px;
  }
  .ga-value-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--border);
    margin-top: 16px;
  }
  .ga-value-strip-cell {
    background: var(--surface-hi);
    padding: 14px 8px;
  }
  .ga-value-strip-label {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
    margin-bottom: 6px;
  }
  .ga-value-strip-val {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--text);
  }

  /* ── EDIT VALUE ── */
  .ga-edit-wrap {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .ga-edit-label {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
    margin-bottom: 8px;
  }
  .ga-edit-row { display: flex; gap: 8px; align-items: center; }
  .ga-edit-input {
    flex: 1;
    padding: 10px 12px;
    background: var(--shell);
    border: 1px solid var(--border-hi);
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--text);
    outline: none;
  }
  .ga-edit-input:focus { border-color: var(--ga-gold); }
  .ga-edit-input::placeholder { color: var(--text-faint); }
  .ga-edit-btn {
    padding: 10px 20px;
    background: var(--ga-gold);
    border: none;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    cursor: pointer;
    transition: opacity .2s;
  }
  .ga-edit-btn:hover { opacity: 0.85; }
  .ga-edit-saved {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ga-gold-hi);
    display: none;
    margin-top: 6px;
  }

  /* ── SECTION ── */
  .ga-section {
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
  }
  .ga-section-head {
    margin-bottom: 20px;
    padding-left: 12px;
    border-left: 2px solid var(--ga-gold);
  }
  .ga-section-title {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.16em;
    font-weight: 700;
    color: var(--ga-gold-hi);
    text-transform: uppercase;
  }

  /* ── ID TABLE ── */
  .ga-id-row {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .ga-id-row:last-child { border-bottom: none; }
  .ga-id-key {
    width: 120px;
    flex-shrink: 0;
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
    padding-top: 2px;
  }
  .ga-id-val {
    font-family: var(--font-ui);
    font-size: 15px;
    color: var(--text);
    line-height: 1.5;
    flex: 1;
  }

  /* ── INLINE EDIT ── */
  .ga-inline-edit-wrap { position: relative; flex: 1; }
  .ga-inline-text {
    font-family: var(--font-ui);
    font-size: 15px;
    color: var(--text);
    line-height: 1.6;
    cursor: pointer;
    border-bottom: 1px dashed var(--border-hi);
    padding-bottom: 2px;
    transition: border-color .2s;
    display: block;
  }
  .ga-inline-text:hover { border-bottom-color: var(--ga-gold); }
  .ga-inline-textarea {
    width: 100%;
    padding: 10px 12px;
    background: var(--shell);
    border: 1px solid var(--ga-gold);
    font-family: var(--font-ui);
    font-size: 15px;
    color: var(--text);
    line-height: 1.6;
    resize: vertical;
    min-height: 100px;
    outline: none;
    display: none;
  }
  .ga-inline-actions {
    display: none;
    gap: 8px;
    margin-top: 8px;
  }
  .ga-inline-save {
    padding: 7px 16px;
    background: var(--ga-gold);
    border: none;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    cursor: pointer;
  }
  .ga-inline-cancel {
    padding: 7px 16px;
    background: none;
    border: 1px solid var(--border-hi);
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
    cursor: pointer;
  }
  .ga-inline-hint {
    font-family: var(--font-ui);
    font-size: 10px;
    color: var(--text-mute);
    margin-top: 4px;
    display: block;
  }

  /* ── FOOTER ── */
  .ga-footer {
    padding: 24px 0;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
  }
  .ga-footer-brand {
    font-family: var(--font-display);
    font-size: 14px;
    font-style: italic;
    color: var(--ga-gold-hi);
    margin-bottom: 4px;
  }
  .ga-ai-disclaimer {
    font-family: var(--font-ui);
    font-size: 11px;
    color: var(--text-mute);
    line-height: 1.6;
  }

  /* ── DELETE BUTTON ── */
  .ga-delete-btn {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-mute);
    background: none;
    border: 1px solid var(--border-hi);
    padding: 8px 14px;
    cursor: pointer;
    transition: border-color .2s, color .2s;
  }
  .ga-delete-btn:hover { border-color: var(--ga-warn); color: var(--ga-warn); }

  /* ── DELETE MODAL ── */
  .ga-del-overlay {
    position: fixed; inset: 0; z-index: 200;
    background: rgba(0,0,0,.7);
    backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center; padding: 24px;
  }
  .ga-del-modal {
    background: var(--surface);
    border: 1px solid var(--border-hi);
    padding: 32px 24px;
    max-width: 320px; width: 100%;
    text-align: center;
  }
  .ga-del-title {
    font-family: var(--font-display);
    font-size: 20px;
    font-style: italic;
    color: var(--text);
    margin-bottom: 10px;
  }
  .ga-del-sub {
    font-family: var(--font-ui);
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.7;
    margin-bottom: 24px;
  }
  .ga-del-btns { display: flex; gap: 8px; }
  .ga-del-cancel {
    flex: 1;
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: none;
    border: 1px solid var(--border-hi);
    padding: 12px;
    cursor: pointer;
    color: var(--text-dim);
  }
  .ga-del-confirm {
    flex: 1;
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--ga-warn);
    border: 1px solid var(--ga-warn);
    padding: 12px;
    cursor: pointer;
    color: #fff;
  }

  /* ── CARD ACTIONS (inline) ── */
  .ga-card-actions {
    display: flex;
    gap: 8px;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .ga-action-btn {
    flex: 1;
    padding: 13px;
    background: transparent;
    border: 1px solid var(--border-hi);
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-mute);
    cursor: pointer;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: border-color .2s, color .2s;
  }
  .ga-action-btn:hover { border-color: var(--ga-gold); color: var(--text); }
  .ga-action-btn.primary {
    background: var(--ga-gold);
    border-color: var(--ga-gold);
    color: #fff;
  }
  .ga-action-btn.primary:hover { opacity: 0.85; }

  @media (max-width: 768px) {
    .ga-card { padding: 20px 16px 100px; }
  }
</style>

<div class="ga-card">

  <!-- IMAGE + CONFIDENCE ARC -->
  <div class="ga-image-wrap">
    {secondaryImageUrl ? (
      <div class="ga-image-dual">
        <div>
          <img src={imageUrl} alt={r.subcategory} />
          <div class="ga-image-dual-label">Front</div>
        </div>
        <div>
          <img src={secondaryImageUrl} alt={`${r.subcategory} — reverse`} />
          <div class="ga-image-dual-label">Back · Base · Mark</div>
        </div>
      </div>
    ) : (
      <img class="ga-image-single" src={imageUrl} alt={r.subcategory} />
    )}
    <div class="ga-conf-arc">
      <svg width="50" height="50" viewBox="0 0 50 50">
        <circle cx="25" cy="25" r="20" fill="var(--surface)" stroke="var(--border-hi)" stroke-width="2"/>
        <circle cx="25" cy="25" r="20" fill="none" stroke="var(--ga-gold)" stroke-width="2.5"
          stroke-dasharray={confCircumference} stroke-dashoffset={confOffset} stroke-linecap="round"
          transform="rotate(-90 25 25)"/>
      </svg>
      <div class="ga-conf-label">{confidenceScore}%</div>
    </div>
  </div>

  <!-- TITLE -->
  <div class="ga-badges">
    <div class="ga-category">{r.category}</div>
  </div>
  <div class="ga-title">{r.subcategory}</div>
  {(r.maker || r.manufacturer) && (
    <div class="ga-subtitle">{[r.maker, r.manufacturer].filter(Boolean).join(' · ')}{r.circa ? ` · ${r.circa}` : ''}</div>
  )}
  {r.tags && r.tags.length > 0 && (
    <div class="ga-tags">
      {r.tags.map((tag: string) => <span class="ga-tag">{tag}</span>)}
    </div>
  )}

  <!-- VALUE -->
  <div class="ga-value-section">
    {userValueDisplay ? (
      <>
        <div class="ga-value-cap" id="ga-value-cap">Your valuation</div>
        <div class="ga-value-number" id="ga-value-display">{userValueDisplay}</div>
        <div class="ga-value-sub" id="ga-value-sub">Owner verified &middot; overrides AI estimate</div>
      </>
    ) : (
      <>
        <div class="ga-value-cap" id="ga-value-cap">Estimated Value</div>
        <div class="ga-value-number" id="ga-value-display">{formatValueRange(r.value_range_low || 0, r.value_range_high || 0)}</div>
        <div class="ga-value-sub" id="ga-value-sub">AI appraisal estimate · not a formal valuation</div>
        <div class="ga-value-strip" id="ga-ai-strip">
          <div class="ga-value-strip-cell">
            <div class="ga-value-strip-label">Low estimate</div>
            <div class="ga-value-strip-val">{formatSingleValue(r.value_range_low || 0)}</div>
          </div>
          <div class="ga-value-strip-cell">
            <div class="ga-value-strip-label">High estimate</div>
            <div class="ga-value-strip-val">{formatSingleValue(r.value_range_high || 0)}</div>
          </div>
        </div>
      </>
    )}
    <div class="ga-edit-wrap">
      <div class="ga-edit-label">{userValueDisplay ? 'Update value' : 'Override value'}</div>
      <div class="ga-edit-row">
        <input class="ga-edit-input" id="ga-edit-input" type="number" placeholder={userValueDisplay ? String(userValue) : String(r.value_range_high || 0)} />
        <button class="ga-edit-btn" id="ga-edit-btn">Confirm</button>
      </div>
      <div class="ga-edit-saved" id="ga-edit-saved">Value updated</div>
    </div>
  </div>

  <!-- IDENTIFICATION -->
  <div class="ga-section">
    <div class="ga-section-head"><div class="ga-section-title">Identification</div></div>
    {r.description && (
      <div class="ga-id-row">
        <div class="ga-id-key">Description</div>
        <div class="ga-inline-edit-wrap">
          <span class="ga-inline-text" id="ga-desc-text">{r.description}</span>
          <textarea class="ga-inline-textarea" id="ga-desc-textarea">{r.description}</textarea>
          <div class="ga-inline-actions" id="ga-desc-actions">
            <button class="ga-inline-save" id="ga-desc-save">Save</button>
            <button class="ga-inline-cancel" id="ga-desc-cancel">Cancel</button>
          </div>
          <span class="ga-inline-hint">Click to edit</span>
        </div>
      </div>
    )}
    {r.maker && <div class="ga-id-row"><div class="ga-id-key">Maker</div><div class="ga-id-val">{r.maker}</div></div>}
    {r.manufacturer && r.manufacturer !== r.maker && <div class="ga-id-row"><div class="ga-id-key">Manufacturer</div><div class="ga-id-val">{r.manufacturer}</div></div>}
    {r.period && <div class="ga-id-row"><div class="ga-id-key">Period</div><div class="ga-id-val">{r.period}{r.circa ? ` · ${r.circa}` : ''}</div></div>}
    {r.country_of_origin && <div class="ga-id-row"><div class="ga-id-key">Origin</div><div class="ga-id-val">{r.country_of_origin}</div></div>}
    <div class="ga-id-row"><div class="ga-id-key">Condition</div><div class="ga-id-val">{r.condition}</div></div>
    {r.category_specific && Object.entries(r.category_specific).filter(([k]) => !k.includes('—')).map(([key, val]) => (
      val && <div class="ga-id-row"><div class="ga-id-key">{key.replace(/_/g, ' ')}</div><div class="ga-id-val">{String(val)}</div></div>
    ))}
  </div>

  <!-- CONDITION REPORT -->
  <GAConditionReport
    r={r}
    enrichment={enrichment}
    conditionScore={conditionScore}
    desirabilityScore={desirabilityScore}
    rarityScore={rarityScore}
    confidenceScore={confidenceScore}
    circumference={circumference}
    conditionOffset={conditionOffset}
    desirabilityOffset={desirabilityOffset}
    rarityOffset={rarityOffset}
    confidenceOffset={confidenceOffset}
  />

  <!-- ENRICHMENT -->
  <div id="enrichment-container">
    {enrichment ? (
      <GAEnrichmentSections enrichment={enrichment} r={r} />
    ) : (
      <GAEnrichGate item={item} r={r} creditCostEnrich={creditCostEnrich} />
    )}
  </div>

  <!-- FOOTER -->
  <div class="ga-footer">
    <div>
      <div class="ga-footer-brand">GAUK Antiques</div>
      <div class="ga-ai-disclaimer">AI appraisal · estimates only · not a formal valuation · {date}</div>
    </div>
    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:12px;">
      <div style="text-align:right;">
        <div style="font-family:var(--font-ui);font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-mute);margin-bottom:4px;">Reference</div>
        <div style="font-family:var(--font-ui);font-size:11px;color:var(--text-dim);">{item.id.slice(0,8).toUpperCase()}</div>
      </div>
      <button id="delete-btn" class="ga-delete-btn">Delete this report</button>
    </div>
  </div>

  <!-- CARD ACTIONS -->
  <div class="ga-card-actions">
    <button class="ga-action-btn" onclick="window.print()">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
      Print
    </button>
    <a href="/identify/antiques" class="ga-action-btn primary">New Scan</a>
  </div>

  <!-- DELETE MODAL -->
  <div class="ga-del-overlay hidden" id="del-overlay">
    <div class="ga-del-modal">
      <div class="ga-del-title">Delete this report?</div>
      <div class="ga-del-sub">This will permanently remove the identification and valuation from your library.</div>
      <div class="ga-del-btns">
        <button class="ga-del-cancel" id="del-cancel">Cancel</button>
        <button class="ga-del-confirm" id="del-confirm">Delete</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { supabase } from '../lib/supabase-browser'

  const itemId = (window as any).__val?.itemId
  const { data: { session } } = await supabase.auth.getSession()

  // ── Inline edit description ───────────────────────────────────────────────
  const descText = document.getElementById('ga-desc-text')
  const descTextarea = document.getElementById('ga-desc-textarea') as HTMLTextAreaElement
  const descActions = document.getElementById('ga-desc-actions')
  const descSave = document.getElementById('ga-desc-save')
  const descCancel = document.getElementById('ga-desc-cancel')

  function openDescEdit() {
    if (!descText || !descTextarea || !descActions) return
    descTextarea.value = descText.textContent || ''
    descText.style.display = 'none'
    descTextarea.style.display = 'block'
    descActions.style.display = 'flex'
    descTextarea.focus()
  }

  function closeDescEdit() {
    if (!descText || !descTextarea || !descActions) return
    descText.style.display = 'block'
    descTextarea.style.display = 'none'
    descActions.style.display = 'none'
  }

  descText?.addEventListener('click', openDescEdit)
  descCancel?.addEventListener('click', closeDescEdit)

  descSave?.addEventListener('click', async () => {
    if (!descTextarea || !session || !itemId) return
    const newDesc = descTextarea.value.trim()
    if (!newDesc) return
    const currentResult = (window as any).__val?.resultJson || {}
    const updatedResult = { ...currentResult, description: newDesc }
    const { error } = await supabase
      .from('identifications')
      .update({ result_json: updatedResult })
      .eq('id', itemId)
      .eq('user_id', session.user.id)
    if (!error) {
      if (descText) descText.textContent = newDesc
      if ((window as any).__val) (window as any).__val.resultJson = updatedResult
      closeDescEdit()
    }
  })

  // ── Override value ────────────────────────────────────────────────────────
  document.getElementById('ga-edit-btn')?.addEventListener('click', async () => {
    const input = document.getElementById('ga-edit-input') as HTMLInputElement
    const saved = document.getElementById('ga-edit-saved')
    const capEl = document.getElementById('ga-value-cap')
    const displayEl = document.getElementById('ga-value-display')
    const subEl = document.getElementById('ga-value-sub')
    const aiStrip = document.getElementById('ga-ai-strip')
    if (!input || !session || !itemId) return
    const val = parseFloat(input.value)
    if (isNaN(val) || val <= 0) return
    const { error } = await supabase
      .from('identifications').update({ user_value: val })
      .eq('id', itemId).eq('user_id', session.user.id)
    if (!error) {
      if (capEl) capEl.textContent = 'Your valuation'
      if (displayEl) displayEl.textContent = '£' + val.toLocaleString('en-GB')
      if (subEl) subEl.innerHTML = 'Owner verified &middot; overrides AI estimate'
      if (aiStrip) aiStrip.style.display = 'none'
      input.placeholder = String(val)
      input.value = ''
      if (saved) {
        saved.style.display = 'block'
        setTimeout(() => { if (saved) saved.style.display = 'none' }, 2000)
      }
    }
  })
</script>
