---
interface Props {
  activePage?: 'vault' | 'identify' | 'audit' | 'receipts' | 'ebay-search' | 'search-history' | 'videos' | 'articles' | 'account'
}
const { activePage = 'vault' } = Astro.props
import PropertySwitcher from './PropertySwitcher.astro'
import SidebarAccount from './SidebarAccount.astro'
---

<aside class="sidebar" id="sidebar">

  <!-- ── PROPERTY SWITCHER ── -->
  <div class="sb-logo-wrap">
    <PropertySwitcher currentProperty="ga" />
  </div>

  <!-- ── PROPERTY NAV ── -->
  <nav class="sb-nav">
    <a href="/library" class={`sb-link${activePage === 'vault' ? ' active' : ''}`}>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><rect x="1" y="1" width="5" height="5" fill="currentColor"/><rect x="8" y="1" width="5" height="5" fill="currentColor"/><rect x="1" y="8" width="5" height="5" fill="currentColor"/><rect x="8" y="8" width="5" height="5" fill="currentColor" opacity="0.28"/></svg>
      <span>The Vault</span>
    </a>
    <a href="/identify" class={`sb-link${activePage === 'identify' ? ' active' : ''}`}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <span>Identify</span>
    </a>
    <a href="/audit" class={`sb-link${activePage === 'audit' ? ' active' : ''}`}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span>Room Audit</span>
    </a>
    <a href="/receipts" class={`sb-link${activePage === 'receipts' ? ' active' : ''}`}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="12" y2="16"/></svg>
      <span>Receipts</span>
    </a>
    <a href="/search/ebay" class={`sb-link${activePage === 'ebay-search' ? ' active' : ''}`}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 12V22H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
      <span>eBay Search</span>
    </a>
    <a href="/search/history" class={`sb-link sb-link-sub${activePage === 'search-history' ? ' active' : ''}`}>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>History</span>
    </a>

    <div class="sb-divider"></div>

    <a href="/feed" class={`sb-link${activePage === 'videos' ? ' active' : ''}`}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
      <span>Videos</span>
    </a>
    <a href="/articles" class={`sb-link${activePage === 'articles' ? ' active' : ''}`}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
      <span>Articles</span>
    </a>

    <slot />
  </nav>

  <!-- ── ACCOUNT SECTION ── -->
  <div class="sb-bottom">
    <SidebarAccount
      fromDomain="gaukantiques.com"
      signInNext="/library"
      activePage={activePage}
    />
  </div>

</aside>

<style is:global>
  .sidebar {
    width: 220px; min-width: 220px; height: 100vh;
    background: var(--surface); border-right: 1px solid var(--border);
    display: flex; flex-direction: column;
    position: fixed; left: 0; top: 0; z-index: 50;
  }
  .sb-logo-wrap { padding: 16px 20px 14px; border-bottom: 1px solid var(--border); flex-shrink: 0; }
  .sb-nav { flex: 1; padding: 10px 0; overflow-y: auto; }
  .sb-link {
    padding: 9px 22px; display: flex; align-items: center; gap: 11px;
    color: var(--text-dim); font-size: 13px; font-weight: 500;
    border-left: 2px solid transparent; transition: color 0.12s;
    text-decoration: none;
  }
  .sb-link:hover { color: var(--text); }
  .sb-link.active { color: var(--text); background: rgba(255,255,255,0.025); border-left-color: var(--ga-gold-hi); }
  .sb-divider { height: 1px; background: var(--border); margin: 10px 14px; }
  .sb-link-sub { padding-left: 42px; font-size: 12px; }

  .sb-bottom { flex-shrink: 0; border-top: 1px solid var(--border); }
  .sb-credits { padding: 12px 14px; display: none; border-bottom: 1px solid var(--border); }
  .sb-credits.visible { display: block; }
  .sb-credits-inner { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .sb-credits-label { font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-mute); font-weight: 600; margin-bottom: 4px; }
  .sb-credits-value { font-family: var(--font-ui); font-size: 20px; font-weight: 700; color: var(--network); line-height: 1; }
  .sb-credits-topup { padding: 6px 12px; background: var(--network); font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: #fff; font-weight: 600; white-space: nowrap; text-decoration: none; flex-shrink: 0; }
  .sb-foot { padding: 12px 14px; }
  .sb-signout { width: 100%; padding: 9px; background: none; border: 1px solid var(--border-hi); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-mute); transition: border-color 0.2s, color 0.2s; display: none; cursor: pointer; }
  .sb-signout:hover { border-color: #c46028; color: #c46028; }
  .sb-signin { display: none; width: 100%; padding: 9px; background: var(--gi-sage); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: #fff; text-align: center; font-weight: 500; text-decoration: none; }

  @media (max-width: 768px) { .sidebar { display: none; } }
</style>
