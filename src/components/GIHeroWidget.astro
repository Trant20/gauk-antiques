---
interface Props {
  site_id: string
  credit_cost?: number
}
const { site_id, credit_cost = 1 } = Astro.props
---

<div id="gi-upload-widget" data-site-id={site_id} data-credit-cost={credit_cost}>

  <!-- Upload Zone -->
  <div id="gi-upload-zone" style="width: 100%; max-width: 560px; margin: 0 auto; background: var(--surface); border: 1px solid var(--border-hi); padding: clamp(36px,6.5vh,72px) 32px; display: flex; flex-direction: column; align-items: center; gap: 20px; cursor: pointer; position: relative; overflow: hidden; transition: border-color 0.2s;">

    <!-- Scan overlay -->
    <div id="gi-scan-overlay" style="display: none; position: absolute; inset: 0; z-index: 10; pointer-events: none; overflow: hidden;">
      <div id="gi-scan-line" style="position: absolute; left: 0; right: 0; height: 2px; background: linear-gradient(to right, transparent, var(--gi-sage), transparent); box-shadow: 0 0 12px 2px rgba(124,144,130,0.6); animation: giScanLine 1.8s ease-in-out infinite;"></div>
      <div style="position: absolute; inset: 0;">
        <span style="position: absolute; top: 12px; left: 12px; width: 24px; height: 24px; border-top: 1px solid var(--gi-sage); border-left: 1px solid var(--gi-sage);"></span>
        <span style="position: absolute; bottom: 12px; right: 12px; width: 24px; height: 24px; border-bottom: 1px solid var(--gi-sage); border-right: 1px solid var(--gi-sage);"></span>
      </div>
    </div>

    <!-- Preview image -->
    <img id="gi-upload-preview" src="" alt="" style="display: none; width: 100%; max-height: 320px; object-fit: contain;" />

    <!-- Placeholder -->
    <div id="gi-upload-placeholder" style="display: flex; flex-direction: column; align-items: center; gap: 20px;">
      <svg width="48" height="44" viewBox="0 0 48 44" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M18.5 4L15 11H6C4.35 11 3 12.35 3 14V38C3 39.65 4.35 41 6 41H42C43.65 41 45 39.65 45 38V14C45 12.35 43.65 11 42 11H33L29.5 4H18.5Z" stroke="rgba(124,144,130,0.6)" stroke-width="1.6" stroke-linejoin="round" fill="none"></path>
        <circle cx="24" cy="26" r="9.5" stroke="rgba(124,144,130,0.6)" stroke-width="1.6" fill="none"></circle>
        <circle cx="38" cy="17" r="2" fill="rgba(124,144,130,0.5)"></circle>
      </svg>
      <p style="font-family: var(--font-ui); font-size: clamp(13px,1.3vw,15px); color: var(--text-mute); letter-spacing: 0.02em;">Photograph an item to begin your audit</p>
    </div>

    <!-- Status text -->
    <p id="gi-upload-status" style="display: none; font-family: var(--font-ui); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gi-sage); text-align: center;"></p>

    <!-- Hidden file input -->
    <input id="gi-file-input" type="file" accept="image/*" style="display: none;" />
  </div>

  <!-- Result card -->
  <div id="gi-result-panel" style="display: none; width: 100%; max-width: 560px; margin: 24px auto 0;">
    <div id="gi-result-card" style="background: var(--surface); border: 1px solid var(--border-hi); border-left: 3px solid var(--gi-sage); display: flex; flex-direction: column; gap: 0;">

      <!-- Category + Title + Description -->
      <div style="padding: 20px 20px 0;">
        <span id="gi-result-category" style="font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gi-sage);"></span>
        <h3 id="gi-result-title" style="font-family: var(--font-ui); font-size: clamp(18px,3vw,22px); font-weight: 600; color: var(--text); line-height: 1.2; margin: 6px 0 10px;"></h3>
        <p id="gi-result-description" style="font-family: var(--font-ui); font-size: 14px; color: var(--text-dim); line-height: 1.8; margin: 0 0 20px;"></p>
      </div>

      <!-- Value + Confidence -->
      <div style="background: var(--surface-hi); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <div style="display: flex; flex-direction: column; gap: 4px;">
          <span style="font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-mute);">Est. Replacement Cost</span>
          <span id="gi-result-value" style="font-family: var(--font-ui); font-size: clamp(20px,3vw,28px); font-weight: 700; color: var(--gi-sage);"></span>
        </div>
        <div style="display: flex; flex-direction: column; gap: 4px;">
          <span style="font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-mute);">Confidence</span>
          <span id="gi-result-confidence" style="font-family: var(--font-ui); font-size: clamp(20px,3vw,28px); font-weight: 700; color: var(--text);"></span>
        </div>
      </div>

      <!-- Commentary -->
      <div id="gi-result-commentary" style="display: none; padding: 20px; border-bottom: 1px solid var(--border); flex-direction: column; gap: 10px;">
        <p id="gi-result-commentary-text" style="font-family: var(--font-ui); font-size: 14px; color: var(--text-dim); line-height: 1.8; margin: 0;"></p>
        <p id="gi-result-commentary-hook" style="font-family: var(--font-ui); font-size: 13px; color: var(--gi-sage); line-height: 1.6; font-style: italic; margin: 0;"></p>
      </div>

      <!-- Antique details -->
      <div id="gi-result-antique" style="display: none; padding: 20px; border-bottom: 1px solid var(--border);">
        <div style="font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gi-sage); margin-bottom: 14px;">Antique Details</div>
        <div id="gi-row-maker" style="display: none; padding: 8px 0; border-bottom: 1px solid var(--border-hi); gap: 16px; align-items: flex-start;">
          <span style="width: 80px; flex-shrink: 0; font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-mute);">Maker</span>
          <span id="gi-result-maker" style="font-family: var(--font-ui); font-size: 14px; color: var(--text); flex: 1;"></span>
        </div>
        <div id="gi-row-period" style="display: none; padding: 8px 0; border-bottom: 1px solid var(--border-hi); gap: 16px; align-items: flex-start;">
          <span style="width: 80px; flex-shrink: 0; font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-mute);">Period</span>
          <span id="gi-result-period" style="font-family: var(--font-ui); font-size: 14px; color: var(--text); flex: 1;"></span>
        </div>
        <div id="gi-row-condition" style="display: none; padding: 8px 0; gap: 16px; align-items: flex-start;">
          <span style="width: 80px; flex-shrink: 0; font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-mute);">Condition</span>
          <span id="gi-result-condition" style="font-family: var(--font-ui); font-size: 14px; color: var(--text); flex: 1;"></span>
        </div>
      </div>

      <!-- Antique handoff banner -->
      <div id="gi-antique-banner" style="display: none; padding: 20px; background: var(--surface-hi); border-bottom: 1px solid var(--border); flex-direction: column; gap: 10px;">
        <div style="font-family: var(--font-ui); font-size: 14px; font-weight: 600; color: var(--text);">This item may have antique value worth investigating.</div>
        <div style="font-family: var(--font-ui); font-size: 13px; color: var(--text-dim); line-height: 1.7;">Our AI has flagged this as a potential antique. Run a specialist deep scan to get maker history, auction comparables and a definitive valuation.</div>
        <a id="gi-antique-cta" href="/identify/antiques" style="display: inline-block; font-family: var(--font-ui); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 600; color: var(--ga-gold-hi); border: 1px solid var(--ga-gold); padding: 10px 20px; text-decoration: none; align-self: flex-start; margin-top: 4px;">Run Specialist Scan →</a>
      </div>

      <!-- Footer -->
      <div style="display: flex; justify-content: space-between; align-items: center; padding: 14px 20px;">
        <span style="font-family: var(--font-ui); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gi-sage);">GAUK Insurance</span>
        <span id="gi-result-ref" style="font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.08em; color: var(--text-mute);"></span>
      </div>
      <div id="gi-save-note" style="display: none; padding: 0 20px 14px; font-family: var(--font-ui); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gi-sage);">Saved to your vault</div>

    </div>

    <!-- Scan again -->
    <button id="gi-scan-again" style="margin-top: 16px; width: 100%; padding: 14px; background: none; border: 1px solid var(--border-hi); font-family: var(--font-ui); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-mute); cursor: pointer; transition: border-color 0.15s, color 0.15s;">Scan Another Item</button>

  </div>

</div>

<style>
  @keyframes giScanLine {
    0% { top: 0%; }
    100% { top: 100%; }
  }
  #gi-upload-zone:hover { border-color: var(--gi-sage); }
</style>

<script is:inline>
(function () {
  var widget      = document.getElementById('gi-upload-widget');
  var zone        = document.getElementById('gi-upload-zone');
  var fileInput   = document.getElementById('gi-file-input');
  var placeholder = document.getElementById('gi-upload-placeholder');
  var preview     = document.getElementById('gi-upload-preview');
  var statusEl    = document.getElementById('gi-upload-status');
  var scanOverlay = document.getElementById('gi-scan-overlay');
  var resultPanel = document.getElementById('gi-result-panel');
  var scanAgain   = document.getElementById('gi-scan-again');

  var siteId = widget.dataset.siteId;

  function setStatus(msg) {
    if (msg) { statusEl.textContent = msg; statusEl.style.display = 'block'; }
    else { statusEl.style.display = 'none'; }
  }

  function setScanActive(active) {
    scanOverlay.style.display = active ? 'block' : 'none';
  }

  function showResult(data, token) {
    var r = data.result || data;

    document.getElementById('gi-result-category').textContent = r.category || '';
    document.getElementById('gi-result-title').textContent    = r.title || 'Item identified';
    document.getElementById('gi-result-description').textContent = r.description || '';

    var low  = r.value_range_low  || 0;
    var high = r.value_range_high || 0;
    document.getElementById('gi-result-value').textContent      = low && high ? '\u00a3' + low.toLocaleString() + ' \u2013 \u00a3' + high.toLocaleString() : 'Value unknown';
    document.getElementById('gi-result-confidence').textContent = r.confidence || '';

    var commentaryWrap = document.getElementById('gi-result-commentary');
    var commentaryText = document.getElementById('gi-result-commentary-text');
    var commentaryHook = document.getElementById('gi-result-commentary-hook');
    if (r.commentary && commentaryWrap) {
      commentaryText.textContent = r.commentary;
      commentaryHook.textContent = r.commentary_hook || '';
      commentaryWrap.style.display = 'flex';
    }

    if (r.is_antique) {
      document.getElementById('gi-result-antique').style.display = 'block';
      if (r.maker)     { document.getElementById('gi-result-maker').textContent = r.maker;     document.getElementById('gi-row-maker').style.display = 'flex'; }
      if (r.period)    { document.getElementById('gi-result-period').textContent = r.period;   document.getElementById('gi-row-period').style.display = 'flex'; }
      if (r.condition) { document.getElementById('gi-result-condition').textContent = r.condition; document.getElementById('gi-row-condition').style.display = 'flex'; }
      document.getElementById('gi-antique-banner').style.display = 'flex';
    }

    if (data.id) {
      document.getElementById('gi-result-ref').textContent = 'REF ' + data.id.slice(0,8).toUpperCase();
    }

    if (token && data.id) {
      document.getElementById('gi-save-note').style.display = 'block';
    }

    resultPanel.style.display = 'block';
    resultPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function resetWidget() {
    preview.style.display = 'none';
    preview.src = '';
    placeholder.style.display = 'flex';
    resultPanel.style.display = 'none';
    setScanActive(false);
    setStatus('');
    // Reset antique fields
    ['gi-result-antique','gi-antique-banner','gi-result-commentary'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.style.display = 'none';
    });
    ['gi-row-maker','gi-row-period','gi-row-condition'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.style.display = 'none';
    });
    document.getElementById('gi-save-note').style.display = 'none';
  }

  zone.addEventListener('click', function () { fileInput.click(); });
  zone.addEventListener('dragover', function (e) { e.preventDefault(); zone.style.borderColor = 'var(--gi-sage)'; });
  zone.addEventListener('dragleave', function () { zone.style.borderColor = ''; });
  zone.addEventListener('drop', function (e) {
    e.preventDefault();
    zone.style.borderColor = '';
    var file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
    if (file) handleFile(file);
  });
  fileInput.addEventListener('change', function () {
    var file = fileInput.files && fileInput.files[0];
    if (file) handleFile(file);
  });
  scanAgain.addEventListener('click', function () {
    resetWidget();
    fileInput.value = '';
  });

  async function handleFile(file) {
    placeholder.style.display = 'none';
    preview.src = URL.createObjectURL(file);
    preview.style.display = 'block';
    setScanActive(true);
    setStatus('Stripping metadata...');

    try {
      var stripped = await stripExif(file);
      setStatus('Uploading...');

      var formData = new FormData();
      formData.append('file', stripped);
      var uploadRes = await fetch('/api/upload-url', { method: 'POST', body: formData });
      var uploadData = await uploadRes.json();
      if (uploadData.error) throw new Error(uploadData.error);

      setStatus('Identifying...');

      var token = window.__gauk_token || '';
      var headers = { 'Content-Type': 'application/json' };
      if (token) headers['Authorization'] = 'Bearer ' + token;

      var identifyRes = await fetch('/api/identify', {
        method: 'POST',
        headers: headers,
        body: JSON.stringify({ key: uploadData.key, context: 'general', site_id: siteId })
      });
      var identifyData = await identifyRes.json();

      if (identifyData.error === 'Insufficient credits') {
        statusEl.innerHTML = 'You\'ve been busy! <a href="/account" style="color:var(--gi-sage);text-decoration:none;border-bottom:1px solid rgba(124,144,130,.4);">Head to your account</a> to top up and keep scanning.'
        statusEl.style.display = 'block'
        setScanActive(false);
        return;
      }
      if (identifyData.error) {
        throw new Error(identifyData.error);
      }

      setScanActive(false);
      setStatus('');
      showResult(identifyData, token);

    } catch (err) {
      setScanActive(false);
      setStatus('Something went wrong. Please try again.');
      console.error(err);
    }
  }

  function stripExif(file) {
    return new Promise(function (resolve, reject) {
      var img = new Image();
      var url = URL.createObjectURL(file);
      img.onload = function () {
        try {
          var canvas = document.createElement('canvas');
          canvas.width  = img.naturalWidth;
          canvas.height = img.naturalHeight;
          var ctx = canvas.getContext('2d');
          if (!ctx) throw new Error('Canvas unavailable');
          ctx.drawImage(img, 0, 0);
          canvas.toBlob(function (blob) {
            URL.revokeObjectURL(url);
            if (!blob) { reject(new Error('toBlob failed')); return; }
            resolve(new File([blob], file.name, { type: 'image/jpeg', lastModified: Date.now() }));
          }, 'image/jpeg', 0.92);
        } catch (e) { URL.revokeObjectURL(url); reject(e); }
      };
      img.onerror = function () { URL.revokeObjectURL(url); reject(new Error('Image load failed')); };
      img.src = url;
    });
  }
})();
</script>
