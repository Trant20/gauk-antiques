---
interface Props {
  title: string
}
const { title } = Astro.props
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&family=Prata&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#EFE7D9" />
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  /* ── CREAM DESIGN TOKENS — valuation cards only ── */
  :root {
    --c-bg:         #EFE7D9;
    --c-surface:    #E6DCCB;
    --c-surface-lo: #EAE1D2;
    --c-surface-mid:#DDD0BF;
    --c-border:     #C4B49E;
    --c-border-lo:  rgba(196,180,158,.3);
    --c-text:       #1C1810;
    --c-text-dim:   #5C5040;
    --c-text-mid:   #8A7A66;
    --c-text-faint: #A09080;
    --c-gold:       #7A5C20;
    --c-gold-hi:    #C8A060;
    --c-gold-chart: #A07830;
    --c-sage:       #7c9082;
    --c-teal:       #2A7060;
    --c-warn:       #C46028;
    --c-dark:       #1C1810;
    --c-dark-bg:    rgba(239,231,217,.96);
    --font-display: 'Playfair Display', Didot, Georgia, serif;
    --font-serif:   'Prata', Georgia, serif;
    --font-ui:      'Inter', sans-serif;
  }

  html, body {
    background: var(--c-bg);
    color: var(--c-text);
    font-family: var(--font-serif);
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }

  a { color: inherit; text-decoration: none; }
  button { font-family: var(--font-serif); border: none; cursor: pointer; }

  .hidden { display: none !important; }

  ::-webkit-scrollbar { width: 3px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--c-border); }

  @keyframes pulse { 0%,100%{opacity:.5} 50%{opacity:1} }
</style>
