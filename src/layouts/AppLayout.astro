---
const { title } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- App fonts — Inter (UI) + Cormorant Garamond (display) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#1b1b1b" />

    <slot name="head" />
  </head>
  <body>
    <div class="grain"></div>
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  /* ── DESIGN TOKENS — single source of truth for all app pages ── */
  :root {
    --shell:        #1b1b1b;
    --surface:      #121212;
    --surface-lo:   #0e0e0e;
    --surface-hi:   #181818;
    --border:       #1e1e1e;
    --border-hi:    #252525;
    --text:         #e8e8e8;
    --text-dim:     #909090;
    --text-mute:    #606060;
    --text-faint:   #404040;
    --gi-sage:      #7c9082;
    --gr-violet:    #7a6e9e;
    --gr-violet-hi: #9d92bc;
    --ga-gold:      #7A5C20;
    --ga-gold-hi:   #c8952e;
    --ga-teal:      #2A7060;
    --ga-warn:      #C46028;
    --ga-confidence:#2A4A7C;
    --network:      #3a8197;
    --network-hi:   #4a9ab0;
    --font-display: 'Cormorant Garamond', serif;
    --font-ui:      'Inter', sans-serif;
    --radius:       2px;
  }

  /* Dark shell base — authenticated app only */
  html, body {
    background: var(--shell);
    color: var(--text);
    font-family: var(--font-ui);
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }

  a { color: inherit; text-decoration: none; }
  button { font-family: var(--font-ui); border: none; cursor: pointer; }
  input, select { font-family: var(--font-ui); outline: none; border: none; background: transparent; color: var(--text); }
  input::placeholder { color: var(--text-faint); }

  .hidden { display: none !important; }

  /* Scrollbar */
  ::-webkit-scrollbar        { width: 3px; }
  ::-webkit-scrollbar-track  { background: transparent; }
  ::-webkit-scrollbar-thumb  { background: var(--border-hi); }

  /* Grain overlay */
  .grain {
    position: fixed; inset: 0; z-index: 9999; pointer-events: none; opacity: 0.035;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 180px;
  }

  /* Animations */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes shimmer {
    0%   { background-position: -400px 0; }
    100% { background-position:  400px 0; }
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50%       { opacity: 1; }
  }
</style>
