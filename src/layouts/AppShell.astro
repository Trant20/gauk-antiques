---
import Layout from './Layout.astro'
import SideNav from '../components/SideNav.astro'
const { title } = Astro.props
---
<Layout title={title}>
  <div class="app-shell">
    <SideNav />
    <main class="app-main">
      <slot />
    </main>
  </div>
</Layout>

<style is:global>
  /* Dark shell base — authenticated admin area */
  html, body {
    background: var(--shell);
    color: var(--text);
    font-family: var(--font-ui);
  }

  /* Shell layout */
  .app-shell {
    display: flex;
    min-height: 100vh;
    background: var(--shell);
  }

  /* Main content area — offset by sidebar width on desktop */
  .app-main {
    flex: 1;
    min-width: 0;
    margin-left: 220px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .app-main {
      margin-left: 0;
      padding-bottom: 64px; /* space for bottom nav */
    }
  }
</style>
